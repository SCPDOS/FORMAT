   527 00000680 B20A                <1>     mov dl, LF
   528 00000682 E868000000          <1>     call putch
   529 00000687 58                  <1>     pop rax
   530 00000688 5A                  <1>     pop rdx
   531 00000689 48CF                <1>     iretq   ;Redo the operation
