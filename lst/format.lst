    30                              <1> ;Tables
    31                              <1> ;Each row is 5 bytes, {DWORD, BYTE} with DWORD = diskSize, BYTE=secPerClusVal
    32                              <1> ;This table assumes a 512 byte sector (fair assumption) but we do a byte size
    33                              <1> ; comparison in format to eventually allow for other sized sectors
    34                              <1> fat16ClusterTable:
    35 00000A2F 00A04100            <1>     dd 8400*512 ;Disks up to 4.1MB, must use FAT12 with 0.5 K clusters
    36 00000A33 01                  <1>     db 1    ;ALL FAT12 uses 1, unless it is a preexisting meddesc type medium
    37 00000A34 0050FF00            <1>     dd 32680*512    ; Disk up to 16MB, 1K clusters
    38 00000A38 02                  <1>     db 2
    39 00000A39 00000008            <1>     dd 262144*512   ; Disk up to 128MB, 2K clusters
    40 00000A3D 04                  <1>     db 4
    41 00000A3E 00000010            <1>     dd 524288*512   ; Disk up to 256MB, 4K clusters
    42 00000A42 08                  <1>     db 8
    43 00000A43 00000020            <1>     dd 1048576*512  ; Disk up to 512Mb, 8K clusters
    44 00000A47 10                  <1>     db 16
    45                              <1> 
    46                              <1> ;Here DWORD becomes QWORD
    47                              <1> fat32ClusterTable:
    48 00000A48 0000000002000000    <1>     dq 16777216*512 ; Disk up to 8GB, 4K clusters
    49 00000A50 08                  <1>     db 8        
    50 00000A51 0000000004000000    <1>     dq 33554432*512 ; Disk up to 16GB, 8K clusters
    51 00000A59 10                  <1>     db 16
    52 00000A5A 0000000008000000    <1>     dq 67108864*512 ; Disk up to 32Gb, 16K clusters
    53 00000A62 20                  <1>     db 32
    54 00000A63 FFFFFFFFFFFFFFFF    <1>     dq -1       ; Disk up to 2TB, 32K clusters
    55 00000A6B 40                  <1>     db 64
    56                              <1> 
    57                              <1> ;Static BPBs here, fields set to -1 must be edited.
    58                              <1> ;Fields with a preset value should NOT be touched.
    59                              <1> genericBPB12:
    60                              <1>     istruc bpb
    61 00000A6C FFFF                <1>     at .bytsPerSec,  dw -1           ;512 bytes per sector, normally
    62 00000A6E FF                  <1>     at .secPerClus,  db -1           ;1 sector per cluster, normally
    63 00000A6F 0100                <1>     at .revdSecCnt,  dw 0001h        ;1 Reserved Sector
    64 00000A71 02                  <1>     at .numFATs,     db 02h          ;2 FAT tables
    65 00000A72 E000                <1>     at .rootEntCnt,  dw 00E0h        ;224 root entries
    66 00000A74 FFFF                <1>     at .totSec16,    dw -1           ;Total number of sectors on disk
    67 00000A76 F0                  <1>     at .media,       db 0F0h         ;Media byte
    68 00000A77 FFFF                <1>     at .FATsz16,     dw -1           ;9 FAT sectors, normally
    69 00000A79 1200                <1>     at .secPerTrk,   dw 0012h        ;18 Sectors per track
    70 00000A7B 0200                <1>     at .numHeads,    dw 0002h        ;2 Heads
    71 00000A7D FFFFFFFF            <1>     at .hiddSec,     dd -1           ;No hidden sectors on removable
    72 00000A81 00000000            <1>     at .totSec32,    dd 0            ;Not a FAT32 BPB
    73                              <1>     iend
    74                              <1>     istruc extBs 
    75 00000A85 FF                  <1>     at .drvNum,         db -1   ;Set to 0 for Remdev, 80h for fixed disk
    76 00000A86 00                  <1>     at .reserved1,      db 00h
    77 00000A87 29                  <1>     at .bootSig,        db extBsSig ;Normal signature
    78 00000A88 FFFFFFFF            <1>     at .volId,          dd -1       ;Set to date/time @ format
    79 00000A8C 4E4F204E414D452020- <1>     at .volLab,         db 'NO NAME    '    
    79 00000A95 2020                <1>
    80 00000A97 4641543132202020    <1>     at .filSysType,     db 'FAT12   '
    81                              <1>     iend
    82                              <1> 
    83                              <1> 
    84                              <1> genericBPB16:
    85                              <1>     istruc bpb
    86 00000A9F FFFF                <1>     at .bytsPerSec,  dw -1           ;512 bytes per sector, normally
    87 00000AA1 FF                  <1>     at .secPerClus,  db -1           ;Sectors per cluster
    88 00000AA2 0100                <1>     at .revdSecCnt,  dw 0001h        ;1 Reserved Sector
    89 00000AA4 02                  <1>     at .numFATs,     db 02h          ;2 FAT tables
    90 00000AA5 0002                <1>     at .rootEntCnt,  dw 0200h        ;512 root entries
    91 00000AA7 FFFF                <1>     at .totSec16,    dw -1           ;Total number of sectors on disk
    92 00000AA9 F0                  <1>     at .media,       db 0F0h         ;Media byte
    93 00000AAA FFFF                <1>     at .FATsz16,     dw -1           ;Number of sectors per FAT
    94 00000AAC 3F00                <1>     at .secPerTrk,   dw 003Fh        ;FAT16 and 32 have Hard disk geometry 
    95 00000AAE FF00                <1>     at .numHeads,    dw 00FFh        ;255 Heads
    96 00000AB0 FFFFFFFF            <1>     at .hiddSec,     dd -1           ;No hidden sectors on removable
    97 00000AB4 00000000            <1>     at .totSec32,    dd 0            ;Not a FAT32 BPB
    98                              <1>     iend
    99                              <1>     istruc extBs 
