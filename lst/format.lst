    14 00000A1B C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   294                              <1> 
   295                              <1> getASCIINumber:
   296                              <1> ;Accumulates the value in ebx and returns it.
   297                              <1> ;First char read must be a digit, else, we treat a non-digit
   298                              <1> ; as a terminator of the number. 
   299                              <1> ;If the value is greater than 32 bits, treat as invalid input
   300 00000A1C 31DB                <1>     xor ebx, ebx
   301 00000A1E E8A4FFFFFF          <1>     call readChar    ;First char after : must be a digit
   302 00000A23 E844000000          <1>     call isAlDigit
   303 00000A28 0F827B040000        <1>     jc badParamExit
   304                              <1> .lp:
   305 00000A2E 250F000000          <1>     and eax, 0Fh    ;Save lower nybble only and zero the rest of the register
   306 00000A33 89DD                <1>     mov ebp, ebx    ;Dont use lea because we cant check for carry
   307 00000A35 C1E302              <1>     shl ebx, 2      ;4*ebx
   308 00000A38 0F826B040000        <1>     jc badParamExit
   309 00000A3E 01EB                <1>     add ebx, ebp    ;5*ebx
   310 00000A40 0F8263040000        <1>     jc badParamExit
   311 00000A46 D1E3                <1>     shl ebx, 1      ;10*ebx
   312 00000A48 0F825B040000        <1>     jc badParamExit
   313 00000A4E 01C3                <1>     add ebx, eax    ;Add new digit value
   314 00000A50 0F8253040000        <1>     jc badParamExit
   315 00000A56 85C9                <1>     test ecx, ecx   ;Stop if we run out of chars to process
   316                              <1>     retz
    41                              <2> cret z
    19                              <3> %%_base:
    20                              <3> %assign baseVar %%_base-$$
    21                              <3>  %ifdef retOff
    22                              <3>  %if (baseVar - retOff <= 126) && (baseVar > retOff)
    23                              <3>  %ifdef currSegVBase
    24                              <3>  j%+1 short (retOff+currSegVBase)
    25                              <3>  %else
    26 00000A58 74(1B)              <3>  j%+1 short retOff
    27                              <3>  %endif
    28                              <3>  %else
    29                              <3>  j%-1 short %%a
    30                              <3>  return
    31                              <3> %%a:
    32                              <3>  %endif
    33                              <3>  %else
    34                              <3>  j%-1 short %%a
    35                              <3>  return
    36                              <3> %%a:
    37                              <3>  %endif
   317 00000A5A E86CFFFFFF          <1>     call readChar.noCheck    ;Else get the next char
   318 00000A5F E808000000          <1>     call isAlDigit              ;If it is a digit, keep processing
   319 00000A64 73C8                <1>     jnc .lp
   320                              <1> ;Else, we reset to the first non-digit char and return.
   321 00000A66 48FFCE              <1>     dec rsi
   322 00000A69 FFC1                <1>     inc ecx
   323                              <1>     return
    13                              <2> %%_ret:
    14 00000A6B C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   324                              <1> 
   325                              <1> isAlDigit:
   326 00000A6C 3C30                <1>     cmp al, "0"
   327 00000A6E 7206                <1>     jb .notDigit
   328 00000A70 3C39                <1>     cmp al, "9"
   329 00000A72 7702                <1>     ja .notDigit
   330 00000A74 F8                  <1>     clc
   331                              <1>     return
    13                              <2> %%_ret:
    14 00000A75 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
