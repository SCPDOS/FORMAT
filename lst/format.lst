   541                              <1> decimalise:
   542                              <1> ;Input: rax = value to decimalise
   543                              <1> ;       rdi -> Ptr to byte buffer to store string in with commas
   544                              <1> ;       ecx = buffer length
   545                              <1> ;Output: Buffer @ rdi filled in! 
   546                              <1> ;       ecx = Number of chars in buffer.
   547                              <1> ; Warning: If the number of chars in the buffer reaches buffer length,
   548                              <1> ;   we return with CF=CY. Else, CF=NC.
   549 000006D5 57                  <1>     push rdi
   550 000006D6 89CE                <1>     mov esi, ecx    
   551 000006D8 31C9                <1>     xor ecx, ecx    ;Use cl as buffer length ctr, ch as comma ctr
   552 000006DA BB0A000000          <1>     mov ebx, 0Ah    ;Divide by 10
   553                              <1> .lp:
   554 000006DF 80FD03              <1>     cmp ch, 3       ;Are we divisible by 3?
   555 000006E2 750F                <1>     jne .skipSep
   556 000006E4 4038CE              <1>     cmp sil, cl
   557 000006E7 742A                <1>     je .exitErr     ;Before we add a comma, do we have space?
   558                              <1>     ;mov dl, byte [ctryData + countryStruc.thouSep]
   559                              <1>     ;mov byte [rdi], dl
   560 000006E9 C6072C              <1>     mov byte [rdi], ","
   561 000006EC 48FFC7              <1>     inc rdi 
   562 000006EF FEC1                <1>     inc cl          ;Inc number of chars
   563 000006F1 30ED                <1>     xor ch, ch      ;Reset comma counter
   564                              <1> .skipSep:
   565 000006F3 4038CE              <1>     cmp sil, cl
   566 000006F6 741B                <1>     je .exitErr     ;Before we add a digit, do we have space?
   567 000006F8 31D2                <1>     xor edx, edx
   568 000006FA 48F7F3              <1>     div rbx         ;Divide rax by 10
   569 000006FD 80C230              <1>     add dl, "0"     
   570 00000700 8817                <1>     mov byte [rdi], dl
   571 00000702 48FFC7              <1>     inc rdi
   572 00000705 FEC1                <1>     inc cl          ;Inc number of chars
   573 00000707 FEC5                <1>     inc ch          ;Inc to keep track of commas
   574 00000709 4885C0              <1>     test rax, rax
   575 0000070C 75D1                <1>     jnz .lp
   576                              <1> ;The test cleared CF if we are here
   577 0000070E 0FB6C9              <1>     movzx ecx, cl
   578                              <1> .exit:
   579 00000711 5F                  <1>     pop rdi
   580                              <1>     return
    13                              <2> %%_ret:
    14 00000712 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
