   691                              <1> computeFAT:
   692                              <1> ;Returns if FAT12/16/32 should be used for volume parameters input.
   693                              <1> ;Output: ecx = 0 => FAT 12, ecx = 1 => FAT 16, ecx = 2 => FAT 32
   694                              <1> ;All other regs preserved
   695 0000080A 50                  <1>     push rax
   696 0000080B 52                  <1>     push rdx
   697 0000080C 57                  <1>     push rdi
   698 0000080D 488B3DE3020000      <1>     mov rdi, [bpbPtr]   ;Get ptr to the returned bpb
   699                              <1> ;Compute space taken by fats
   700 00000814 0FB7470B            <1>     movzx eax, word [rdi + bpb.FATsz16]
   701 00000818 0FB64F05            <1>     movzx ecx, byte [rdi + bpb.numFATs]
   702 0000081C F7E1                <1>     mul ecx ;Get number of sectors occupied by all the fat copies
   703 0000081E 66034703            <1>     add ax, word [rdi + bpb.revdSecCnt] ;Add the number of reserved sectors
   704 00000822 66034706            <1>     add ax, word [rdi + bpb.rootEntCnt] ;Add the root dir sectors
   705 00000826 50                  <1>     push rax    ;Save the non-data space
   706                              <1> ;Get the total number of sectors on the volume in eax
   707 00000827 0FB74708            <1>     movzx eax, word [rdi + bpb.totSec16]
   708 0000082B 8B4F15              <1>     mov ecx, dword [rdi + bpb.totSec32]
   709 0000082E 85C0                <1>     test eax, eax
   710 00000830 0F44C1              <1>     cmovz eax, ecx  ;Move ecx to to eax if eax is zero
   711 00000833 59                  <1>     pop rcx
   712 00000834 29C8                <1>     sub eax, ecx    ;Get the data space only in eax.
   713 00000836 0FB64F02            <1>     movzx ecx, byte [rdi + bpb.secPerClus]
   714 0000083A 85C9                <1>     test ecx, ecx
