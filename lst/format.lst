   716 0000083F 31D2                <1>     xor edx, edx
   717 00000841 F7F1                <1>     div ecx         ;Get number of clusters in eax
   718                              <1> ;Now setup the return value in ecx
   719 00000843 B902000000          <1>     mov ecx, 2  ;FAT 32 marker
   720 00000848 3DF5FF0000          <1>     cmp eax, fat16MaxClustCnt
   721 0000084D 730B                <1>     jae .exit
   722 0000084F FFC9                <1>     dec ecx     ;FAT 16 marker
   723 00000851 3DF50F0000          <1>     cmp eax, fat12MaxClustCnt
   724 00000856 7302                <1>     jae .exit
   725 00000858 FFC9                <1>     dec ecx     ;FAT 12 marker
   726                              <1> .exit:
   727 0000085A 5F                  <1>     pop rdi
   728 0000085B 5A                  <1>     pop rdx
   729 0000085C 58                  <1>     pop rax
   730                              <1>     return
