   540                              <1> decimalise:
   541                              <1> ;Input: rax = value to decimalise
   542                              <1> ;       rdi -> Ptr to byte buffer to store string in with commas
   543                              <1> ;       ecx = buffer length
   544                              <1> ;Output: Buffer @ rdi filled in! 
   545                              <1> ;       ecx = Number of chars in buffer.
   546                              <1> ; Warning: If the number of chars in the buffer reaches buffer length,
   547                              <1> ;   we return with CF=CY. Else, CF=NC.
   548 000006C8 57                  <1>     push rdi
   549 000006C9 89CE                <1>     mov esi, ecx    
   550 000006CB 31C9                <1>     xor ecx, ecx    ;Use cl as buffer length ctr, ch as comma ctr
   551 000006CD BB0A000000          <1>     mov ebx, 0Ah    ;Divide by 10
   552                              <1> .lp:
   553 000006D2 80FD03              <1>     cmp ch, 3       ;Are we divisible by 3?
   554 000006D5 750F                <1>     jne .skipSep
   555 000006D7 4038CE              <1>     cmp sil, cl
   556 000006DA 742A                <1>     je .exitErr     ;Before we add a comma, do we have space?
   557                              <1>     ;mov dl, byte [ctryData + countryStruc.thouSep]
   558                              <1>     ;mov byte [rdi], dl
   559 000006DC C6072C              <1>     mov byte [rdi], ","
   560 000006DF 48FFC7              <1>     inc rdi 
   561 000006E2 FEC1                <1>     inc cl          ;Inc number of chars
   562 000006E4 30ED                <1>     xor ch, ch      ;Reset comma counter
   563                              <1> .skipSep:
   564 000006E6 4038CE              <1>     cmp sil, cl
   565 000006E9 741B                <1>     je .exitErr     ;Before we add a digit, do we have space?
   566 000006EB 31D2                <1>     xor edx, edx
   567 000006ED 48F7F3              <1>     div rbx         ;Divide rax by 10
   568 000006F0 80C230              <1>     add dl, "0"     
   569 000006F3 8817                <1>     mov byte [rdi], dl
   570 000006F5 48FFC7              <1>     inc rdi
   571 000006F8 FEC1                <1>     inc cl          ;Inc number of chars
   572 000006FA FEC5                <1>     inc ch          ;Inc to keep track of commas
   573 000006FC 4885C0              <1>     test rax, rax
   574 000006FF 75D1                <1>     jnz .lp
   575                              <1> ;The test cleared CF if we are here
   576 00000701 0FB6C9              <1>     movzx ecx, cl
   577                              <1> .exit:
   578 00000704 5F                  <1>     pop rdi
   579                              <1>     return
    13                              <2> %%_ret:
    14 00000705 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
