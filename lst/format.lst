   176                              <1> updateStatus:
   177                              <1> ;Used to update the number of sectors processed and update the message
   178                              <1> ; if appropriate.
   179 00001022 48FF0509030000      <1>     inc qword [secDone]
   180 00001029 51                  <1>     push rcx
   181 0000102A 52                  <1>     push rdx
   182 0000102B 488B0500030000      <1>     mov rax, qword [secDone]
   183 00001032 BB64000000          <1>     mov ebx, 100
   184 00001037 48F7E3              <1>     mul rbx ;Multiply number of sectors by 100
   185 0000103A 488B1DE9020000      <1>     mov rbx, qword [secToDo]
   186 00001041 31D2                <1>     xor edx, edx
   187 00001043 48F7F3              <1>     div rbx ;Get percentage of sectors processed in rax (formally al)
   188 00001046 3A05EE020000        <1>     cmp al, byte [secPercent]
   189 0000104C 7423                <1>     je .exit    ;If they are equal, dont bother printing again
   190                              <1> ;Here we have a new percentage! Update the message!
   191 0000104E 8805E6020000        <1>     mov byte [secPercent], al
   192 00001054 B903000000          <1>     mov ecx, 3  ;Max 3 chars to print (up to 100)
   193 00001059 E823000000          <1>     call printDecimalValLB
   194 0000105E 488D15C9080000      <1>     lea rdx, fmtPcntMsg
   195 00001065 E81EFEFFFF          <1>     call printString
   196 0000106A B20D                <1>     mov dl, CR
   197 0000106C E80FFEFFFF          <1>     call putch  ;End by returning to the start of the line
   198                              <1> .exit:
   199 00001071 5A                  <1>     pop rdx
   200 00001072 59                  <1>     pop rcx
   201                              <1>     return 
