   205                              <1> readChar:
   206                              <1> ;Reads a character from the command tail. 
   207                              <1> ; If the count goes to zero or CR read, end of line!
   208                              <1> ;Input: ecx = Number of chars left to read
   209                              <1> ;       rsi -> String to read
   210                              <1> ;Output: rsi -> Adv by one char
   211                              <1> ;        ecx -= 1
   212                              <1> ;       ZF=ZE: End of cmd tail
   213                              <1> ;       ZF=NZ: Not end of cmd tail
   214 000009C7 85C9                <1>     test ecx, ecx
   215                              <1>     retz
