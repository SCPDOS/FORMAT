   276                              <1> ucChar:
   277                              <1> ;Input: al = Char to uppercase
   278                              <1> ;Output: al = Adjusted char 
   279                              <1> ;Use normal localised uppercase instead of normal uppercase as
   280                              <1> ; drive letters are in the overlap of normal and filename uc.
   281                              <1> ;This allows for use of this function beyond just drive letter UC-ing
   282                              <1> ; (i.e. for switch chars)
   283 000009FC 52                  <1>     push rdx
   284 000009FD 89C2                <1>     mov edx, eax
   285 000009FF B820650000          <1>     mov eax, 6520h
   286 00000A04 CD21                <1>     int 21h
   287 00000A06 89D0                <1>     mov eax, edx
   288 00000A08 5A                  <1>     pop rdx
   289                              <1>     return
