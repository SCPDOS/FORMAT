    15                              <1> .skipSwitch:
    16 000007D7 B801610000          <1>     mov eax, 6101h  ;Get cmd line arguments
    17 000007DC CD21                <1>     int 21h ;Get in rdx ptr to the command tail
    18 000007DE 488D7224            <1>     lea rsi, qword [rdx + cmdLineArgs.parmList]
    19 000007E2 AC                  <1>     lodsb           ;Get count and point to first char in command tail.
    20 000007E3 0FB6C8              <1>     movzx ecx, al   ;Put count into ecx
    21 000007E6 803C0E0D            <1>     cmp byte [rsi + rcx], CR    ;Is this a valid command line?
    22 000007EA 0F85B9060000        <1>     jne badParamExit
