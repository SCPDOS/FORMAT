     4                              <1> doYNWait:
     5                              <1> ;This does the below but also outputs a new line to 
     6                              <1> ; indicate that input has been recieved.
     7 00000A78 E80F000000          <1>     call .doWait
     8 00000A7D 9C                  <1>     pushfq
     9 00000A7E 488D15CF0B0000      <1>     lea rdx, crlfStr
    10 00000A85 E8AAFCFFFF          <1>     call printString    ;Output a new line!
    11 00000A8A 9D                  <1>     popfq
    12                              <1>     return
    13                              <2> %%_ret:
    14 00000A8B C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
    13                              <1> .doWait:
    14                              <1> ;Input: rdx -> String to wait for Y/N on.
    15                              <1> ;Output: CF=NC -> Y(es)
    16                              <1> ;        CF=CY -> N(o)
    17 00000A8C 52                  <1>     push rdx
    18 00000A8D E8A2FCFFFF          <1>     call printString
    19 00000A92 E88DFCFFFF          <1>     call getch
    20 00000A97 0FB6D0              <1>     movzx edx, al
    21 00000A9A B823650000          <1>     mov eax, 6523h  ;Zeros upper word of lower dword
    22 00000A9F CD21                <1>     int 21h
    23 00000AA1 5A                  <1>     pop rdx
    24 00000AA2 3D01000000          <1>     cmp eax, 1
    25 00000AA7 77E3                <1>     ja .doWait
    26                              <1>     return
    13                              <2> %%_ret:
    14 00000AA9 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
