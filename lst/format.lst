   759                              <1> doYNWait:
   760                              <1> ;Input: rdx -> String to wait for Y/N on.
   761                              <1> ;Output: CF=NC -> N
   762                              <1> ;        CF=CY -> Y
   763 000008C7 52                  <1>     push rdx
   764 000008C8 E855000000          <1>     call printString
   765 000008CD E840000000          <1>     call getch
   766 000008D2 3C79                <1>     cmp al, "y"
   767 000008D4 740F                <1>     je .yes
   768 000008D6 3C59                <1>     cmp al, "Y"
   769 000008D8 740B                <1>     je .yes
   770 000008DA 3C6E                <1>     cmp al, "n"
   771 000008DC 7408                <1>     je .no
   772 000008DE 3C4E                <1>     cmp al, "N"
   773 000008E0 7404                <1>     je .no
   774 000008E2 5A                  <1>     pop rdx
   775 000008E3 EB03                <1>     jmp short breakRoutine
   776                              <1> .yes:
   777 000008E5 F9                  <1>     stc
   778                              <1> .no:
   779 000008E6 5A                  <1>     pop rdx
   780                              <1>     return
    13                              <2> %%_ret:
    14 000008E7 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
