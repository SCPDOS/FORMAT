   911 000009C4 B801000000          <1>     mov eax, specFuncBPB    ;Get the backup bpb (which is old prev bpb)
   912 000009C9 E826000000          <1>     call getBpb
   913 000009CE 730F                <1>     jnc .gotBpb
   914                              <1> .bad:
   915                              <1> ;If we cant even get the BS anymore, lock drive (if fixed).
   916 000009D0 F6050E010000FF      <1>     test byte [remDev], -1
   917                              <1>     retz
