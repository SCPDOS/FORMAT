   600                              <1> checkBreak:
   601                              <1> ;Checks if control C has been struck and triggers Int 23h.
   602                              <1> ;21h/0Bh does a non-blocking check of the keyboard buffer status.
   603                              <1> ;If there is a Ctrl+C waiting in buffer, it triggers Int 23h.
   604                              <1> ;If the user then doesn't want to exit the program, it reenters 
   605                              <1> ; the call to check the keyboard status which will just return 
   606                              <1> ; if the buffer is full or empty.
   607                              <1> ;If no Ctrl+C waiting in the buffer, it just return the keyboard status.
   608 00000713 B8000B0000          <1>     mov eax, 0B00h
   609 00000718 CD21                <1>     int 21h
   610                              <1>     return
    13                              <2> %%_ret:
    14 0000071A C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
