    15                              <1> .skipSwitch:
    16 000007D4 B801610000          <1>     mov eax, 6101h  ;Get cmd line arguments
    17 000007D9 CD21                <1>     int 21h ;Get in rdx ptr to the command tail
    18 000007DB 488D7224            <1>     lea rsi, qword [rdx + cmdLineArgs.parmList]
    19 000007DF AC                  <1>     lodsb           ;Get count and point to first char in command tail.
    20 000007E0 0FB6C8              <1>     movzx ecx, al   ;Put count into ecx
    21 000007E3 803C0E0D            <1>     cmp byte [rsi + rcx], CR    ;Is this a valid command line?
    22 000007E7 0F85AA060000        <1>     jne badParamExit
