   120                              <1> ;Device types in the chs parameter block
   121                              <1> ;Device Type flags
   122                              <1> type48TPI   equ 0   ;Small floppy format, depreciated
   123                              <1> type96TPI   equ 1   ;Large floppy format, depreciated
   124                              <1> typeSmall   equ 2   ;Super large floppy format, depreciated
   125                              <1> type8InchSS equ 3   ;8" single sided floppy format, depreciated
   126                              <1> type8InchDS equ 4   ;8" double sided floppy format, depreciated
   127                              <1> typeTape    equ 6   ;Tape drive, depreciated
   128                              <1> typeOptical equ 8   ;Optical drive, unused
   129                              <1> type288     equ 9   ;2.88Mb floppy, depreciated
   130                              <1> ;The above are not completely supported by this version of the driver.
   131                              <1> typeHard    equ 5   ;Hard drive
   132                              <1> typeGenRem  equ 7   ;Generic removable medium, default
    47                                  
    48                                  %include "./src/fmtMain.asm"
     1                              <1> ;String ops all go the right way on program starup
     2                              <1> startFormat:
     3 00000000 EB01                <1>     jmp short .cVersion
     4 00000002 01                  <1> .vNum:          db 1
     5                              <1> .cVersion:
     6                              <1> ;Now check the version!
     7 00000003 B800300000          <1>     mov eax, 3000h
     8 00000008 CD21                <1>     int 21h
     9 0000000A 3A05F2FFFFFF        <1>     cmp al, byte [.vNum] ;Version 1
    10 00000010 0F8764110000        <1>     ja badVerExit
    11                              <1>     breakpoint
    81 00000016 6687DB              <2> xchg bx, bx
    12                              <1> ;Now do reallocation. 
    13                              <1> ; We always allocate one 4096 byte buffer and a 4096 byte stack.
    14 00000019 488D1DB01F0000      <1>     lea rbx, bootloader + 2*512 ;Go past the two bootloaders
    15 00000020 48891D90120000      <1>     mov qword [pBuffer], rbx    ;Use this space as IO buffer
    16 00000027 4881C300200000      <1>     add rbx, 2*4096             ;Point to the end of this area
    17 0000002E 4889DC              <1>     mov rsp, rbx                ;Set the stack pointer home
    18 00000031 4C29C3              <1>     sub rbx, r8
    19 00000034 48C1EB04            <1>     shr rbx, 4
    20 00000038 B8004A0000          <1>     mov eax, 4A00h      ;Shink always succeeds
    21 0000003D CD21                <1>     int 21h
    22 0000003F E8910D0000          <1>     call cleanBuffer    ;Clean the buffer
    23                              <1> ;Get the verify flag and set it. On exit, reset it!
    24 00000044 B800540000          <1>     mov eax, 5400h  ;Get verify state in al
    25 00000049 CD21                <1>     int 21h
    26 0000004B 880570120000        <1>     mov byte [bVerify], al  ;Save original verify in var
    27 00000051 B8012E0000          <1>     mov eax, 2E01h  ;Set verify on
    28 00000056 CD21                <1>     int 21h
    29                              <1> ;Parsing time :)
    30                              <1>     breakpoint
    81 00000058 6687DB              <2> xchg bx, bx
    31 0000005B E8A1080000          <1>     call parseMain  ;Now parse the command line
    32                              <1> ;We start with a bold get paramters call to assertain if the drive has
    33                              <1> ; a FAT. We ignore any failures as this could be a result of the drive 
    34                              <1> ; being deactivated, in which case we explicitly try to reactivate the drive.
    35                              <1> ;If further IOCTL errors occur thereonafter, we know the issue is the driver,
    36                              <1> ; not the CDS.
    37 00000060 E8E6010000          <1>     call getBpb
    38 00000065 803DE714000000      <1>     cmp byte [ioParams + chsParamsBlock.deviceBPB + bpb.numFATs], 0
    39 0000006C 751C                <1>     jne .fatDrv
    40 0000006E C6054F120000FF      <1>     mov byte [bCDSAdjust], -1   ;Set the CDS adjustment flag
    41 00000075 C6054912000000      <1>     mov byte [bValidFS], 0      ;No FAT found
    42 0000007C B8075F0000          <1>     mov eax, 5F07h
    43 00000081 0FB6152E120000      <1>     movzx edx, byte [fmtDrive]
    44 00000088 CD21                <1>     int 21h
    45                              <1> .fatDrv:
    46                              <1> ;Now ensure the drive we will be formatting is valid
    47                              <1> ;Check the drive is not a network drive. 
    48 0000008A B809440000          <1>     mov eax, 4409h
    49 0000008F 0FB61D20120000      <1>     movzx ebx, byte [fmtDrive]
    50 00000096 FFC3                <1>     inc ebx             ;Turn it into a 1 based number
    51 00000098 CD21                <1>     int 21h
    52 0000009A 7310                <1>     jnc .netChk
    53 0000009C 3D01000000          <1>     cmp eax, errInvFnc
    54 000000A1 0F844C110000        <1>     je badIOCTLExit     ;The IOCTL call failed! Crap out
    55 000000A7 E9A6100000          <1>     jmp badDrvExit      ;Else the drive letter was bad!
    56                              <1> .netChk:
    57 000000AC 66F7C20012          <1>     test dx, 1200h      ;Is the drive network or shared?
    58 000000B1 0F8557110000        <1>     jnz badNetExit
    59 000000B7 66F7C20080          <1>     test dx, 8000h      ;Is this assigned or substed?
    60 000000BC 0F8555110000        <1>     jnz badSubstExit
    61                              <1> ;Now we test assign (a front-end subst) by calling truename. This stops front 
    62                              <1> ; end hooks from swapping letters...
    63 000000C2 488D3D9E120000      <1>     lea rdi, outputBuffer   ;Large enough for 8 characters
    64 000000C9 4889FE              <1>     mov rsi, rdi
