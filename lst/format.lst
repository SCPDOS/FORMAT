   537                              <1> ;            CTRL+C handler            :
   538                              <1> ;---------------------------------------
   539                              <1> 
   540                              <1> breakRoutine:
   541                              <1> ;This subroutine is called by ^C
   542                              <1> ;Prompts the user for what they want to do.
   543                              <1> ;Preserve registers across call.
   544                              <1> ;
   545                              <1> ;We always return IRETQ which means we always execute the 
   546                              <1> ; function code that we return to DOS in eax. Unless we wish
   547                              <1> ; to terminate, we just re-attempt the function that was 
   548                              <1> ; ^C-ed.
   549                              <1> ;
   550 000006A1 52                  <1>     push rdx
   551 000006A2 50                  <1>     push rax
   552 000006A3 488D15440F0000      <1>     lea rdx, cancel
   553 000006AA E8C9030000          <1>     call doYNWait       ;If ret CF=NC, we said yes so exit! Else just redo op!
   554 000006AF 720C                <1>     jc .noAbort
   555 000006B1 E803010000          <1>     call dosCrit1Exit   ;Exit the critical section since we are quitting
   556 000006B6 58                  <1>     pop rax
   557 000006B7 B8034C0000          <1>     mov eax, 4C03h      ;Tell DOS to terminate with error level 3
   558 000006BC 50                  <1>     push rax
   559                              <1> ;Let DOS reclaim memory and handles allocated to us
   560                              <1> .noAbort:
   561 000006BD B20A                <1>     mov dl, LF
   562 000006BF E868000000          <1>     call putch
   563 000006C4 58                  <1>     pop rax
   564 000006C5 5A                  <1>     pop rdx
   565 000006C6 48CF                <1>     iretq   ;Redo the operation
   566                              <1> 
   567                              <1> ;---------------------------------------
   568                              <1> ;             DOS wrappers             :
   569                              <1> ;---------------------------------------
   570                              <1> restoreBpb:
   571                              <1> ;Gets the BPB from the bootsector again to restore the driver state.
   572 000006C8 B801000000          <1>     mov eax, specFuncBPB    ;Get the backup bpb (which is old prev bpb)
   573 000006CD E827000000          <1>     call getBpb
   574 000006D2 7310                <1>     jnc .gotBpb
   575                              <1> .bad:
   576                              <1> ;If we cant even get the BS anymore, lock drive (if fixed).
   577 000006D4 F605C1080000FF      <1>     test byte [fixDev], -1
   578                              <1>     retz
    41                              <2> cret z
