   352 00000DCD 0FB7C1              <1>     movzx eax, cx
   353 00000DD0 C1E310              <1>     shl ebx, 10h
   354 00000DD3 09D8                <1>     or eax, ebx
   355 00000DD5 5B                  <1>     pop rbx
