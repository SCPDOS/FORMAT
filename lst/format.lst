   118                                  %include "./src/fmtParse.asm"
     1                              <1> ;All routines used for parsing go here.
     2                              <1> ;We are flexible on the order of the arguments, switches can go before
     3                              <1> ; drive letters, we don't enforce an order. No arguments however can be
     4                              <1> ; multiply set and this constitutes an error.
     5                              <1> 
     6                              <1> ;Caveats:
     7                              <1> ;1) /C overrides formatting. It will switch to just reading and writing back
     8                              <1> ;    each ``bad'' sector. It won't mark sectors as bad.
     9                              <1> ;2) /F and {/N /T} cannot operate together. This constitutes an error.
