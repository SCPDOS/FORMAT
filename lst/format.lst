    11 00000FFF 0C00                <1> sVolLblLen  db 12, 0    ;Start of the string buffer
    12 00001001 202020202020202020- <1> sVolLbl     db 12 dup (SPC) ;Volume label goes here.
    12 0000100A 202020              <1>
