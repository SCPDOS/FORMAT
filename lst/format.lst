   540                              <1> decimalise:
   541                              <1> ;Input: rax = value to decimalise
   542                              <1> ;       rdi -> Ptr to byte buffer to store string in with commas
   543                              <1> ;       ecx = buffer length
   544                              <1> ;Output: Buffer @ rdi filled in! 
   545                              <1> ;       ecx = Number of chars in buffer.
   546                              <1> ; Warning: If the number of chars in the buffer reaches buffer length,
   547                              <1> ;   we return with CF=CY. Else, CF=NC.
   548 000006DB 57                  <1>     push rdi
   549 000006DC 89CE                <1>     mov esi, ecx    
   550 000006DE 31C9                <1>     xor ecx, ecx    ;Use cl as buffer length ctr, ch as comma ctr
   551 000006E0 BB0A000000          <1>     mov ebx, 0Ah    ;Divide by 10
   552                              <1> .lp:
   553 000006E5 80FD03              <1>     cmp ch, 3       ;Are we divisible by 3?
   554 000006E8 750F                <1>     jne .skipSep
   555 000006EA 4038CE              <1>     cmp sil, cl
   556 000006ED 742A                <1>     je .exitErr     ;Before we add a comma, do we have space?
   557                              <1>     ;mov dl, byte [ctryData + countryStruc.thouSep]
   558                              <1>     ;mov byte [rdi], dl
   559 000006EF C6072C              <1>     mov byte [rdi], ","
   560 000006F2 48FFC7              <1>     inc rdi 
   561 000006F5 FEC1                <1>     inc cl          ;Inc number of chars
   562 000006F7 30ED                <1>     xor ch, ch      ;Reset comma counter
   563                              <1> .skipSep:
   564 000006F9 4038CE              <1>     cmp sil, cl
   565 000006FC 741B                <1>     je .exitErr     ;Before we add a digit, do we have space?
   566 000006FE 31D2                <1>     xor edx, edx
   567 00000700 48F7F3              <1>     div rbx         ;Divide rax by 10
   568 00000703 80C230              <1>     add dl, "0"     
   569 00000706 8817                <1>     mov byte [rdi], dl
   570 00000708 48FFC7              <1>     inc rdi
   571 0000070B FEC1                <1>     inc cl          ;Inc number of chars
   572 0000070D FEC5                <1>     inc ch          ;Inc to keep track of commas
   573 0000070F 4885C0              <1>     test rax, rax
   574 00000712 75D1                <1>     jnz .lp
   575                              <1> ;The test cleared CF if we are here
   576 00000714 0FB6C9              <1>     movzx ecx, cl
   577                              <1> .exit:
   578 00000717 5F                  <1>     pop rdi
   579                              <1>     return
