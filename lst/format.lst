    36 00000E9D 9C                  <1>     pushfq
    37 00000E9E 488D15700A0000      <1>     lea rdx, crlfStr
    38 00000EA5 E8DEFFFFFF          <1>     call printString    ;Output a new line!
    39 00000EAA 9D                  <1>     popfq
    40                              <1>     return
    13                              <2> %%_ret:
    14 00000EAB C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
    41                              <1> .doWait:
    42                              <1> ;Input: rdx -> String to wait for Y/N on.
    43                              <1> ;Output: CF=NC -> Y(es)
    44                              <1> ;        CF=CY -> N(o)
    45 00000EAC 52                  <1>     push rdx
    46 00000EAD E8D6FFFFFF          <1>     call printString
    47 00000EB2 E8C1FFFFFF          <1>     call getch
    48 00000EB7 0FB6D0              <1>     movzx edx, al
    49 00000EBA B823650000          <1>     mov eax, 6523h  ;Zeros upper word of lower dword
    50 00000EBF CD21                <1>     int 21h
    51 00000EC1 5A                  <1>     pop rdx
    52 00000EC2 3D01000000          <1>     cmp eax, 1
    53 00000EC7 77E3                <1>     ja .doWait
    54                              <1>     return
    13                              <2> %%_ret:
    14 00000EC9 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
