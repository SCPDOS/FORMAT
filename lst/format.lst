    74 00000883 FFFFFFFF            <1>     at bpb.volID,       dd -1           ;Set volume ID to time
    75 00000887 4E4F204E414D452020- <1>     at bpb.volLab,      db 'NO NAME    '
    75 00000890 2020                <1>
    76 00000892 4641543132202020    <1>     at bpb.filSysType,  db 'FAT12   '
