   408                              <1> computeFATSize:
   409                              <1> ; Reads from the bpb in rdi. Applies the following algorithm
   410                              <1> ; RootDirSectors = ((BPB_RootEntCnt * 32) + (BPB_BytsPerSec – 1)) / BPB_BytsPerSec;
   411                              <1> ; TmpVal1 = DskSize – (BPB_ResvdSecCnt + RootDirSectors);
   412                              <1> ; TmpVal2 = (256 * BPB_SecPerClus) + BPB_NumFATs;
   413                              <1> ; If(FATType == FAT32)
   414                              <1> ;   TmpVal2 = TmpVal2 / 2;
   415                              <1> ; FATSz = (TMPVal1 + (TmpVal2 – 1)) / TmpVal2;
   416                              <1> ;Input:
   417                              <1> ;   rdi = Pointer to the head of the BPB we are using
   418                              <1> ;Returns: 
   419                              <1> ;   eax = Number of sectors per FAT needed. Low word only valid for FAT12/16
   420 00000B5D 53                  <1>     push rbx
   421 00000B5E 51                  <1>     push rcx
   422 00000B5F 52                  <1>     push rdx
   423 00000B60 57                  <1>     push rdi
   424                              <1>     
   425 00000B61 0FB74706            <1>     movzx eax, word [rdi + bpb.rootEntCnt]
   426 00000B65 C1E005              <1>     shl eax, 5  ;Multiply by 32
   427 00000B68 0FB71F              <1>     movzx ebx, word [rdi + bpb.bytsPerSec]
   428 00000B6B FFCB                <1>     dec ebx
   429 00000B6D 01D8                <1>     add eax, ebx
   430 00000B6F FFC3                <1>     inc ebx
   431 00000B71 31D2                <1>     xor edx, edx
   432 00000B73 F7F3                <1>     div ebx
   433 00000B75 89C2                <1>     mov edx, eax    ;edx = RootDirSectors
   434                              <1> 
   435 00000B77 0FB74708            <1>     movzx eax, word [rdi + bpb.totSec16]
   436 00000B7B 8B5F15              <1>     mov ebx, dword [rdi + bpb.totSec32]
   437 00000B7E 85C0                <1>     test eax, eax   ;If totSec16 is 0, move totSec32 into eax
   438 00000B80 0F44C3              <1>     cmovz eax, ebx
   439 00000B83 0FB75F03            <1>     movzx ebx, word [rdi + bpb.revdSecCnt]
   440 00000B87 01D3                <1>     add ebx, edx    ;Add RootDirSectors
   441 00000B89 29D8                <1>     sub eax, ebx
   442 00000B8B 89C1                <1>     mov ecx, eax    ;ecx = TmpVal1
   443                              <1> 
   444 00000B8D 0FB64702            <1>     movzx eax, byte [rdi + bpb.secPerClus]
   445 00000B91 C1E008              <1>     shl eax, 8  ;multiply by 256
   446 00000B94 0FB65F05            <1>     movzx ebx, byte [rdi + bpb.numFATs]
   447 00000B98 01C3                <1>     add ebx, eax    ;ebx = TmpVal2
   448                              <1> 
   449 00000B9A 803D0B01000002      <1>     cmp byte [fatType], fs_fat32
   450 00000BA1 7502                <1>     jne .notFat32
   451 00000BA3 D1EB                <1>     shr ebx, 1  ;Divide by 2
   452                              <1> .notFat32: 
   453 00000BA5 89C8                <1>     mov eax, ecx    ;TmpVal1
   454 00000BA7 FFCB                <1>     dec ebx
   455 00000BA9 01D8                <1>     add eax, ebx    ;TmpVal1 + (TmpVal2 - 1)
   456 00000BAB FFC3                <1>     inc ebx
   457 00000BAD 31D2                <1>     xor edx, edx
   458 00000BAF F7F3                <1>     div ebx ;Exit with eax = number of sectors needed per FAT
   459                              <1> .exit:
   460 00000BB1 5F                  <1>     pop rdi
   461 00000BB2 5A                  <1>     pop rdx
   462 00000BB3 59                  <1>     pop rcx
   463 00000BB4 5B                  <1>     pop rbx
   464                              <1>     return
