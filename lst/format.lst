   268                              <1> writeRootDir:
   269                              <1> ;Sets up the root directory on the disk.
   270                              <1> ;Correctly selects a good cluster for FAT32 root directories.
   271 000005AA 803D290D000002      <1>     cmp byte [fatType], fs_fat32
   272 000005B1 743B                <1>     je .fat32
   273                              <1>     ;Here we compute the number of Root Dir sectors and sanitise them
   274                              <1>     ;rdx should point to that sector now (since it works on FAT copy 2 last)
   275 000005B3 488B1D290D0000      <1>     mov rbx, qword [bpbPtr]
   276 000005BA 0FB77306            <1>     movzx esi, word [rbx + bpb.rootEntCnt]  ;Get the number of 32 byte entries
   277 000005BE C1E605              <1>     shl esi, 5  ;Convert into the number of bytes in root directory
   278 000005C1 0FB705240D0000      <1>     movzx eax, word [sectorSize]    ;Get the sector size
   279 000005C8 96                  <1>     xchg esi, eax
   280 000005C9 52                  <1>     push rdx
   281 000005CA 31D2                <1>     xor edx, edx
   282 000005CC F7F6                <1>     div esi ;Divide to get number of sectors in eax, preserve edx
   283 000005CE 5A                  <1>     pop rdx ;Save edx
   284 000005CF 89C6                <1>     mov esi, eax    ;Number of sectors in esi
   285 000005D1 B901000000          <1>     mov ecx, 1  ;Write one sector
   286                              <1> .fatLoop:
   287 000005D6 FFC2                <1>     inc edx ;Go to next sector now
   288 000005D8 51                  <1>     push rcx
   289 000005D9 52                  <1>     push rdx
   290 000005DA 56                  <1>     push rsi
   291 000005DB E83CFCFFFF          <1>     call writeSector
   292 000005E0 5E                  <1>     pop rsi
   293 000005E1 5A                  <1>     pop rdx
   294 000005E2 59                  <1>     pop rcx
   295 000005E3 0F82E00B0000        <1>     jc badDirExit
   296 000005E9 FFCE                <1>     dec esi
   297 000005EB 75E9                <1>     jnz .fatLoop
