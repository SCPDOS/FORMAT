    14 00000A09 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   290                              <1> 
   291                              <1> getASCIINumber:
   292                              <1> ;Accumulates the value in ebx and returns it.
   293                              <1> ;First char read must be a digit, else, we treat a non-digit
   294                              <1> ; as a terminator of the number. 
   295                              <1> ;If the value is greater than 32 bits, treat as invalid input
   296 00000A0A 31DB                <1>     xor ebx, ebx
   297 00000A0C E8A4FFFFFF          <1>     call readChar    ;First char after : must be a digit
   298 00000A11 E844000000          <1>     call isAlDigit
   299 00000A16 0F827B040000        <1>     jc badParamExit
   300                              <1> .lp:
   301 00000A1C 250F000000          <1>     and eax, 0Fh    ;Save lower nybble only and zero the rest of the register
   302 00000A21 89DD                <1>     mov ebp, ebx    ;Dont use lea because we cant check for carry
   303 00000A23 C1E302              <1>     shl ebx, 2      ;4*ebx
   304 00000A26 0F826B040000        <1>     jc badParamExit
   305 00000A2C 01EB                <1>     add ebx, ebp    ;5*ebx
   306 00000A2E 0F8263040000        <1>     jc badParamExit
   307 00000A34 D1E3                <1>     shl ebx, 1      ;10*ebx
   308 00000A36 0F825B040000        <1>     jc badParamExit
   309 00000A3C 01C3                <1>     add ebx, eax    ;Add new digit value
   310 00000A3E 0F8253040000        <1>     jc badParamExit
   311 00000A44 85C9                <1>     test ecx, ecx   ;Stop if we run out of chars to process
   312                              <1>     retz
    41                              <2> cret z
