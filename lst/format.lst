   778                              <1> doYNWait:
   779                              <1> ;Input: rdx -> String to wait for Y/N on.
   780                              <1> ;Output: CF=NC -> N
   781                              <1> ;        CF=CY -> Y
   782 000008F4 52                  <1>     push rdx
   783 000008F5 E8B0000000          <1>     call printString
   784 000008FA E89B000000          <1>     call getch
   785 000008FF 3C79                <1>     cmp al, "y"
   786 00000901 740F                <1>     je .yes
   787 00000903 3C59                <1>     cmp al, "Y"
   788 00000905 740B                <1>     je .yes
   789 00000907 3C6E                <1>     cmp al, "n"
   790 00000909 7408                <1>     je .no
   791 0000090B 3C4E                <1>     cmp al, "N"
   792 0000090D 7404                <1>     je .no
