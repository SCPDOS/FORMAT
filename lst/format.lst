    28                              <1> ;--------------------------------------
    29                              <1> ;          Utility functions          :
    30                              <1> ;--------------------------------------
    31                              <1> writeDiskStats:
    32                              <1> ;Writes the disk statistics after a format.
    33                              <1> ;-------------------------------------------------------
    34                              <1> ;<Number> bytes total disk space
    35                              <1> ;<Number> bytes used by system (if /S set and system files installed)
    36                              <1> ;<Number> bytes in bad sectors (if bad sectors. Always rounds to # of clusters)
    37                              <1> ;<Number> bytes available on disk 
    38                              <1> ;
    39                              <1> ;<Number> bytes in each allocation unit.
    40                              <1> ;<Number> allocation units available on disk. ;alloc units are clusters
    41                              <1> ;
    42                              <1> ;Volume Serial Number is <Serial-Number>
    43                              <1> ;-------------------------------------------------------
    44                              <1> ;Start start by putting a new line
    45 00000A98 488D15A30B0000      <1>     lea rdx, crlfStr
    46 00000A9F E88DFCFFFF          <1>     call printString
    47                              <1> ;Start by getting free sector count from DOS. We do this to make the 
    48                              <1> ; computation of the free sector count easier after /s and if any bad clusters.
    49 00000AA4 B800360000          <1>     mov eax, 3600h  ;Get free space count
    50 00000AA9 0FB615AC040000      <1>     movzx edx, byte [fmtDrive]
    51 00000AB0 FFC2                <1>     inc edx ;Turn into a 1 based count
    52 00000AB2 CD21                <1>     int 21h
    53                              <1> ;If we have a FAT 32 drive, add one cluster to the free count to account for
    54                              <1> ; the root directory cluster.
    55 00000AB4 803DD004000002      <1>     cmp byte [fatType], fs_fat32
    56 00000ABB 7502                <1>     jne .goSave
    57 00000ABD FFC3                <1>     inc ebx ;Discount the root directory from initial count!
    58                              <1> .goSave:
    59                              <1> ;Use x64 regs instead of stack frame
    60 00000ABF 4989D0              <1>     mov r8, rdx ;r8 = Total cluster count in data area
    61 00000AC2 4989D9              <1>     mov r9, rbx ;r9 = Free cluster count in the data area
    62                              <1> ;Total number of bytes, ebx still has total count
    63 00000AC5 0FB605CA040000      <1>     movzx eax, byte [secPerClust]
    64 00000ACC 0FB70DB9040000      <1>     movzx ecx, word [sectorSize]
    65 00000AD3 F7E1                <1>     mul ecx     ;Get the number of bytes per cluster in eax
    66 00000AD5 4989C2              <1>     mov r10, rax    ;Save this value in r10
    67 00000AD8 49F7E0              <1>     mul r8      ;Get in eax the number of bytes on disk
    68 00000ADB E868010000          <1>     call printDecimalDword
    69 00000AE0 488D153B0C0000      <1>     lea rdx, totalBytesStr
    70 00000AE7 E845FCFFFF          <1>     call printString
    71                              <1> ;System bytes
    72 00000AEC F6057B04000002      <1>     test byte [bFlag1], bitSystem
    73 00000AF3 741E                <1>     jz .skipSystem
    74 00000AF5 4C89C9              <1>     mov rcx, r9     ;Get the free cluster count
    75 00000AF8 4C89C0              <1>     mov rax, r8     ;Get the total cluster count
    76 00000AFB 29C8                <1>     sub eax, ecx    ;Workout the amount of space taken by system files
    77 00000AFD 4C89D1              <1>     mov rcx, r10    ;Get word BytesPerClust
    78 00000B00 F7E1                <1>     mul ecx         ;Get the number of bytes taken by system files
    79 00000B02 E841010000          <1>     call printDecimalDword
    80 00000B07 488D152E0C0000      <1>     lea rdx, sysBytesStr
    81 00000B0E E81EFCFFFF          <1>     call printString
    82                              <1> .skipSystem:
    83                              <1> ;Bad cluster bytes
    84 00000B13 8B0D98040000        <1>     mov ecx, dword [dBadClust]
    85 00000B19 85C9                <1>     test ecx, ecx
    86 00000B1B 741B                <1>     jz .skipBad
    87 00000B1D 4C89C0              <1>     mov rax, r8     ;Get the total cluster count
    88 00000B20 29C8                <1>     sub eax, ecx
    89 00000B22 4C89D1              <1>     mov rcx, r10    ;Get word BytesPerClust
    90 00000B25 F7E1                <1>     mul ecx         ;Get the number of bytes taken by bad clusters
    91 00000B27 E81C010000          <1>     call printDecimalDword
    92 00000B2C 488D15210C0000      <1>     lea rdx, badSectStr
    93 00000B33 E8F9FBFFFF          <1>     call printString
    94                              <1> .skipBad:
    95                              <1> ;Free bytes
    96 00000B38 4C89C8              <1>     mov rax, r9     ;Get free cluster count
    97 00000B3B 4C89D1              <1>     mov rcx, r10    ;Get word BytesPerClust
    98 00000B3E F7E1                <1>     mul ecx         ;Get the number of free bytes
    99 00000B40 E803010000          <1>     call printDecimalDword
   100 00000B45 488D15200C0000      <1>     lea rdx, availableBytesStr
   101 00000B4C E8E0FBFFFF          <1>     call printString
   102                              <1> ;Bytes per cluster
   103 00000B51 4C89D0              <1>     mov rax, r10    ;Get word BytesPerClust
   104 00000B54 E8EF000000          <1>     call printDecimalDword
   105 00000B59 488D15280C0000      <1>     lea rdx, clustSzStr
   106 00000B60 E8CCFBFFFF          <1>     call printString
   107                              <1> ;Number of clusters
   108 00000B65 4C89C0              <1>     mov rax, r8     ;Get the total cluster count
   109 00000B68 E8DB000000          <1>     call printDecimalDword
   110 00000B6D 488D15360C0000      <1>     lea rdx, totClusStr
   111 00000B74 E8B8FBFFFF          <1>     call printString
   112                              <1> ;Vol Serial Number
   113 00000B79 488D15520C0000      <1>     lea rdx, volSerialNumStr
   114 00000B80 E8ACFBFFFF          <1>     call printString
   115 00000B85 488D3521040000      <1>     lea rsi, qword [dSerNum]
   116 00000B8C AC                  <1>     lodsb
   117 00000B8D E829000000          <1>     call printHexByte
   118 00000B92 AC                  <1>     lodsb
   119 00000B93 E823000000          <1>     call printHexByte
   120 00000B98 BA2D000000          <1>     mov edx, "-"
   121 00000B9D E887FBFFFF          <1>     call putch
   122 00000BA2 AC                  <1>     lodsb
   123 00000BA3 E813000000          <1>     call printHexByte
   124 00000BA8 AC                  <1>     lodsb
   125 00000BA9 E80D000000          <1>     call printHexByte
   126                              <1> ;We are done so print a new line :)
   127 00000BAE 488D158D0A0000      <1>     lea rdx, crlfStr
   128 00000BB5 E877FBFFFF          <1>     call printString    ;Output a new line!
   129                              <1>     return
    13                              <2> %%_ret:
    14 00000BBA C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   130                              <1> 
   131                              <1> printHexByte:
   132 00000BBB 488D1D1E000000      <1>     lea rbx, .tbl
   133 00000BC2 50                  <1>     push rax
   134 00000BC3 C1E804              <1>     shr eax, 4  ;Move nybble down
   135 00000BC6 E807000000          <1>     call .phn
   136 00000BCB 58                  <1>     pop rax
   137 00000BCC E801000000          <1>     call .phn
   138                              <1>     return
    13                              <2> %%_ret:
    14 00000BD1 C3                  <2>  ret
