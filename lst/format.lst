   207                              <1> writeFAT:
   208                              <1> ;This routine cleans the FAT sectors and sets up the signature.
   209                              <1> ;Unlocks the BPB
   210 000004F4 B8FEFFFFFF          <1>     mov eax, ~specFuncBPB    ;Unlock the BPB
   211 000004F9 E854FDFFFF          <1>     call setBpb    ;Finish by syncing the BPB again
   212 000004FE 0F821C0D0000        <1>     jc badFormatExit
   213                              <1> ;Now we create the FAT sectors.
   214                              <1> ;We write both copies one sector at a time interleaving them.
   215 00000504 8B35ED0D0000        <1>     mov esi, dword [fatSize]    ;Get the number of sectors to write, as counter
   216 0000050A E8C6080000          <1>     call cleanBuffer
   217 0000050F 488B3DA10D0000      <1>     mov rdi, qword [pBuffer] ;Point rdi to the head of buffer area
   218 00000516 E859070000          <1>     call writeFATStartSig   ;Write the first two clusters in the map
   219 0000051B B901000000          <1>     mov ecx, 1  ;ecx = Number of sectors to write
   220 00000520 488B3DBC0D0000      <1>     mov rdi, qword [bpbPtr] ;Get the ptr to the BPB
   221 00000527 0FB75703            <1>     movzx edx, word [rdi + bpb.revdSecCnt]  ;Get the first sector past reserved
   222 0000052B 52                  <1>     push rdx
   223 0000052C 56                  <1>     push rsi
   224 0000052D E8EAFCFFFF          <1>     call writeSector
   225 00000532 5E                  <1>     pop rsi
   226 00000533 5A                  <1>     pop rdx
   227 00000534 0F827A0C0000        <1>     jc badFATExit
   228 0000053A 8B05B70D0000        <1>     mov eax, dword [fatSize]
   229 00000540 01C2                <1>     add edx, eax    ;Go to second fat copy
   230 00000542 B901000000          <1>     mov ecx, 1
   231 00000547 50                  <1>     push rax
   232 00000548 52                  <1>     push rdx
   233 00000549 56                  <1>     push rsi
   234 0000054A E8CDFCFFFF          <1>     call writeSector
   235 0000054F 5E                  <1>     pop rsi
   236 00000550 5A                  <1>     pop rdx
   237 00000551 58                  <1>     pop rax
   238 00000552 0F825C0C0000        <1>     jc badFATExit
   239 00000558 488B3D580D0000      <1>     mov rdi, qword [pBuffer]
   240 0000055F 48C70700000000      <1>     mov qword [rdi], 0  ;Overwrite the FAT reserved cluster markers
   241 00000566 C7470800000000      <1>     mov dword [rdi + 8], 0  ;Overwrite potential additional FAT32 data
   242 0000056D FFCE                <1>     dec esi ;Decrement the number of fat sectors left to count
   243                              <1> .fatFillLoop:
   244 0000056F 29C2                <1>     sub edx, eax    ;Come back to the first FAT copy
   245 00000571 FFC2                <1>     inc edx ;Goto next sector
   246 00000573 B901000000          <1>     mov ecx, 1
   247 00000578 52                  <1>     push rdx
   248 00000579 56                  <1>     push rsi
   249 0000057A E89DFCFFFF          <1>     call writeSector
   250 0000057F 5E                  <1>     pop rsi
   251 00000580 5A                  <1>     pop rdx
   252 00000581 0F822D0C0000        <1>     jc badFATExit
   253 00000587 8B056A0D0000        <1>     mov eax, dword [fatSize]
   254 0000058D 01C2                <1>     add edx, eax    ;Go to second fat copy
   255 0000058F B901000000          <1>     mov ecx, 1
   256 00000594 50                  <1>     push rax
   257 00000595 52                  <1>     push rdx
   258 00000596 56                  <1>     push rsi
   259 00000597 E880FCFFFF          <1>     call writeSector
   260 0000059C 5E                  <1>     pop rsi
   261 0000059D 5A                  <1>     pop rdx
   262 0000059E 58                  <1>     pop rax
   263 0000059F 0F820F0C0000        <1>     jc badFATExit
   264 000005A5 FFCE                <1>     dec esi
   265 000005A7 75C6                <1>     jnz .fatFillLoop
