    86                              <1> struc chsParamsBlock
    87 00000000 ??                  <1>     .bSpecFuncs db ?
    88 00000001 ??                  <1>     .bDevType   db ?    ;5 if fixed, 7 otherwise
    89 00000002 ????                <1>     .wDevFlgs   dw ?    ;Only bits 0 and 1 are xmitted/read
    90 00000004 ????                <1>     .wNumCyl    dw ?    ;Num cylinders of media, preserved across calls
    91 00000006 ??                  <1>     .bMedTyp    db ?    ;Perma 0 for us, meaningless. Reserved.
    92 00000007 <res 35h>           <1>     .deviceBPB  db 53 dup (?)   ;Full length with reserved bytes of BPB32
    93                              <1>     .TrackLayout:
    94                              <1> endstruc
    95                              <1> specFuncBPB equ 1<<0    ;In set, locks the BPB. In get, rets backup bpb
    96                              <1> ;In setBpb, set if we want to lock bpb. clear to unlock
    97                              <1> ;Below only used in setparams requests. Ignored for getparams 
    98                              <1> specFuncTrk equ 1<<1    ;Set if just track layout cpy. Clear if set all.
    99                              <1> specFuncSec equ 1<<2    ;Set if all sectors same size. Clear if not.
   100                              <1> ;Necessary DevFlgs
   101                              <1> devFixed    equ 1       ;Set if fixed disk 
   102                              <1> 
