     1                              <1> ;IOCTL request header
     2 000007C0 000000000000000000- <1> reqTable    db genioctlGetParamsTable_size dup (0)
     2 000007C9 000000000000000000- <1>
     2 000007D2 000000000000        <1>
     3                              <1> 
     4                              <1> ;Data area here
     5 000007D8 FF                  <1> fmtDrive    db -1       ;Drive we are operating on (0 based)
     6 000007D9 00                  <1> inCrit      db 0        ;If not 0, in a critical section, must exit
     7 000007DA 0000000000000000    <1> cdsPtr      dq 0        ;CDS ptr here
     8 000007E2 0000000000000000    <1> dosBuffPtr  dq 0        ;Ptr to the DOS buffer chain
     9 000007EA 0000000000000000    <1> bufferArea  dq 0        ;Ptr to the buffer area
    10                              <1> ;Format Data here
    11 000007F2 00                  <1> remDev      db 0        ;0 = Removable, -1 = Fixed
    12 000007F3 FF                  <1> fatType     db -1       ;0 = FAT12, 1 = FAT16, 2 = FAT32, -1 = No FAT
    13 000007F4 0000                <1> sectorSize  dw 0        ;Sector size in bytes
    14 000007F6 0000000000000000    <1> numSectors  dq 0        ;Number of sectors in volume
    15 000007FE 00                  <1> secPerClust db 0        ;Copy the sectors per cluster over
    16 000007FF 00000000            <1> fatSize     dd 0        ;FAT size (number of sectors per FAT)
    17 00000803 00                  <1> media       db 0        ;Media type (F0h or F8h)
    18 00000804 0000000000000000    <1> bpbPointer  dq 0        ;Pointer to the BPB we will use
    19 0000080C 00                  <1> bpbSize     db 0        ;Size of the BPB
    20 0000080D 00000000            <1> hiddSector  dd 0        ;Only used for Fixed Disks, offset to add
    21                              <1> 
    22 00000811 0000000000000000    <1> loaderPtr   dq 0        ;Point to the bootloader to use
    23 00000819 0000                <1> loaderBytes dw 0        ;Number of bytes to copy
    24                              <1> 
    25 0000081B 00000000            <1> f32RootClus dd 0        ;Cluster addr of the root dir cluster if FAT32
    26                              <1> ;Tables
    27                              <1> ;Each row is 5 bytes, {DWORD, BYTE} with DWORD = diskSize, BYTE=secPerClusVal
    28                              <1> ;This table assumes a 512 byte sector (fair assumption) but we do a byte size
    29                              <1> ; comparison in format to eventually allow for other sized sectors
    30                              <1> fat16ClusterTable:
    31 0000081F 00A04100            <1>     dd 8400*512 ;Disks up to 4.1MB, must use FAT12 with 0.5 K clusters
    32 00000823 01                  <1>     db 1    ;ALL FAT12 uses 1, unless it is a preexisting meddesc type medium
    33 00000824 0050FF00            <1>     dd 32680*512    ; Disk up to 16MB, 1K clusters
    34 00000828 02                  <1>     db 2
    35 00000829 00000008            <1>     dd 262144*512   ; Disk up to 128MB, 2K clusters
    36 0000082D 04                  <1>     db 4
    37 0000082E 00000010            <1>     dd 524288*512   ; Disk up to 256MB, 4K clusters
    38 00000832 08                  <1>     db 8
    39 00000833 00000020            <1>     dd 1048576*512  ; Disk up to 512Mb, 8K clusters
    40 00000837 10                  <1>     db 16
    41                              <1> 
    42                              <1> ;Here DWORD becomes QWORD
    43                              <1> fat32ClusterTable:
    44 00000838 0000000002000000    <1>     dq 16777216*512 ; Disk up to 8GB, 4K clusters
    45 00000840 08                  <1>     db 8        
    46 00000841 0000000004000000    <1>     dq 33554432*512 ; Disk up to 16GB, 8K clusters
    47 00000849 10                  <1>     db 16
    48 0000084A 0000000008000000    <1>     dq 67108864*512 ; Disk up to 32Gb, 16K clusters
    49 00000852 20                  <1>     db 32
    50 00000853 FFFFFFFFFFFFFFFF    <1>     dq -1       ; Disk up to 2TB, 32K clusters
    51 0000085B 40                  <1>     db 64
    52                              <1> 
    53                              <1> ;Static BPBs here, fields set to -1 must be edited.
    54                              <1> ;Fields with a preset value should NOT be touched.
    55                              <1> genericBPB12:
    56                              <1>     istruc bpb
    57 0000085C EB4690              <1>     at bpb.jmpBoot,     db 0EBh, 46h, 90h   ;Jump forward by 46h bytes
    58 0000085F 534350444F537631    <1>     at bpb.oemName,     db 'SCPDOSv1'
    59 00000867 FFFF                <1>     at bpb.bytsPerSec,  dw -1           ;512 bytes per sector, normally
    60 00000869 FF                  <1>     at bpb.secPerClus,  db -1           ;1 sector per cluster, normally
    61 0000086A 0100                <1>     at bpb.revdSecCnt,  dw 0001h        ;1 Reserved Sector
    62 0000086C 02                  <1>     at bpb.numFATs,     db 02h          ;2 FAT tables
    63 0000086D E000                <1>     at bpb.rootEntCnt,  dw 00E0h        ;224 root entries
    64 0000086F FFFF                <1>     at bpb.totSec16,    dw -1           ;Total number of sectors on disk
    65 00000871 F0                  <1>     at bpb.media,       db 0F0h         ;Media byte
    66 00000872 FFFF                <1>     at bpb.FATsz16,     dw -1           ;9 FAT sectors, normally
    67 00000874 1200                <1>     at bpb.secPerTrk,   dw 0012h        ;18 Sectors per track
    68 00000876 0200                <1>     at bpb.numHeads,    dw 0002h        ;2 Heads
    69 00000878 FFFFFFFF            <1>     at bpb.hiddSec,     dd -1           ;No hidden sectors on removable
    70 0000087C 00000000            <1>     at bpb.totSec32,    dd 0            ;Not a FAT32 BPB
