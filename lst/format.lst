   104 00000000 ????                <1>     .wArraySz   dw ?    ;Number of entries in the array
   105                              <1>     .sTrackArray:       ;An array of the below struc
   106                              <1> endstruc
   107                              <1> 
   108                              <1> struc trackTableRow
   109 00000000 ????                <1>     .wSectorId  dw ?    ;Sector number (1 - Max id in track)
   110 00000002 ????                <1>     .wSectorSz  dw ?    ;Given as a byte count (i.e. 512 for 512 bytes)
   111                              <1> endstruc
