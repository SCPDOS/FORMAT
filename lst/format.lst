    61                                  %include "./dat/fmtData.asm"
     1                              <1> ;IOCTL request header
     2                              <1> ;Data area here
     3 000009E0 FF                  <1> fmtDrive    db -1       ;Drive we are operating on (0 based)
     4 000009E1 00                  <1> inCrit      db 0        ;If not 0, in a critical section, must exit
     5 000009E2 0000000000000000    <1> cdsPtr      dq 0        ;CDS ptr here
     6 000009EA 0000000000000000    <1> bufferArea  dq 0        ;Ptr to the buffer area
     7                              <1> ;HARDCODED TO BE QUICK FORMAT FOR NOW
     8 000009F2 FF                  <1> quickByte   db -1       ;If /Q, don't zero all sectors first. Set if /Q.
     9                              <1> ;Format Data here
    10 000009F3 00                  <1> remDev      db 0        ;0 = Removable, -1 = Fixed
    11 000009F4 FF                  <1> fatType     db -1       ;0 = FAT12, 1 = FAT16, 2 = FAT32, -1 = No FAT
    12 000009F5 0000                <1> sectorSize  dw 0        ;Sector size in bytes
    13 000009F7 0000000000000000    <1> numSectors  dq 0        ;Number of sectors in volume
    14 000009FF 00                  <1> secPerClust db 0        ;Copy the sectors per cluster over
    15 00000A00 00000000            <1> fatSize     dd 0        ;FAT size (number of sectors per FAT)
    16 00000A04 F0                  <1> media       db 0F0h     ;Media type (F0h or F8h)
    17 00000A05 0000000000000000    <1> bpbPointer  dq 0        ;Pointer to the buffer for the BPB
    18 00000A0D 00                  <1> bpbSize     db 0        ;Size of the BPB
    19 00000A0E 00000000            <1> hiddSector  dd 0        ;Only used for Fixed Disks, offset to add
    20                              <1> 
    21 00000A12 0000000000000000    <1> loaderPtr   dq 0        ;Point to the bootloader to use
    22                              <1> 
    23 00000A1A 00000000            <1> f32RootClus dd 0        ;Cluster addr of the root dir cluster if FAT32
    24                              <1> 
    25                              <1> ;Tracking vars, used only for updating the percentage message!
    26 00000A1E 0000000000000000    <1> secToWrite  dq 0        ;Number of sectors to write (neq numSectors if /Q set)
    27 00000A26 0000000000000000    <1> secWritten  dq 0        ;Number of sectors written so far
