   662                              <1> computeFATSize:
   663                              <1> ; ;Works on the genericBPB in memory. Applies the following algorithm
   664                              <1> ; RootDirSectors = ((BPB_RootEntCnt * 32) + (BPB_BytsPerSec – 1)) / BPB_BytsPerSec;
   665                              <1> ; TmpVal1 = DskSize – (BPB_ResvdSecCnt + RootDirSectors);
   666                              <1> ; TmpVal2 = (256 * BPB_SecPerClus) + BPB_NumFATs;
   667                              <1> ; If(FATType == FAT32)
   668                              <1> ;   TmpVal2 = TmpVal2 / 2;
   669                              <1> ; FATSz = (TMPVal1 + (TmpVal2 – 1)) / TmpVal2;
   670                              <1> ;Input:
   671                              <1> ;   rdi = Pointer to the head of the BPB we are using
   672                              <1> ;Returns: 
   673                              <1> ;   eax = Number of sectors per FAT needed. Low word only valid for FAT12/16
   674 000007EB 53                  <1>     push rbx
   675 000007EC 51                  <1>     push rcx
   676 000007ED 52                  <1>     push rdx
   677 000007EE 57                  <1>     push rdi
   678                              <1>     
   679 000007EF 0FB74706            <1>     movzx eax, word [rdi + bpb.rootEntCnt]
   680 000007F3 C1E005              <1>     shl eax, 5  ;Multiply by 32
   681 000007F6 0FB71F              <1>     movzx ebx, word [rdi + bpb.bytsPerSec]
   682 000007F9 FFCB                <1>     dec ebx
   683 000007FB 01D8                <1>     add eax, ebx
   684 000007FD FFC3                <1>     inc ebx
   685 000007FF 31D2                <1>     xor edx, edx
   686 00000801 F7F3                <1>     div ebx
   687 00000803 89C2                <1>     mov edx, eax    ;edx = RootDirSectors
   688                              <1> 
   689 00000805 0FB74708            <1>     movzx eax, word [rdi + bpb.totSec16]
   690 00000809 8B5F15              <1>     mov ebx, dword [rdi + bpb.totSec32]
   691 0000080C 85C0                <1>     test eax, eax   ;If totSec16 is 0, move totSec32 into eax
   692 0000080E 0F44C3              <1>     cmovz eax, ebx
   693 00000811 0FB75F03            <1>     movzx ebx, word [rdi + bpb.revdSecCnt]
   694 00000815 01D3                <1>     add ebx, edx    ;Add RootDirSectors
   695 00000817 29D8                <1>     sub eax, ebx
   696 00000819 89C1                <1>     mov ecx, eax    ;ecx = TmpVal1
   697                              <1> 
   698 0000081B 0FB64702            <1>     movzx eax, byte [rdi + bpb.secPerClus]
   699 0000081F C1E008              <1>     shl eax, 8  ;multiply by 256
   700 00000822 0FB65F05            <1>     movzx ebx, byte [rdi + bpb.numFATs]
   701 00000826 01C3                <1>     add ebx, eax    ;ebx = TmpVal2
   702                              <1> 
   703 00000828 803D3202000002      <1>     cmp byte [fatType], 2
   704 0000082F 7502                <1>     jne .notFat32
   705 00000831 D1EB                <1>     shr ebx, 1  ;Divide by 2
   706                              <1> .notFat32: 
   707 00000833 89C8                <1>     mov eax, ecx    ;TmpVal1
   708 00000835 FFCB                <1>     dec ebx
   709 00000837 01D8                <1>     add eax, ebx    ;TmpVal1 + (TmpVal2 - 1)
   710 00000839 FFC3                <1>     inc ebx
   711 0000083B 31D2                <1>     xor edx, edx
   712 0000083D F7F3                <1>     div ebx ;Exit with eax = number of sectors needed per FAT
   713                              <1> .exit:
   714 0000083F 5F                  <1>     pop rdi
   715 00000840 5A                  <1>     pop rdx
   716 00000841 59                  <1>     pop rcx
   717 00000842 5B                  <1>     pop rbx
   718                              <1>     return
    13                              <2> %%_ret:
    14 00000843 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
