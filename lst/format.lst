   868 0000096D 488B1D76000000      <1>     mov rbx, qword [bufferArea] ; Memory Buffer address to read from
   869 00000974 CD25                <1>     int 25h
   870 00000976 58                  <1>     pop rax ;Pop old flags into rax
   871                              <1>     return
