   131                              <1>     dirSystem       equ 04h
   132                              <1>     dirVolumeID     equ 08h
   133                              <1>     dirDirectory    equ 10h
   134                              <1>     dirArchive      equ 20h
   135                              <1>     dirCharDev      equ 40h ;Never written to disk, used to represent a Char Dev
   136                              <1>     dirLongName     equ dirReadOnly | dirHidden | dirSystem | dirVolumeID
   137                              <1>     ;If any of the three bits are set, then ALL three bits are set
   138                              <1>     ; in addition to whatever the user passed to search for.
   139                              <1>     dirInclusive    equ dirHidden | dirSystem | dirDirectory
   140                              <1>     dirIncFiles     equ dirHidden | dirSystem
   141                              <1> 
   142                              <1> struc bpbEx   ;exFAT BPB, SIZE: 120 bytes
   143                              <1> 
   144                              <1>     ;.jmpBoot                db 3 dup (?)
   145                              <1>     ;.oemName                db 8 dup (?)  ;OEM name
   146                              <1> ;BPB starts here
   147 00000000 <res 35h>           <1>     .MustBeZero             db 53 dup (?) ;Must be 0, 53 bytes
   148 00000035 ????????????????    <1>     .partitionOffset        dq ?  ;in sectors, 0 means ignore this field
   149 0000003D ????????????????    <1>     .volumeLength           dq ?  ;Volume Length in sectors
   150 00000045 ????????            <1>     .FAToffset              dd ?  ;Volume rel offset of first FAT, in sectors
   151 00000049 ????????            <1>     .FATlength              dd ?  ;FAT length, in sectors
   152 0000004D ????????            <1>     .clusterHeapOffset      dd ?  ;Start of data area, in sectors
   153 00000051 ????????            <1>     .clusterCount           dd ?  ;Number of clusters on medium
   154 00000055 ????????            <1>     .firstClusterOfRootDir  dd ?  ;First Cluster of Root Directory, min 2
   155 00000059 ????????            <1>     .volumeSerialNum        dd ?  ;Volume Serial Number
   156 0000005D ????                <1>     .FSrevision             dw ?  ;Should be 0001 (v1.00)
   157 0000005F ????                <1>     .volumeFlags            dw ?  ;Volume Flags, refer to documentation
   158 00000061 ??                  <1>     .bytesPerSectorShift    db ?  ;min 9 (512 bps), max 12 (4096 bps)
   159 00000062 ??                  <1>     .sectorsPerClusterShift db ?  ;Result of log_2(N) for N=sec per clus
   160 00000063 ??                  <1>     .numberOfFATs           db ?  ;Number of FATs, only 1 or 2
   161 00000064 ??                  <1>     .driveSelect            db ?  ;Drive Select, 0 or 80h (Int 13h)
   162 00000065 ??                  <1>     .percentInUse           db ?  ;Rounded down. FFh means unknown
   163 00000066 ??????????????      <1>     .reserved               db 7 dup (?)  ;Reserved for alignment
   164                              <1> 
   165                              <1> endstruc
    45                                  %include "./inc/dosError.inc"
     1                              <1> ;DOS Error codes
     2                              <1> ;Where new codes are needed, we base them on Windows error codes
     3                              <1> ;----------------------------------------------
     4                              <1> ;             Extended Error Codes
     5                              <1> ;----------------------------------------------
     6                              <1> errInvFnc   equ 1   ;Invalid function number
     7                              <1> errFnf      equ 2   ;File not found
     8                              <1> errPnf      equ 3   ;Path not found
     9                              <1> errNhl      equ 4   ;Too many open handles, no handles left
    10                              <1> errAccDen   equ 5   ;Access denied (to resource)
    11                              <1> errBadHdl   equ 6   ;Invalid handle
    12                              <1> errMCBbad   equ 7   ;MCB's destroyed
    13                              <1> errNoMem    equ 8   ;Insufficient memory
    14                              <1> errMemAddr  equ 9   ;Invalid Memory Block Address
    15                              <1> errBadEnv   equ 10  ;Invalid environment
    16                              <1> errBadFmt   equ 11  ;Invalid format (path etc)
    17                              <1> errAccCde   equ 12  ;Invalid Access Code (bad file share mode or attribute)
    18                              <1> errInvDat   equ 13  ;Invalid data
    19                              <1> ;           equ 14  ;Reserved
    20                              <1> errBadDrv   equ 15  ;Invalid drive specified
    21                              <1> errDelCD    equ 16  ;Attempt to delete the current directory
    22                              <1> errDevUnk   equ 17  ;Not the same device (Device Unknown)
    23                              <1> errNoFil    equ 18  ;No more files, no match found
    24                              <1> ;The following are Driver error codes + 19
    25                              <1> drvErrShft  equ 19  ;Used to shift Driver error codes to extended error codes
    26                              <1> errWpd      equ 19  ;Attempt to write on write protected disk
    27                              <1> errUnkUnt   equ 20  ;Unknown Unit
    28                              <1> errDrvNR    equ 21  ;Drive not ready
    29                              <1> errUnkCmd   equ 22  ;Unknown Command
    30                              <1> errCRCerr   equ 23  ;Data (CRC) error
    31                              <1> errBadRLn   equ 24  ;Bad request structure length
    32                              <1> errSekErr   equ 25  ;Seek error
    33                              <1> errUnkMed   equ 26  ;Unknown media type
    34                              <1> errSecNF    equ 27  ;Sector not Found
    35                              <1> errNoPap    equ 28  ;Printer out of paper
    36                              <1> errWF       equ 29  ;Write fault
    37                              <1> errRF       equ 30  ;Read fault
    38                              <1> errGF       equ 31  ;General fault
    39                              <1> ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    40                              <1> ;The following two go inbetween the reserved disk errors
    41                              <1> errShrVio   equ 32  ;Sharing violations
    42                              <1> errLokVio   equ 33  ;File Lock violation
    43                              <1> ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    44                              <1> errIDC      equ 34  ;Driver code, Invalid Disk Change, settable by share
    45                              <1> errNoFCB    equ 35  ;FCB unavailable
    46                              <1> errShrFul   equ 36  ;Sharing buffer full
    47                              <1> ;The next two errors occur because an redir handle has the bit set to do this.
    48                              <1> ;We do not move the SFT in either case so that one can safely examine the
    49                              <1> ; state of the system before the call was made. In the second case,
    50                              <1> ; the user should do a 0 byte write at filesize before anything else to truncate
    51                              <1> ; any pre-allocated clusters.
    52                              <1> errHdlEOF   equ 38  ;Handle will EOF if read proceeds or at EOF. 
    53                              <1> errDskFul   equ 39  ;Disk will fill up if write proceeds or full. 
    54                              <1> ;----------------------------------------------
    55                              <1> ;             Network error codes
    56                              <1> ;----------------------------------------------
    57                              <1> errNetGeneric       equ 50  ;Network request not supported, generic net fail
    58                              <1> errNetRemNotList    equ 51  ;Cannot find the network path
    59                              <1> errNetDupName       equ 52  ;Duplicate name exists on the network
    60                              <1> errNetBadNetpath    equ 53  ;Network path not found
    61                              <1> errNetBusy          equ 54  ;Network is busy
    62                              <1> errNetDevNoExist    equ 55  ;Specified net resource or dev not available
    63                              <1> errNetBIOSCmdLimit  equ 56  ;Net BIOS command limit reached
    64                              <1> errNetAdapHdwErr    equ 57  ;Network adapter hardware error
    65                              <1> errNetBadResp       equ 58  ;Server cannot perform requested operation
    66                              <1> errNetUnexp         equ 59  ;Unexpected Network error
    67                              <1> errNetBadAdap       equ 60  ;Bad remote network adapter
    68                              <1> errPrintQueueFull   equ 61  ;Printer queue is full
    69                              <1> errNoSpool          equ 62  ;No space to store file to be printed on print srv
    70                              <1> errPrintAbort       equ 63  ;File waiting to be printed was deleted
    71                              <1> errNetNameDel       equ 64  ;Network name is no longer available
    72                              <1> errNetAccDen        equ 65  ;Network Access denied
    73                              <1> errNetBadDevType    equ 66  ;Network resource type is not correct
    74                              <1> errNetBadNetName    equ 67  ;The network name cannot be found
    75                              <1> errNetTooManyNames  equ 68  ;Name limit for local network card exceeded 
    76                              <1> errNetTooManySess   equ 69  ;The Network (NETBIOS) session limit was exceeded
    77                              <1> errNetSharingPaused equ 70  ;Remote server is paused
    78                              <1> errNetReqNotAccep   equ 71  ;Remote computer too busy to accept connections
    79                              <1> errNetRedirPaused   equ 72  ;Specified redir device has been paused
    80                              <1> ;----------------------------------------------
    81                              <1> ;         Extended error codes level 2
    82                              <1> ;----------------------------------------------
    83                              <1> errFilExist equ 80  ;File already exists
    84                              <1> errDirExist equ 82  ;Directory already exists
    85                              <1> errFI24     equ 83  ;Fail on Int 24h
    86                              <1> errRedir    equ 84  ;Too many levels of redirection
    87                              <1> errDupRedir equ 85  ;Trying to redirect a redirection
    88                              <1> errBadPass  equ 86  ;Bad password
    89                              <1> errBadParam equ 87  ;Bad parameter passed to request
    90                              <1> errNetWrite equ 88  ;Network Write Fault
    91                              <1> errEnvVarNotFnd equ 203 ;Environment variable doesn't exist
    92                              <1> ;-----------------------------------------------------------------------------
    93                              <1> ;Error Loci
    94                              <1> eLocUnk     equ 1   ;Unknown locus, nonspecific or not appropriate
    95                              <1> eLocDsk     equ 2   ;Disk, related to Random Access to a disk or block device
    96                              <1> eLocNet     equ 3   ;Network related issues
    97                              <1> eLocChr     equ 4   ;Serial/Character Device error
    98                              <1> eLocMem     equ 5   ;Related to RAM
    99                              <1> ;-----------------------------------------------------------------------------
   100                              <1> ;Error Actions
   101                              <1> eActRet     equ 1   ;Retry
   102                              <1> eActDRet    equ 2   ;Delay then retry (Try again later)
   103                              <1> eActUsr     equ 3   ;Ask user to re-input data, i.e. bad filename or something
   104                              <1> eActAbt     equ 4   ;Abort with cleanup
   105                              <1> eActKil     equ 5   ;Abort without cleanup
   106                              <1> eActIgn     equ 6   ;Ignore error
   107                              <1> eActRetUsr  equ 7   ;Retry after user intervention (i.e swap remdev)
   108                              <1> ;-----------------------------------------------------------------------------
   109                              <1> ;Error Classes
   110                              <1> eClsOoR     equ 1   ;Out of resources, no mem or handles
   111                              <1> eClsTS      equ 2   ;Temp sitch, should go away
   112                              <1> eClsAuth    equ 3   ;Authorisation, e.g. file permission error 
   113                              <1> eClsInt     equ 4   ;Internal DOS error or bug
   114                              <1> eClsHrdFlt  equ 5   ;Hardware Failure
   115                              <1> eClsSysFlt  equ 6   ;System Failure, i.e. missing or bad cfg files
   116                              <1> eClsAppFlt  equ 7   ;Application Program error, inconsistent requests etc...
   117                              <1> eClsNotFnd  equ 8   ;Resource not found (such as free SFT entry etc...)
   118                              <1> eClsBadFmt  equ 9   ;Bad format for resource
   119                              <1> eClsLocked  equ 10  ;Resource Locked
   120                              <1> eClsMedia   equ 11  ;Error is on medium, i.e. wrong or damaged remdev
   121                              <1> eClsClash   equ 12  ;Resource already exists!
   122                              <1> eClsUnk     equ 13  ;Unknown class
    46                                  %include "./inc/fmtMisc.inc"
     1                              <1> ;Misc equates and strucs go here :)
     2                              <1> 
     3                              <1> 
     4                              <1> ;Default behaviour is to always zero all data sectors of the disk as well. 
     5                              <1> ; This is done to also pick up bad clusters to mark them as bad in the FAT.
     6                              <1> bitQuick    equ 1   ;/Q -> Do quick format, no zeroing. No bad sect. checks.
     7                              <1> bitSystem   equ 2   ;/S -> Install system files. 
     8                              <1> ;Checks: current drive:\currentdir, A:\ [copies whole files into memory]
     9                              <1> bitVolume   equ 4   ;/V:[LABEL] -> Don't prompt volume, use LABEL directly.
    10                              <1> bitBadChck  equ 8   ;/C -> Checks if bad clusters are still bad. 
    11                              <1> ; If this is specified, doesn't format the disk.
    12                              <1> ;Next three hold only on remdevs. If these bits set on fixed disk, bad parm!
    13                              <1> ;-----------------------------------v
    14                              <1> bitSec      equ 10  ;/N:<Sectors>.  | These two must both be set, else
    15                              <1> bitTrk      equ 20  ;/T:<Tracks>.   |  bad parameter! Suppose double sided
    16                              <1> ;-----------------------------------^
    17                              <1> bitFloppy   equ 40  ;/F:<size> -> Specify the size of volume. 
    18                              <1> ;Options are: 160, 180, 320, 360, 720, 1.2, 1.44, 2.88 (written as strings)
    19                              <1> ;Either /F Floppy is set or {/N /T}. Not both!
    20                              <1> ;bitClean    equ 80  ;/P:<count> -> Overwrite each sector ``count'' times
    21                              <1> ; with random numbers. If /P:0 specified, then clean once with 0's.
    22                              <1> ;/Q trumps /P and if both specified, /Q is accepted.
    23                              <1> 
    24                              <1> ;Return values from FORMAT
    25                              <1> retOk   equ 0   ;Return all ok!
    26                              <1> retParm equ 1   ;Return bad parameters were selected
    27                              <1> retCtrC equ 3   ;Return on Crtl+C
    28                              <1> retErr  equ 4   ;Return generic error 
    29                              <1> retNo   equ 5   ;Return user selected no on a Y/N question
    30                              <1> retDNR  equ 6   ;Return Drive not ready
    31                              <1> retWP   equ 7   ;Return write protected
    32                              <1> 
    33                              <1> ;Some FORMAT specific equates
    34                              <1> fs_fat12 equ 0
    35                              <1> fs_fat16 equ 1
    36                              <1> fs_fat32 equ 2
    37                              <1> 
