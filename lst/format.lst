    12 00000F95 202020              <1>
    13 00000F98 0000                <1> wGivenTrks  dw 0        ;Tracks per side (1 head as remdev)
    14 00000F9A 00                  <1> bGivenSPT   db 0        ;Sectors per track
    15 00000F9B 00                  <1> bGivenSz    db 0        ;This is an offset into the BPB table if /F set
    16                              <1> 
    17                              <1> ;Format Data here
