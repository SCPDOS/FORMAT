   284                              <1> prepPrintVals:
   285                              <1> ;Compute secToWrite and initialise secWritten and secPercent.
   286 00000D15 31C0                <1>     xor eax, eax
   287 00000D17 488905B1020000      <1>     mov qword [secWritten], rax   ;Initialised for when multiple formats
   288 00000D1E C605B2020000FF      <1>     mov byte [secPercent], -1
   289 00000D25 F6055402000001      <1>     test byte [bFlag1], bitQuick  ;If quick set, won't process rest of disk.
   290 00000D2C 750F                <1>     jnz .quick
   291 00000D2E 488B056B020000      <1>     mov rax, qword [numSectors]
   292 00000D35 4889058B020000      <1>     mov qword [secToWrite], rax
