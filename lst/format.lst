    62                                  %include "./dat/fmtData.asm"
     1                              <1> ;IOCTL request header
     2                              <1> ;Data area here
     3 00000AD2 FF                  <1> fmtDrive    db -1       ;Drive we are operating on (0 based)
     4 00000AD3 00                  <1> inCrit      db 0        ;If not 0, in a critical section, must exit
     5 00000AD4 0000000000000000    <1> cdsPtr      dq 0        ;CDS ptr here
     6 00000ADC 0000000000000000    <1> bufferArea  dq 0        ;Ptr to the buffer area
     7                              <1> ;HARDCODED TO BE QUICK FORMAT FOR NOW
     8 00000AE4 FF                  <1> quickByte   db -1       ;If /Q, don't zero all sectors first. Set if /Q.
     9                              <1> ;Format Data here
    10 00000AE5 00                  <1> remDev      db 0        ;0 = Removable, -1 = Fixed
    11 00000AE6 FF                  <1> fatType     db -1       ;0 = FAT12, 1 = FAT16, 2 = FAT32, -1 = No FAT
    12 00000AE7 0000                <1> sectorSize  dw 0        ;Sector size in bytes
    13 00000AE9 0000000000000000    <1> numSectors  dq 0        ;Number of sectors in volume
    14 00000AF1 00                  <1> secPerClust db 0        ;Copy the sectors per cluster over
    15 00000AF2 00000000            <1> fatSize     dd 0        ;FAT size (number of sectors per FAT)
    16 00000AF6 F0                  <1> media       db 0F0h     ;Media type (F0h or F8h)
    17 00000AF7 0000000000000000    <1> bpbPtr      dq 0        ;Pointer to the buffer for the BPB (in IOCTL block)
    18 00000AFF 00                  <1> bpbSize     db 0        ;Size of the BPB
    19 00000B00 00000000            <1> hiddSector  dd 0        ;Only used for Fixed Disks, offset to add
    20                              <1> 
    21 00000B04 0000000000000000    <1> loaderPtr   dq 0        ;Point to the bootloader to use
    22                              <1> 
    23 00000B0C 00000000            <1> f32RootClus dd 0        ;Cluster addr of the root dir cluster if FAT32
    24                              <1> 
    25                              <1> ;Tracking vars, used only for updating the percentage message!
    26 00000B10 0000000000000000    <1> secToWrite  dq 0        ;Number of sectors to write (neq numSectors if /Q set)
    27 00000B18 0000000000000000    <1> secWritten  dq 0        ;Number of sectors written so far
    28 00000B20 FF                  <1> secPercent  db -1       ;The previous percentage (-1 not initialised)
    29                              <1> 
    30                              <1> ;Tables
    31                              <1> ;All data here is RO.
    32                              <1> ;Each row is 5 bytes, {DWORD, BYTE} with DWORD = diskSize, BYTE=secPerClusVal
    33                              <1> ;This table assumes a 512 byte sector (fair assumption) but we do a byte size
    34                              <1> ; comparison in format to eventually allow for other sized sectors
    35                              <1> fat16ClusterTable:
    36 00000B21 00A04100            <1>     dd 8400*512 ;Disks up to 4.1MB, must use FAT12 with 0.5 K clusters
    37 00000B25 01                  <1>     db 1    ;ALL FAT12 uses 1, unless it is a preexisting meddesc type medium
    38 00000B26 0050FF00            <1>     dd 32680*512    ; Disk up to 16MB, 1K clusters
    39 00000B2A 02                  <1>     db 2
    40 00000B2B 00000008            <1>     dd 262144*512   ; Disk up to 128MB, 2K clusters
    41 00000B2F 04                  <1>     db 4
    42 00000B30 00000010            <1>     dd 524288*512   ; Disk up to 256MB, 4K clusters
    43 00000B34 08                  <1>     db 8
    44 00000B35 00000020            <1>     dd 1048576*512  ; Disk up to 512Mb, 8K clusters
    45 00000B39 10                  <1>     db 16
    46                              <1> 
    47                              <1> ;Here DWORD becomes QWORD
    48                              <1> fat32ClusterTable:
    49 00000B3A 0000000002000000    <1>     dq 16777216*512 ; Disk up to 8GB, 4K clusters
    50 00000B42 08                  <1>     db 8        
    51 00000B43 0000000004000000    <1>     dq 33554432*512 ; Disk up to 16GB, 8K clusters
    52 00000B4B 10                  <1>     db 16
    53 00000B4C 0000000008000000    <1>     dq 67108864*512 ; Disk up to 32Gb, 16K clusters
    54 00000B54 20                  <1>     db 32
    55 00000B55 FFFFFFFFFFFFFFFF    <1>     dq -1       ; Disk up to 2TB, 32K clusters
    56 00000B5D 40                  <1>     db 64
    57                              <1> 
    58                              <1> ;Bpbs are for remdevs of 1.44Mb and 2.88Mb capacity.
    59                              <1> ;We have these built-in so that if (when supported) /F:1.44 or /F:2.88
    60                              <1> ; is selected, we can format to these standard values. 
    61                              <1> ;bpb144Mb:
    62                              <1> ;    istruc bpb
    63                              <1> ;    at .bytsPerSec, dw 200h
    64                              <1> ;    at .secPerClus, db 01h
    65                              <1> ;    at .revdSecCnt, dw 0001h
    66                              <1> ;    at .numFATs,    db 02h    
    67                              <1> ;    at .rootEntCnt, dw 00E0h    
    68                              <1> ;    at .totSec16,   dw 0B40h    
    69                              <1> ;    at .media,      db 0F0h    
    70                              <1> ;    at .FATsz16,    dw 0009h    
    71                              <1> ;    at .secPerTrk,  dw 0012h    
    72                              <1> ;    at .numHeads,   dw 0002h    
    73                              <1> ;    at .hiddSec,    dd 0    
    74                              <1> ;    at .totSec32,   dd 0     
    75                              <1> ;    iend
    76                              <1> ;bpb288Mb:
    77                              <1> ;    istruc bpb
    78                              <1> ;    at .bytsPerSec, dw 200h
    79                              <1> ;    at .secPerClus, db 02h  ;To be FAT 12 OK, we need 2 sectors/clust
    80                              <1> ;    at .revdSecCnt, dw 0001h
    81                              <1> ;    at .numFATs,    db 02h
    82                              <1> ;    at .rootEntCnt, dw 00E0h
    83                              <1> ;    at .totSec16,   dw 1680h
    84                              <1> ;    at .media,      db 0F0h
    85                              <1> ;    at .FATsz16,    dw 0012h
    86                              <1> ;    at .secPerTrk,  dw 0024h    
    87                              <1> ;    at .numHeads,   dw 0002h    
    88                              <1> ;    at .hiddSec,    dd 0    
    89                              <1> ;    at .totSec32,   dd 0     
    90                              <1> ;    iend
    91                              <1> 
    92                              <1> ;Generic BPBs here, fields set to -1 must be edited in the copy made.
    93                              <1> genericBPB12:
    94                              <1>     istruc bpb
    95 00000B5E FFFF                <1>     at .bytsPerSec,  dw -1           ;512 bytes per sector, normally
    96 00000B60 FF                  <1>     at .secPerClus,  db -1           ;1 sector per cluster, normally
    97 00000B61 0100                <1>     at .revdSecCnt,  dw 0001h        ;1 Reserved Sector
    98 00000B63 02                  <1>     at .numFATs,     db 02h          ;2 FAT tables
    99 00000B64 E000                <1>     at .rootEntCnt,  dw 00E0h        ;224 root entries
   100 00000B66 FFFF                <1>     at .totSec16,    dw -1           ;Total number of sectors on disk
   101 00000B68 F0                  <1>     at .media,       db 0F0h         ;Media byte
   102 00000B69 FFFF                <1>     at .FATsz16,     dw -1           ;9 FAT sectors, normally
   103 00000B6B 1200                <1>     at .secPerTrk,   dw 0012h        ;18 Sectors per track
   104 00000B6D 0200                <1>     at .numHeads,    dw 0002h        ;2 Heads
   105 00000B6F FFFFFFFF            <1>     at .hiddSec,     dd -1           ;No hidden sectors on removable
   106 00000B73 00000000            <1>     at .totSec32,    dd 0            ;Not a FAT32 BPB
   107                              <1>     iend
   108                              <1>     istruc extBs 
   109 00000B77 FF                  <1>     at .drvNum,         db -1   ;Set to 0 for Remdev, 80h for fixed disk
   110 00000B78 00                  <1>     at .reserved1,      db 00h
   111 00000B79 29                  <1>     at .bootSig,        db extBsSig ;Normal signature
   112 00000B7A FFFFFFFF            <1>     at .volId,          dd -1       ;Set to date/time @ format
   113 00000B7E 4E4F204E414D452020- <1>     at .volLab,         db 'NO NAME    '    
   113 00000B87 2020                <1>
   114 00000B89 4641543132202020    <1>     at .filSysType,     db 'FAT12   '
   115                              <1>     iend
   116                              <1> 
   117                              <1> 
   118                              <1> genericBPB16:
   119                              <1>     istruc bpb
   120 00000B91 FFFF                <1>     at .bytsPerSec,  dw -1           ;512 bytes per sector, normally
   121 00000B93 FF                  <1>     at .secPerClus,  db -1           ;Sectors per cluster
   122 00000B94 0100                <1>     at .revdSecCnt,  dw 0001h        ;1 Reserved Sector
   123 00000B96 02                  <1>     at .numFATs,     db 02h          ;2 FAT tables
   124 00000B97 0002                <1>     at .rootEntCnt,  dw 0200h        ;512 root entries
   125 00000B99 FFFF                <1>     at .totSec16,    dw -1           ;Total number of sectors on disk
   126 00000B9B F0                  <1>     at .media,       db 0F0h         ;Media byte
