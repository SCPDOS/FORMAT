   325 00000D59 488B1DC3020000      <1>     mov rbx, qword [bpbPtr]
   326 00000D60 0FBE430A            <1>     movsx eax, byte [rbx + bpb.media]   ;Get the media byte, sign extend
   327 00000D64 803DA702000001      <1>     cmp byte [fatType], fs_fat16
   328 00000D6B 7407                <1>     je .fat16
   329 00000D6D 7709                <1>     ja .fat32
   330                              <1> ;Fat 12 here
   331 00000D6F 25FFFFFF00          <1>     and eax, 00FFFFFFh  ;Save only low three bytes
   332                              <1> .fat16:
