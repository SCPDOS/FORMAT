   180                              <1> ;;    test byte [bFlag1], ~bitFloppy
   181                              <1> ;;    retz    ;Return if this is the only bit set
   182                              <1> ;Fall through here to save 5 bytes as the next cmp will fail!
   183                              <1> ;.epST:
   184                              <1> ;Here we know that the floppy bit is not set. Ensure both Sec and Trk bits set
   185                              <1> ;;    cmp byte [bFlag1], bitSec | bitTrk
   186                              <1> ;;    rete
   187                              <1> ;;    jmp badParamExit
   188                              <1> 
   189                              <1> ;;parseCheck:
   190                              <1> ;Checks that the flags we have sset make sense for the type of 
   191                              <1> ; device we are formatting.
   192                              <1> ;Input: al = Clear if removable
   193                              <1> ;;       al = Set if fixed
   194                              <1> ;;    test al, al ;All options on rem devs
   195                              <1> ;;    retz
   196                              <1> ;If any of these bits are set, we fail.
   197                              <1> ;;    test byte [bFlag1], bitSec | bitTrk | bitFloppy 
   198                              <1> ;;    retz
   199                              <1> ;;    jmp badParamExit
