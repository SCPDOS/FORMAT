   280                              <1> ucChar:
   281                              <1> ;Input: al = Char to uppercase
   282                              <1> ;Output: al = Adjusted char 
   283                              <1> ;Use normal localised uppercase instead of normal uppercase as
   284                              <1> ; drive letters are in the overlap of normal and filename uc.
   285                              <1> ;This allows for use of this function beyond just drive letter UC-ing
   286                              <1> ; (i.e. for switch chars)
   287 000009D1 52                  <1>     push rdx
   288 000009D2 89C2                <1>     mov edx, eax
   289 000009D4 B820650000          <1>     mov eax, 6520h
   290 000009D9 CD21                <1>     int 21h
   291 000009DB 89D0                <1>     mov eax, edx
   292 000009DD 5A                  <1>     pop rdx
   293                              <1>     return
