   479                              <1> computeFATSize:
   480                              <1> ; ;Works on the genericBPB in memory. Applies the following algorithm
   481                              <1> ; RootDirSectors = ((BPB_RootEntCnt * 32) + (BPB_BytsPerSec – 1)) / BPB_BytsPerSec;
   482                              <1> ; TmpVal1 = DskSize – (BPB_ResvdSecCnt + RootDirSectors);
   483                              <1> ; TmpVal2 = (256 * BPB_SecPerClus) + BPB_NumFATs;
   484                              <1> ; If(FATType == FAT32)
   485                              <1> ;   TmpVal2 = TmpVal2 / 2;
   486                              <1> ; FATSz = (TMPVal1 + (TmpVal2 – 1)) / TmpVal2;
   487                              <1> ;Input:
   488                              <1> ;   rdi = Pointer to the head of the BPB we are using
   489                              <1> ;Returns: 
   490                              <1> ;   eax = Number of sectors per FAT needed. Low word only valid for FAT12/16
   491 00000621 53                  <1>     push rbx
   492 00000622 51                  <1>     push rcx
   493 00000623 52                  <1>     push rdx
   494 00000624 57                  <1>     push rdi
   495                              <1>     
   496 00000625 0FB74706            <1>     movzx eax, word [rdi + bpb.rootEntCnt]
   497 00000629 C1E005              <1>     shl eax, 5  ;Multiply by 32
   498 0000062C 0FB71F              <1>     movzx ebx, word [rdi + bpb.bytsPerSec]
   499 0000062F FFCB                <1>     dec ebx
   500 00000631 01D8                <1>     add eax, ebx
   501 00000633 FFC3                <1>     inc ebx
   502 00000635 31D2                <1>     xor edx, edx
   503 00000637 F7F3                <1>     div ebx
   504 00000639 89C2                <1>     mov edx, eax    ;edx = RootDirSectors
   505                              <1> 
   506 0000063B 0FB74708            <1>     movzx eax, word [rdi + bpb.totSec16]
   507 0000063F 8B5F15              <1>     mov ebx, dword [rdi + bpb.totSec32]
   508 00000642 85C0                <1>     test eax, eax   ;If totSec16 is 0, move totSec32 into eax
   509 00000644 0F44C3              <1>     cmovz eax, ebx
   510 00000647 0FB75F03            <1>     movzx ebx, word [rdi + bpb.revdSecCnt]
   511 0000064B 01D3                <1>     add ebx, edx    ;Add RootDirSectors
   512 0000064D 29D8                <1>     sub eax, ebx
   513 0000064F 89C1                <1>     mov ecx, eax    ;ecx = TmpVal1
   514                              <1> 
   515 00000651 0FB64702            <1>     movzx eax, byte [rdi + bpb.secPerClus]
   516 00000655 C1E008              <1>     shl eax, 8  ;multiply by 256
   517 00000658 0FB65F05            <1>     movzx ebx, byte [rdi + bpb.numFATs]
   518 0000065C 01C3                <1>     add ebx, eax    ;ebx = TmpVal2
   519                              <1> 
   520 0000065E 803DD400000002      <1>     cmp byte [fatType], 2
   521 00000665 7502                <1>     jne .notFat32
   522 00000667 D1EB                <1>     shr ebx, 1  ;Divide by 2
   523                              <1> .notFat32: 
   524 00000669 89C8                <1>     mov eax, ecx    ;TmpVal1
   525 0000066B FFCB                <1>     dec ebx
   526 0000066D 01D8                <1>     add eax, ebx    ;TmpVal1 + (TmpVal2 - 1)
   527 0000066F FFC3                <1>     inc ebx
   528 00000671 31D2                <1>     xor edx, edx
   529 00000673 F7F3                <1>     div ebx ;Exit with eax = number of sectors needed per FAT
   530                              <1> .exit:
