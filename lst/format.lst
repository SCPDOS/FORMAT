   344                              <1> getVolumeID:
   345                              <1> ;Uses the time to set a volume ID
   346                              <1> ;Output: eax = VolumeID
   347                              <1> ;Preserves rbx!
   348 00000DB0 53                  <1>     push rbx
   349 00000DB1 B8002C0000          <1>     mov eax, 2C00h     ;Get Time in cx:dx
   350 00000DB6 CD21                <1>     int 21h
   351 00000DB8 0FB7DA              <1>     movzx ebx, dx
   352 00000DBB 0FB7C1              <1>     movzx eax, cx
   353 00000DBE C1E310              <1>     shl ebx, 10h
   354 00000DC1 09D8                <1>     or eax, ebx
   355 00000DC3 5B                  <1>     pop rbx
   356                              <1>     return
    13                              <2> %%_ret:
    14 00000DC4 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
