   363                              <1> computeFAT:
   364                              <1> ;Returns if FAT12/16/32 should be used for volume parameters input.
   365                              <1> ;Output: ecx = 0 => FAT 12, ecx = 1 => FAT 16, ecx = 2 => FAT 32
   366                              <1> ;All other regs preserved
   367 00000B05 50                  <1>     push rax
   368 00000B06 52                  <1>     push rdx
   369 00000B07 57                  <1>     push rdi
   370 00000B08 488B3DAE010000      <1>     mov rdi, [bpbPtr]   ;Get ptr to the returned bpb
   371                              <1> ;Compute space taken by fats
   372 00000B0F 0FB7470B            <1>     movzx eax, word [rdi + bpb.FATsz16]
   373 00000B13 0FB64F05            <1>     movzx ecx, byte [rdi + bpb.numFATs]
   374 00000B17 F7E1                <1>     mul ecx ;Get number of sectors occupied by all the fat copies
   375 00000B19 66034703            <1>     add ax, word [rdi + bpb.revdSecCnt] ;Add the number of reserved sectors
   376 00000B1D 66034706            <1>     add ax, word [rdi + bpb.rootEntCnt] ;Add the root dir sectors
   377 00000B21 50                  <1>     push rax    ;Save the non-data space
   378                              <1> ;Get the total number of sectors on the volume in eax
   379 00000B22 0FB74708            <1>     movzx eax, word [rdi + bpb.totSec16]
   380 00000B26 8B4F15              <1>     mov ecx, dword [rdi + bpb.totSec32]
   381 00000B29 85C0                <1>     test eax, eax
   382 00000B2B 0F44C1              <1>     cmovz eax, ecx  ;Move ecx to to eax if eax is zero
   383 00000B2E 59                  <1>     pop rcx
   384 00000B2F 29C8                <1>     sub eax, ecx    ;Get the data space only in eax.
   385 00000B31 0FB64F02            <1>     movzx ecx, byte [rdi + bpb.secPerClus]
   386 00000B35 85C9                <1>     test ecx, ecx
   387 00000B37 67E31F              <1>     jecxz .err  ;If this is zero, due to malformed field, escape. Use FAT16
   388 00000B3A 31D2                <1>     xor edx, edx
   389 00000B3C F7F1                <1>     div ecx         ;Get number of clusters in eax
   390                              <1> ;Now setup the return value in ecx
   391 00000B3E B902000000          <1>     mov ecx, 2  ;FAT 32 marker
   392 00000B43 3DF5FF0000          <1>     cmp eax, fat16MaxClustCnt
   393 00000B48 730B                <1>     jae .exit
   394 00000B4A FFC9                <1>     dec ecx     ;FAT 16 marker
   395 00000B4C 3DF50F0000          <1>     cmp eax, fat12MaxClustCnt
   396 00000B51 7302                <1>     jae .exit
   397 00000B53 FFC9                <1>     dec ecx     ;FAT 12 marker
   398                              <1> .exit:
   399 00000B55 5F                  <1>     pop rdi
   400 00000B56 5A                  <1>     pop rdx
   401 00000B57 58                  <1>     pop rax
   402                              <1>     return
    13                              <2> %%_ret:
    14 00000B58 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   403                              <1> .err:
   404                              <1> ;To prevent a divide by 0 error!
   405 00000B59 FFC9                <1>     dec ecx
   406 00000B5B EBF8                <1>     jmp short .exit
