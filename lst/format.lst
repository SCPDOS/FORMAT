   209                              <1> printDecimalValLB:
   210                              <1> ;Takes a value in rax and prints it's decimal representation with leading
   211                              <1> ; blanks and inserts commas where appropriate.
   212                              <1> ;Input: rax = Value to print
   213                              <1> ;       rcx = Buffer size to handle (usual values: 17 for max, 13 for dword)
   214 00001081 4889E5              <1>     mov rbp, rsp
   215 00001084 4829CC              <1>     sub rsp, rcx ;Allocate the buffer on the stack
   216 00001087 4889EF              <1>     mov rdi, rbp
   217 0000108A 4829CF              <1>     sub rdi, rcx
   218 0000108D 50                  <1>     push rax
   219 0000108E 51                  <1>     push rcx
   220 0000108F 57                  <1>     push rdi
   221 00001090 31C0                <1>     xor eax, eax
   222 00001092 F3AA                <1>     rep stosb   ;Initialise the buffer with a null value
   223 00001094 5F                  <1>     pop rdi     ;Now set the ptr to the head of the buffer
   224 00001095 59                  <1>     pop rcx
   225 00001096 58                  <1>     pop rax
   226 00001097 51                  <1>     push rcx    ;Save this value to keep the buffer length
   227 00001098 E83E000000          <1>     call decimalise   ;If return with CF=CY, error!
   228 0000109D 59                  <1>     pop rcx     ;Now print the buffer
   229 0000109E 4889EF              <1>     mov rdi, rbp
   230 000010A1 48FFCF              <1>     dec rdi     ;Doesn't affect CF
   231 000010A4 722C                <1>     jc .errPrint    ;Print a mis-aligned ? to clearly mark an error!
   232                              <1> .skipLp:
   233 000010A6 8A1F                <1>     mov bl, byte [rdi]
   234 000010A8 84DB                <1>     test bl, bl ;Any leading null's get replaced with a space
   235 000010AA 7514                <1>     jne .printLp
   236 000010AC B220                <1>     mov dl, " "
   237 000010AE E8CDFDFFFF          <1>     call putch
   238 000010B3 48FFCF              <1>     dec rdi
   239 000010B6 FFC9                <1>     dec ecx
   240 000010B8 81F901000000        <1>     cmp ecx, 1
   241 000010BE 75E6                <1>     jne .skipLp   ;Always print 1 byte for size
   242                              <1> .printLp:
   243 000010C0 8A17                <1>     mov dl, byte [rdi]
   244 000010C2 E8B9FDFFFF          <1>     call putch
   245 000010C7 48FFCF              <1>     dec rdi
   246 000010CA FFC9                <1>     dec ecx
   247 000010CC 75F2                <1>     jnz .printLp
   248                              <1> .exit:
   249 000010CE 4889EC              <1>     mov rsp, rbp    ;Deallocate the buffer and exit!
   250                              <1>     return
    13                              <2> %%_ret:
    14 000010D1 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   251                              <1> .errPrint:
   252                              <1> ;Print a default ? symbol if an overflow occurs.
   253 000010D2 B23F                <1>     mov dl, "?"
   254 000010D4 E8A7FDFFFF          <1>     call putch
   255 000010D9 EBF3                <1>     jmp short .exit
   256                              <1> 
   257                              <1> decimalise:
   258                              <1> ;Input: rax = value to decimalise
   259                              <1> ;       rdi -> Ptr to byte buffer to store string in with commas
   260                              <1> ;       ecx = buffer length
   261                              <1> ;Output: Buffer @ rdi filled in! 
   262                              <1> ;       ecx = Number of chars in buffer.
   263                              <1> ; Warning: If the number of chars in the buffer reaches buffer length,
   264                              <1> ;   we return with CF=CY. Else, CF=NC.
   265 000010DB 57                  <1>     push rdi
   266 000010DC 89CE                <1>     mov esi, ecx    
   267 000010DE 31C9                <1>     xor ecx, ecx    ;Use cl as buffer length ctr, ch as comma ctr
   268 000010E0 BB0A000000          <1>     mov ebx, 0Ah    ;Divide by 10
   269                              <1> .lp:
   270 000010E5 80FD03              <1>     cmp ch, 3       ;Are we divisible by 3?
   271 000010E8 750F                <1>     jne .skipSep
   272 000010EA 4038CE              <1>     cmp sil, cl
   273 000010ED 742A                <1>     je .exitErr     ;Before we add a comma, do we have space?
   274                              <1>     ;mov dl, byte [ctryData + countryStruc.thouSep]
   275                              <1>     ;mov byte [rdi], dl
   276 000010EF C6072C              <1>     mov byte [rdi], ","
   277 000010F2 48FFC7              <1>     inc rdi 
   278 000010F5 FEC1                <1>     inc cl          ;Inc number of chars
   279 000010F7 30ED                <1>     xor ch, ch      ;Reset comma counter
   280                              <1> .skipSep:
   281 000010F9 4038CE              <1>     cmp sil, cl
   282 000010FC 741B                <1>     je .exitErr     ;Before we add a digit, do we have space?
   283 000010FE 31D2                <1>     xor edx, edx
   284 00001100 48F7F3              <1>     div rbx         ;Divide rax by 10
   285 00001103 80C230              <1>     add dl, "0"     
   286 00001106 8817                <1>     mov byte [rdi], dl
   287 00001108 48FFC7              <1>     inc rdi
   288 0000110B FEC1                <1>     inc cl          ;Inc number of chars
   289 0000110D FEC5                <1>     inc ch          ;Inc to keep track of commas
   290 0000110F 4885C0              <1>     test rax, rax
   291 00001112 75D1                <1>     jnz .lp
   292                              <1> ;The test cleared CF if we are here
   293 00001114 0FB6C9              <1>     movzx ecx, cl
   294                              <1> .exit:
   295 00001117 5F                  <1>     pop rdi
   296                              <1>     return
    13                              <2> %%_ret:
    14 00001118 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   297                              <1> .exitErr:
   298 00001119 F9                  <1>     stc
   299 0000111A EBFB                <1>     jmp short .exit
