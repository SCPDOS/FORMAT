   240                              <1> checkNewPhysFmt:
   241                              <1> ;Checks if the physical format parameters of the disk have been changed.
   242                              <1> ;If they are, and the device is of a soft sectored medium (types 0-4), then
   243                              <1> ; we set the flag.
   244                              <1> ;Input: 
   245                              <1> ;   curParams.deviceBPB: As provided by the driver
   246                              <1> ;   reqParams.deviceBPB: As requested by the user
   247                              <1> ;Ouput:
   248                              <1> ;   If Sectors per cluster or Sectors per track changed and the 
   249                              <1> ;   device is 0-4, set byte [newFormat].
   250                              <1> ;The physical format parameters are:
   251                              <1> ; 1) Sectors per cluster (forced to 512 by us, unless 4k byte sectors)
   252                              <1> ; 2) Sectors per track
   253 00000E14 0FB7056D080000      <1>     movzx eax, word [curParams + chsParamsBlock.deviceBPB + bpb.bytsPerSec]
   254 00000E1B 663B0567080000      <1>     cmp ax, word [reqParams + chsParamsBlock.deviceBPB + bpb.bytsPerSec]
   255 00000E22 7510                <1>     jne .diff
