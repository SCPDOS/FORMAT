   311                              <1> ;File system area. We do the full computation at once.
   312 00001130 8B05D3010000        <1>     mov eax, dword [dFSAreaSz]  ;Get write count
   313 00001136 F6058201000001      <1>     test byte [bFlag1], bitQuick
   314 0000113D 7502                <1>     jnz .exit
