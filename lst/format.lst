   536                              <1> ;            CTRL+C handler            :
   537                              <1> ;---------------------------------------
   538                              <1> 
   539                              <1> breakRoutine:
   540                              <1> ;This subroutine is called by ^C
   541                              <1> ;Prompts the user for what they want to do.
   542                              <1> ;Preserve registers across call.
   543                              <1> ;
   544                              <1> ;We always return IRETQ which means we always execute the 
   545                              <1> ; function code that we return to DOS in eax. Unless we wish
   546                              <1> ; to terminate, we just re-attempt the function that was 
   547                              <1> ; ^C-ed.
   548                              <1> ;
   549 0000069E 52                  <1>     push rdx
   550 0000069F 50                  <1>     push rax
   551 000006A0 488D15350F0000      <1>     lea rdx, cancel
   552 000006A7 E8BA030000          <1>     call doYNWait       ;If ret CF=NC, we said yes so exit! Else just redo op!
   553 000006AC 720C                <1>     jc .noAbort
   554 000006AE E803010000          <1>     call dosCrit1Exit   ;Exit the critical section since we are quitting
   555 000006B3 58                  <1>     pop rax
   556 000006B4 B8034C0000          <1>     mov eax, 4C03h      ;Tell DOS to terminate with error level 3
   557 000006B9 50                  <1>     push rax
   558                              <1> ;Let DOS reclaim memory and handles allocated to us
   559                              <1> .noAbort:
   560 000006BA B20A                <1>     mov dl, LF
   561 000006BC E868000000          <1>     call putch
   562 000006C1 58                  <1>     pop rax
   563 000006C2 5A                  <1>     pop rdx
   564 000006C3 48CF                <1>     iretq   ;Redo the operation
   565                              <1> 
   566                              <1> ;---------------------------------------
   567                              <1> ;             DOS wrappers             :
   568                              <1> ;---------------------------------------
   569                              <1> restoreBpb:
   570                              <1> ;Gets the BPB from the bootsector again to restore the driver state.
   571 000006C5 B801000000          <1>     mov eax, specFuncBPB    ;Get the backup bpb (which is old prev bpb)
   572 000006CA E827000000          <1>     call getBpb
   573 000006CF 7310                <1>     jnc .gotBpb
   574                              <1> .bad:
   575                              <1> ;If we cant even get the BS anymore, lock drive (if fixed).
   576 000006D1 F605B2080000FF      <1>     test byte [fixDev], -1
   577                              <1>     retz
