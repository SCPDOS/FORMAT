   612 00000733 488B3DA2030000      <1>     mov rdi, qword [bufferArea]
   613 0000073A 0FB70DA6030000      <1>     movzx ecx, word [sectorSize]
   614 00000741 31C0                <1>     xor eax, eax
   615 00000743 F3AA                <1>     rep stosb   ;Clean the Sector buffer
   616                              <1>     return
    13                              <2> %%_ret:
    14 00000745 C3                  <2>  ret
