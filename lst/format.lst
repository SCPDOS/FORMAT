   880                              <1> checkBreak:
   881                              <1> ;Checks if control C has been struck and triggers Int 23h.
   882                              <1> ;21h/0Bh does a non-blocking check of the keyboard buffer status.
   883                              <1> ;If there is a Ctrl+C waiting in buffer, it triggers Int 23h.
   884                              <1> ;If the user then doesn't want to exit the program, it reenters 
   885                              <1> ; the call to check the keyboard status which will just return 
   886                              <1> ; if the buffer is full or empty.
   887                              <1> ;If no Ctrl+C waiting in the buffer, it just return the keyboard status.
   888 000009B8 B8000B0000          <1>     mov eax, 0B00h
   889 000009BD CD21                <1>     int 21h
   890                              <1>     return
    13                              <2> %%_ret:
    14 000009BF C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
