    13                              <1> .doWait:
    14                              <1> ;Input: rdx -> String to wait for Y/N on.
    15                              <1> ;Output: CF=NC -> Y(es)
    16                              <1> ;        CF=CY -> N(o)
    17 00000A4F 52                  <1>     push rdx
    18 00000A50 E8A2FCFFFF          <1>     call printString
    19 00000A55 E88DFCFFFF          <1>     call getch
    20 00000A5A 0FB6D0              <1>     movzx edx, al
    21 00000A5D B823650000          <1>     mov eax, 6523h  ;Zeros upper word of lower dword
    22 00000A62 CD21                <1>     int 21h
    23 00000A64 5A                  <1>     pop rdx
    24 00000A65 3D01000000          <1>     cmp eax, 1
    25 00000A6A 77E3                <1>     ja .doWait
    26                              <1>     return
    13                              <2> %%_ret:
    14 00000A6C C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
