    26 0000102B 00                  <1> bpbSize     db 0        ;Size of the BPB
    27 0000102C 00000000            <1> hiddSector  dd 0        ;Only used for Fixed Disks, offset to add
    28 00001030 00000000            <1> f32RootClus dd 0        ;Cluster addr of the root dir cluster if FAT32
    29 00001034 00000000            <1> dSerNum     dd 0        ;Serial number
    30 00001038 00000000            <1> dBadClust   dd 0        ;Number of bad clusters on disk
    31                              <1> 
