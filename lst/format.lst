   611                              <1> .fat32:
   612                              <1> ;Now add dir sectors and two bootsectors and two fsinfo sectors (4)
   613 0000079B 0FB60575020000      <1>     movzx eax, byte [secPerClust]   ;Sectors per cluster (1 cluster for dir)
   614 000007A2 0504000000          <1>     add eax, 4  ;Two BS + 2 FSINFO
