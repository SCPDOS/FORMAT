   313                              <1> .fat32:
   314                              <1> ;Now add dir sectors and two bootsectors and two fsinfo sectors (4)
   315 00000D43 0FB605D3020000      <1>     movzx eax, byte [secPerClust]   ;Sectors per cluster (1 cluster for dir)
   316 00000D4A 0504000000          <1>     add eax, 4  ;Two BS + 2 FSINFO
   317 00000D4F 480105E6020000      <1>     add qword [secToWrite], rax
