   786                              <1> breakRoutine:
   787                              <1> ;This subroutine is called by ^C
   788                              <1> ;Prompts the user for what they want to do
   789 000008E8 488D1526040000      <1>     lea rdx, cancel
   790 000008EF E8D3FFFFFF          <1>     call doYNWait   ;If returns with CF=CY, exit! Else just redo operation!
   791 000008F4 730A                <1>     jnc .breakReturnNoExit
   792 000008F6 E8B9000000          <1>     call dosCrit1Exit   ;Exit the critical section since we are quitting
   793 000008FB B8034C0000          <1>     mov eax, 4C03h      ;Tell DOS to terminate with error level 3
   794                              <1> ;Let DOS reclaim memory and handles allocated to us
   795                              <1> .breakReturnNoExit:
   796 00000900 50                  <1>     push rax
   797 00000901 52                  <1>     push rdx
   798 00000902 488D1570040000      <1>     lea rdx, crlfStr
   799 00000909 E814000000          <1>     call printString
   800 0000090E 5A                  <1>     pop rdx
   801 0000090F 58                  <1>     pop rax
   802 00000910 48CF                <1>     iretq   ;Redo the operation
