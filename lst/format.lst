   767                              <1> doYNWait:
   768                              <1> ;Input: rdx -> String to wait for Y/N on.
   769                              <1> ;Output: CF=NC -> N
   770                              <1> ;        CF=CY -> Y
   771 000008F4 52                  <1>     push rdx
   772 000008F5 E856000000          <1>     call printString
   773 000008FA E841000000          <1>     call getch
   774 000008FF 3C79                <1>     cmp al, "y"
   775 00000901 740F                <1>     je .yes
   776 00000903 3C59                <1>     cmp al, "Y"
   777 00000905 740B                <1>     je .yes
   778 00000907 3C6E                <1>     cmp al, "n"
   779 00000909 7408                <1>     je .no
   780 0000090B 3C4E                <1>     cmp al, "N"
   781 0000090D 7404                <1>     je .no
   782 0000090F 5A                  <1>     pop rdx
   783 00000910 EB14                <1>     jmp short breakRoutine
   784                              <1> .yes:
   785 00000912 F9                  <1>     stc
   786                              <1> .no:
   787 00000913 5A                  <1>     pop rdx
   788                              <1>     return
