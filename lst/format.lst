   165                              <1> endstruc
    46                                  ;Default behaviour is to always zero all data sectors of the disk as well. 
    47                                  ; This is done to also pick up bad clusters to mark them as bad in the FAT.
    48                                  bitQuick    equ 1   ;/Q -> Do quick format, no zeroing. No bad sect. checks.
    49                                  bitSystem   equ 2   ;/S -> Install system files.
    50                                  bitVolume   equ 4   ;/V:[LABEL] -> Don't prompt volume, use LABEL directly.
    51                                  bitBadChck  equ 8   ;/C -> Double check if bad clusters still bad. 
    52                                  ;Next two hold only on remdevs.
    53                                  bitOld      equ 10  ;Must be /N:<Sectors> and /T:<Tracks>.
    54                                  bitNew      equ 20  ;/F:<size> -> Specify the size, in bytes, of volume. 
