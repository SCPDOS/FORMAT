    10 0000072E 0000000000000000    <1>         at .startSector,    dq 0
    11                              <1>     iend
    12                              <1> 
    13                              <1> ;Data area here
    14 00000736 FF                  <1> fmtDrive    db -1       ;Drive we are operating on (0 based)
    15 00000737 00                  <1> inCrit      db 0        ;If not 0, in a critical section, must exit
    16 00000738 0000000000000000    <1> cdsPtr      dq 0        ;CDS ptr here
    17 00000740 0000000000000000    <1> bufferArea  dq 0        ;Ptr to the buffer area
    18 00000748 00                  <1> breakByte   db 0        ;Break state to reset when returning (We set break on)
    19                              <1> ;Format Data here
    20 00000749 00                  <1> remDev      db 0        ;0 = Removable, -1 = Fixed
    21 0000074A FF                  <1> fatType     db -1       ;0 = FAT12, 1 = FAT16, 2 = FAT32, -1 = No FAT
    22 0000074B 0000                <1> sectorSize  dw 0        ;Sector size in bytes
    23 0000074D 0000000000000000    <1> numSectors  dq 0        ;Number of sectors in volume
    24 00000755 00                  <1> secPerClust db 0        ;Copy the sectors per cluster over
    25 00000756 00000000            <1> fatSize     dd 0        ;FAT size (number of sectors per FAT)
    26 0000075A F0                  <1> media       db 0F0h     ;Media type (F0h or F8h)
    27 0000075B 0000000000000000    <1> bpbPointer  dq 0        ;Pointer to the BPB we will use
    28 00000763 00                  <1> bpbSize     db 0        ;Size of the BPB
    29 00000764 00000000            <1> hiddSector  dd 0        ;Only used for Fixed Disks, offset to add
    30                              <1> 
    31 00000768 0000000000000000    <1> loaderPtr   dq 0        ;Point to the bootloader to use
    32 00000770 0000                <1> loaderBytes dw 0        ;Number of bytes to copy
    33                              <1> 
    34 00000772 00000000            <1> f32RootClus dd 0        ;Cluster addr of the root dir cluster if FAT32
    35                              <1> ;Tables
    36                              <1> ;Each row is 5 bytes, {DWORD, BYTE} with DWORD = diskSize, BYTE=secPerClusVal
    37                              <1> ;This table assumes a 512 byte sector (fair assumption) but we do a byte size
    38                              <1> ; comparison in format to eventually allow for other sized sectors
    39                              <1> fat16ClusterTable:
    40 00000776 00A04100            <1>     dd 8400*512 ;Disks up to 4.1MB, must use FAT12 with 0.5 K clusters
    41 0000077A 01                  <1>     db 1    ;ALL FAT12 uses 1, unless it is a preexisting meddesc type medium
    42 0000077B 0050FF00            <1>     dd 32680*512    ; Disk up to 16MB, 1K clusters
    43 0000077F 02                  <1>     db 2
    44 00000780 00000008            <1>     dd 262144*512   ; Disk up to 128MB, 2K clusters
    45 00000784 04                  <1>     db 4
    46 00000785 00000010            <1>     dd 524288*512   ; Disk up to 256MB, 4K clusters
    47 00000789 08                  <1>     db 8
    48 0000078A 00000020            <1>     dd 1048576*512  ; Disk up to 512Mb, 8K clusters
    49 0000078E 10                  <1>     db 16
    50                              <1> 
    51                              <1> ;Here DWORD becomes QWORD
    52                              <1> fat32ClusterTable:
    53 0000078F 0000000002000000    <1>     dq 16777216*512 ; Disk up to 8GB, 4K clusters
    54 00000797 08                  <1>     db 8        
    55 00000798 0000000004000000    <1>     dq 33554432*512 ; Disk up to 16GB, 8K clusters
    56 000007A0 10                  <1>     db 16
    57 000007A1 0000000008000000    <1>     dq 67108864*512 ; Disk up to 32Gb, 16K clusters
    58 000007A9 20                  <1>     db 32
    59 000007AA FFFFFFFFFFFFFFFF    <1>     dq -1       ; Disk up to 2TB, 32K clusters
    60 000007B2 40                  <1>     db 64
    61                              <1> 
    62                              <1> ;Static BPBs here, fields set to -1 must be edited.
    63                              <1> ;Fields with a preset value should NOT be touched.
    64                              <1> genericBPB12:
    65                              <1>     istruc bpb
    66 000007B3 FFFF                <1>     at .bytsPerSec,  dw -1           ;512 bytes per sector, normally
