   320                              <1> writeFATStartSig:
   321                              <1> ;Writes the first two cluster blocks with the necessary signature
   322                              <1> ;Input: rdi -> Start of the FAT sector
   323 00000D82 50                  <1>     push rax
   324 00000D83 53                  <1>     push rbx
   325 00000D84 488B1D11020000      <1>     mov rbx, qword [bpbPtr]
   326 00000D8B 0FBE430A            <1>     movsx eax, byte [rbx + bpb.media]   ;Get the media byte, sign extend
   327 00000D8F 803DF501000001      <1>     cmp byte [fatType], fs_fat16
   328 00000D96 7407                <1>     je .fat16
   329 00000D98 7709                <1>     ja .fat32
   330                              <1> ;Fat 12 here
   331 00000D9A 25FFFFFF00          <1>     and eax, 00FFFFFFh  ;Save only low three bytes
   332                              <1> .fat16:
   333 00000D9F 8907                <1>     mov dword [rdi], eax
   334 00000DA1 EB0A                <1>     jmp short .exit
   335                              <1> .fat32:
