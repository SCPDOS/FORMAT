   241                              <1> genericBPB32:
   242                              <1>     istruc bpb32
   243 000011B8 FFFF                <1>         at .bytsPerSec, dw -1   ;512 bytes per sector, normally
   244 000011BA FF                  <1>         at .secPerClus, db -1   ;Sectors per cluster
   245 000011BB 1000                <1>         at .revdSecCnt, dw 16   ;16 Reserved Sectors
   246 000011BD 02                  <1>         at .numFATs,    db 2    ;2 FAT tables
   247 000011BE 0000                <1>         at .rootEntCnt, dw 0    ;Invalid field for FAT32
   248 000011C0 0000                <1>         at .totSec16,   dw 0    ;Not a FAT 12/16 BPB
   249 000011C2 F0                  <1>         at .media,      db 0F0h ;Media byte
   250 000011C3 0000                <1>         at .FATsz16,    dw 0    ;Not a FAT 12/16 BPB
   251 000011C5 3F00                <1>         at .secPerTrk,  dw 03Fh ;FAT16 and 32 have Hard disk geometry 
   252 000011C7 FF00                <1>         at .numHeads,   dw 0FFh ;255 Heads
   253 000011C9 FFFFFFFF            <1>         at .hiddSec,    dd -1   ;No hidden sectors on removable
   254 000011CD FFFFFFFF            <1>         at .totSec32,   dd -1   ;Total number of sectors on disk
   255                              <1> ;---------------------FAT 32 SPECIFIC FIELDS---------------------
   256 000011D1 FFFFFFFF            <1>         at .FATsz32,    dd -1  ;Number of sectors per FAT
   257 000011D5 FFFF                <1>         at .extFlags,   dw -1  ;Extended Flags word
   258 000011D7 0000                <1>         at .FSver,      dw 0   ;File system version word, must be 0
   259 000011D9 FFFFFFFF            <1>         at .RootClus,   dd -1  ;First Cluster of Root Directory
   260 000011DD 0100                <1>         at .FSinfo,     dw 1   ;Sector number of FSINFO structure, usually 1
   261 000011DF 0600                <1>         at .BkBootSec,  dw 6   ;Backup Boot sector, either 0 or 6
   262 000011E1 000000000000000000- <1>         at .reserved,   db 12 dup (0) ;Reserved 12 bytes
   262 000011EA 000000              <1>
   263                              <1>     iend
   264                              <1>     istruc extBs 
   265 000011ED FF                  <1>         at .drvNum,     db -1   ;Set to 0 for Remdev, 80h for fixed disk
   266 000011EE 00                  <1>         at .reserved1,  db 0
   267 000011EF 29                  <1>         at .bootSig,    db extBsSig ;Normal signature
   268 000011F0 FFFFFFFF            <1>         at .volId,      dd -1       ;Set to date/time @ format
   269 000011F4 4E4F204E414D452020- <1>         at .volLab,     db 'NO NAME    '    
   269 000011FD 2020                <1>
   270 000011FF 4641543332202020    <1>         at .filSysType, db 'FAT32   '
