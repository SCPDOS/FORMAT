   652                              <1> computeFATSize:
   653                              <1> ; ;Works on the genericBPB in memory. Applies the following algorithm
   654                              <1> ; RootDirSectors = ((BPB_RootEntCnt * 32) + (BPB_BytsPerSec – 1)) / BPB_BytsPerSec;
   655                              <1> ; TmpVal1 = DskSize – (BPB_ResvdSecCnt + RootDirSectors);
   656                              <1> ; TmpVal2 = (256 * BPB_SecPerClus) + BPB_NumFATs;
   657                              <1> ; If(FATType == FAT32)
   658                              <1> ;   TmpVal2 = TmpVal2 / 2;
   659                              <1> ; FATSz = (TMPVal1 + (TmpVal2 – 1)) / TmpVal2;
   660                              <1> ;Input:
   661                              <1> ;   rdi = Pointer to the head of the BPB we are using
   662                              <1> ;Returns: 
   663                              <1> ;   eax = Number of sectors per FAT needed. Low word only valid for FAT12/16
   664 000007F0 53                  <1>     push rbx
   665 000007F1 51                  <1>     push rcx
   666 000007F2 52                  <1>     push rdx
   667 000007F3 57                  <1>     push rdi
   668                              <1>     
   669 000007F4 0FB74706            <1>     movzx eax, word [rdi + bpb.rootEntCnt]
   670 000007F8 C1E005              <1>     shl eax, 5  ;Multiply by 32
   671 000007FB 0FB71F              <1>     movzx ebx, word [rdi + bpb.bytsPerSec]
   672 000007FE FFCB                <1>     dec ebx
   673 00000800 01D8                <1>     add eax, ebx
   674 00000802 FFC3                <1>     inc ebx
   675 00000804 31D2                <1>     xor edx, edx
   676 00000806 F7F3                <1>     div ebx
   677 00000808 89C2                <1>     mov edx, eax    ;edx = RootDirSectors
   678                              <1> 
   679 0000080A 0FB74708            <1>     movzx eax, word [rdi + bpb.totSec16]
   680 0000080E 8B5F15              <1>     mov ebx, dword [rdi + bpb.totSec32]
   681 00000811 85C0                <1>     test eax, eax   ;If totSec16 is 0, move totSec32 into eax
   682 00000813 0F44C3              <1>     cmovz eax, ebx
   683 00000816 0FB75F03            <1>     movzx ebx, word [rdi + bpb.revdSecCnt]
   684 0000081A 01D3                <1>     add ebx, edx    ;Add RootDirSectors
   685 0000081C 29D8                <1>     sub eax, ebx
   686 0000081E 89C1                <1>     mov ecx, eax    ;ecx = TmpVal1
   687                              <1> 
   688 00000820 0FB64702            <1>     movzx eax, byte [rdi + bpb.secPerClus]
   689 00000824 C1E008              <1>     shl eax, 8  ;multiply by 256
   690 00000827 0FB65F05            <1>     movzx ebx, byte [rdi + bpb.numFATs]
   691 0000082B 01C3                <1>     add ebx, eax    ;ebx = TmpVal2
   692                              <1> 
   693 0000082D 803DD801000002      <1>     cmp byte [fatType], 2
   694 00000834 7502                <1>     jne .notFat32
   695 00000836 D1EB                <1>     shr ebx, 1  ;Divide by 2
   696                              <1> .notFat32: 
   697 00000838 89C8                <1>     mov eax, ecx    ;TmpVal1
   698 0000083A FFCB                <1>     dec ebx
   699 0000083C 01D8                <1>     add eax, ebx    ;TmpVal1 + (TmpVal2 - 1)
   700 0000083E FFC3                <1>     inc ebx
   701 00000840 31D2                <1>     xor edx, edx
   702 00000842 F7F3                <1>     div ebx ;Exit with eax = number of sectors needed per FAT
   703                              <1> .exit:
   704 00000844 5F                  <1>     pop rdi
   705 00000845 5A                  <1>     pop rdx
   706 00000846 59                  <1>     pop rcx
   707 00000847 5B                  <1>     pop rbx
   708                              <1>     return
    13                              <2> %%_ret:
    14 00000848 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
