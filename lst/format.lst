   881                              <1> checkBreak:
   882                              <1> ;Checks if control C has been struck and triggers Int 23h.
   883                              <1> ;21h/0Bh does a non-blocking check of the keyboard buffer status.
   884                              <1> ;If there is a Ctrl+C waiting in buffer, it triggers Int 23h.
   885                              <1> ;If the user then doesn't want to exit the program, it reenters 
   886                              <1> ; the call to check the keyboard status which will just return 
   887                              <1> ; if the buffer is full or empty.
   888                              <1> ;If no Ctrl+C waiting in the buffer, it just return the keyboard status.
   889 000009B2 B8000B0000          <1>     mov eax, 0B00h
   890 000009B7 CD21                <1>     int 21h
   891                              <1>     return
    13                              <2> %%_ret:
