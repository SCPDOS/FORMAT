   299                              <1> .fat32:
   300                              <1> ;------------------
   301                              <1> ;Do FAT32 here
   302                              <1> ;------------------
   303                              <1> ;Now we need to allocate a cluster to the root directory. We need to 
   304                              <1> ; then sanitise the cluster completely.
   305                              <1> ;Step 1) Get back the FAT sector.
   306                              <1> ;Step 2) Allocate Cluster 2
   307                              <1> ;Step 3) Write back, without updating the percentage.
   308                              <1> ;Step 4) Write back copy.
   309                              <1> ;Step 5) Loop through sectors of the cluster nulling the sector out
   310 000005EE B901000000          <1>     mov ecx, 1
   311 000005F3 488B3DE90C0000      <1>     mov rdi, qword [bpbPtr]
   312 000005FA 0FB75703            <1>     movzx edx, word [rdi + bpb32.revdSecCnt]
   313 000005FE 51                  <1>     push rcx
   314 000005FF 52                  <1>     push rdx
   315 00000600 E801FCFFFF          <1>     call readSector
   316 00000605 5A                  <1>     pop rdx
   317 00000606 59                  <1>     pop rcx
   318 00000607 488B1DA90C0000      <1>     mov rbx, qword [pBuffer]
   319 0000060E C74308FFFFFFFF      <1>     mov dword [rbx + 8], -1     ;Allocate this cluster
   320 00000615 51                  <1>     push rcx
   321 00000616 52                  <1>     push rdx
   322 00000617 E800FCFFFF          <1>     call writeSector
   323 0000061C 5A                  <1>     pop rdx
   324 0000061D 59                  <1>     pop rcx
   325 0000061E 0F82A50B0000        <1>     jc badDirExit
   326 00000624 035719              <1>     add edx, dword [rdi + bpb32.FATsz32]   ;Go to backup FAT sector
   327 00000627 52                  <1>     push rdx
   328 00000628 E8EFFBFFFF          <1>     call writeSector
   329 0000062D 5A                  <1>     pop rdx
   330 0000062E 0F82950B0000        <1>     jc badDirExit
   331 00000634 035719              <1>     add edx, dword [rdi + bpb32.FATsz32]   ;Go to first data sector
   332 00000637 57                  <1>     push rdi
   333 00000638 E898070000          <1>     call cleanBuffer    ;Clean the buffer for writeback
   334 0000063D 5F                  <1>     pop rdi
   335 0000063E 0FB67702            <1>     movzx esi, byte [rdi + bpb32.secPerClus]
   336 00000642 B901000000          <1>     mov ecx, 1
   337                              <1> .fat32RootClean:
   338 00000647 51                  <1>     push rcx
   339 00000648 52                  <1>     push rdx
   340 00000649 56                  <1>     push rsi
   341 0000064A E8CDFBFFFF          <1>     call writeSector
   342 0000064F 5E                  <1>     pop rsi
   343 00000650 5A                  <1>     pop rdx
   344 00000651 59                  <1>     pop rcx
   345 00000652 0F82710B0000        <1>     jc badDirExit
