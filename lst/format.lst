   294                              <1> .quick:
   295 00000D2B 8B0566020000        <1>     mov eax, dword [fatSize]
   296 00000D31 48D1E0              <1>     shl rax, 1  ;Multiply this value by 2 for two FATs
   297 00000D34 4889057A020000      <1>     mov qword [secToWrite], rax
   298 00000D3B 803D4902000002      <1>     cmp byte [fatType], fs_fat32
   299 00000D42 742A                <1>     je .fat32
   300                              <1> ;Add the sectors for the root directory and single bootsector
   301 00000D44 488B3551020000      <1>     mov rsi, qword [bpbPtr]
   302 00000D4B 0FB74606            <1>     movzx eax, word [rsi + bpb.rootEntCnt]  ;Number of 32 bit entries
   303 00000D4F C1E005              <1>     shl eax, 5  ;Get number of bytes in root dir
   304 00000D52 0FB736              <1>     movzx esi, word [rsi + bpb.bytsPerSec]
   305 00000D55 31D2                <1>     xor edx, edx
   306 00000D57 F7F6                <1>     div esi ;Get number of whole sectors in eax. edx is remainder. 
   307 00000D59 FFC0                <1>     inc eax ;Add one for the bootsector
   308 00000D5B 48010553020000      <1>     add qword [secToWrite], rax ;Add whole sectors and bootsector to count
   309 00000D62 85D2                <1>     test edx, edx   ;If no remainder (should never be a remainder), exit
   310                              <1>     retz
