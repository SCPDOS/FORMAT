   185                              <1> ;;parseCheck:
   186                              <1> ;Checks that the flags we have sset make sense for the type of 
   187                              <1> ; device we are formatting.
   188                              <1> ;Input: al = Clear if removable
   189                              <1> ;;       al = Set if fixed
   190                              <1> ;;    test al, al ;All options on rem devs
   191                              <1> ;;    retz
   192                              <1> ;If any of these bits are set, we fail.
   193                              <1> ;;    test byte [bFlag1], bitSec | bitTrk | bitFloppy 
   194                              <1> ;;    retz
   195                              <1> ;;    jmp badParamExit
   196                              <1> 
   197                              <1> ;-------------------------
   198                              <1> ; Parse utility functions
   199                              <1> ;-------------------------
   200                              <1> 
   201                              <1> readChar:
   202                              <1> ;Reads a character from the command tail. 
   203                              <1> ; If the count goes to zero or CR read, end of line!
   204                              <1> ;Input: ecx = Number of chars left to read
   205                              <1> ;       rsi -> String to read
   206                              <1> ;Output: rsi -> Adv by one char
   207                              <1> ;        ecx -= 1
   208                              <1> ;       ZF=ZE: End of cmd tail
   209                              <1> ;       ZF=NZ: Not end of cmd tail
   210 000009B5 85C9                <1>     test ecx, ecx
   211                              <1>     retz
