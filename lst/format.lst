    41                              <1> struc exFcb
    42 00000000 ??                  <1>     .extSig     db ?  ;If the first byte is -1, signals an exFCB
    43 00000001 ??????????          <1>     .reserved   db 5 dup (?)  
    44 00000006 ??                  <1>     .attribute  db ?  ;File attribute byte
    45 00000007 ??                  <1>     .driveNum   db ?  ;0 based drive number
    46 00000008 ????????????????    <1>     .filename   db 8 dup (?)
    47 00000010 ??????              <1>     .fileext    db 3 dup (?)
    48 00000013 ????                <1>     .curBlock   db 2 dup (?)  ;Current block number relative to 0
    49                              <1> ;One block consists of 128 records, of size denoted in the below
    50 00000015 ????                <1>     .recordSize db 2 dup (?)  ;Record size, default 80h
    51 00000017 ????????            <1>     .fileSize   db 4 dup (?)  ;File size, in bytes
    52 0000001B ????                <1>     .fileDate   db 2 dup (?)  ;Standard date format
    53 0000001D ????                <1>     .fileTime   db 2 dup (?)  ;Standard time format
    54                              <1>     ;----------------------------------------
    55                              <1>     ;Internal Records
    56 0000001F ??                  <1>     .sftNdx     db ?  ;Internal, SFT ndx number
    57 00000020 ??                  <1>     .fcbMode    db ?  ;Internal byte, to indicate format of special field
    58 00000021 ????????????        <1>     .special    db 6 dup (?)
    59                              <1>     ;----------------------------------------
    60 00000027 ??                  <1>     .recordNum  db ?  ;Current record in block
    61 00000028 ????????            <1>     .randRecrd  db 4 dup (?)  ;Relative record number, relative to start of file
    62                              <1> endstruc
