   570                              <1> ; recognise the bootsector as valid. Thus we have valid sector 0's for
   571                              <1> ; weird sectord devices. 
   572 000008B8 C703EBFE9000        <1>     mov dword [rbx + oemHeader.jump], 090FEEBh ;Infinite loop jump!
   573 000008BE 48B8534350444F5376- <1>     mov rax, "SCPDOSv1"
