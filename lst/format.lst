   358                              <1> computeFAT:
   359                              <1> ;Returns if FAT12/16/32 should be used for volume parameters input.
   360                              <1> ;Output: ecx = 0 => FAT 12, ecx = 1 => FAT 16, ecx = 2 => FAT 32
   361                              <1> ;All other regs preserved
   362 00000DC5 50                  <1>     push rax
   363 00000DC6 52                  <1>     push rdx
   364 00000DC7 57                  <1>     push rdi
   365 00000DC8 488B3DCD010000      <1>     mov rdi, [bpbPtr]   ;Get ptr to the returned bpb
   366                              <1> ;Compute space taken by fats
   367 00000DCF 0FB7470B            <1>     movzx eax, word [rdi + bpb.FATsz16]
   368 00000DD3 0FB64F05            <1>     movzx ecx, byte [rdi + bpb.numFATs]
   369 00000DD7 F7E1                <1>     mul ecx ;Get number of sectors occupied by all the fat copies
   370 00000DD9 66034703            <1>     add ax, word [rdi + bpb.revdSecCnt] ;Add the number of reserved sectors
   371 00000DDD 66034706            <1>     add ax, word [rdi + bpb.rootEntCnt] ;Add the root dir sectors
   372 00000DE1 50                  <1>     push rax    ;Save the non-data space
   373                              <1> ;Get the total number of sectors on the volume in eax
   374 00000DE2 0FB74708            <1>     movzx eax, word [rdi + bpb.totSec16]
   375 00000DE6 8B4F15              <1>     mov ecx, dword [rdi + bpb.totSec32]
   376 00000DE9 85C0                <1>     test eax, eax
   377 00000DEB 0F44C1              <1>     cmovz eax, ecx  ;Move ecx to to eax if eax is zero
   378 00000DEE 59                  <1>     pop rcx
   379 00000DEF 29C8                <1>     sub eax, ecx    ;Get the data space only in eax.
   380 00000DF1 0FB64F02            <1>     movzx ecx, byte [rdi + bpb.secPerClus]
   381 00000DF5 85C9                <1>     test ecx, ecx
   382 00000DF7 67E31F              <1>     jecxz .err  ;If this is zero, due to malformed field, escape. Use FAT16
   383 00000DFA 31D2                <1>     xor edx, edx
   384 00000DFC F7F1                <1>     div ecx         ;Get number of clusters in eax
   385                              <1> ;Now setup the return value in ecx
   386 00000DFE B902000000          <1>     mov ecx, 2  ;FAT 32 marker
   387 00000E03 3DF5FF0000          <1>     cmp eax, fat16MaxClustCnt
   388 00000E08 730B                <1>     jae .exit
   389 00000E0A FFC9                <1>     dec ecx     ;FAT 16 marker
   390 00000E0C 3DF50F0000          <1>     cmp eax, fat12MaxClustCnt
   391 00000E11 7302                <1>     jae .exit
   392 00000E13 FFC9                <1>     dec ecx     ;FAT 12 marker
   393                              <1> .exit:
   394 00000E15 5F                  <1>     pop rdi
   395 00000E16 5A                  <1>     pop rdx
   396 00000E17 58                  <1>     pop rax
   397                              <1>     return
    13                              <2> %%_ret:
    14 00000E18 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   398                              <1> .err:
   399                              <1> ;To prevent a divide by 0 error!
   400 00000E19 FFC9                <1>     dec ecx
   401 00000E1B EBF8                <1>     jmp short .exit
   402                              <1> 
   403                              <1> computeFATSize:
   404                              <1> ; Reads from the bpb in rdi. Applies the following algorithm
   405                              <1> ; RootDirSectors = ((BPB_RootEntCnt * 32) + (BPB_BytsPerSec – 1)) / BPB_BytsPerSec;
   406                              <1> ; TmpVal1 = DskSize – (BPB_ResvdSecCnt + RootDirSectors);
   407                              <1> ; TmpVal2 = (256 * BPB_SecPerClus) + BPB_NumFATs;
   408                              <1> ; If(FATType == FAT32)
   409                              <1> ;   TmpVal2 = TmpVal2 / 2;
   410                              <1> ; FATSz = (TMPVal1 + (TmpVal2 – 1)) / TmpVal2;
   411                              <1> ;Input:
   412                              <1> ;   rdi = Pointer to the head of the BPB we are using
   413                              <1> ;Returns: 
   414                              <1> ;   eax = Number of sectors per FAT needed. Low word only valid for FAT12/16
   415 00000E1D 53                  <1>     push rbx
   416 00000E1E 51                  <1>     push rcx
   417 00000E1F 52                  <1>     push rdx
   418 00000E20 57                  <1>     push rdi
   419                              <1>     
   420 00000E21 0FB74706            <1>     movzx eax, word [rdi + bpb.rootEntCnt]
   421 00000E25 C1E005              <1>     shl eax, 5  ;Multiply by 32
   422 00000E28 0FB71F              <1>     movzx ebx, word [rdi + bpb.bytsPerSec]
   423 00000E2B FFCB                <1>     dec ebx
   424 00000E2D 01D8                <1>     add eax, ebx
   425 00000E2F FFC3                <1>     inc ebx
   426 00000E31 31D2                <1>     xor edx, edx
   427 00000E33 F7F3                <1>     div ebx
   428 00000E35 89C2                <1>     mov edx, eax    ;edx = RootDirSectors
   429                              <1> 
   430 00000E37 0FB74708            <1>     movzx eax, word [rdi + bpb.totSec16]
   431 00000E3B 8B5F15              <1>     mov ebx, dword [rdi + bpb.totSec32]
   432 00000E3E 85C0                <1>     test eax, eax   ;If totSec16 is 0, move totSec32 into eax
   433 00000E40 0F44C3              <1>     cmovz eax, ebx
   434 00000E43 0FB75F03            <1>     movzx ebx, word [rdi + bpb.revdSecCnt]
   435 00000E47 01D3                <1>     add ebx, edx    ;Add RootDirSectors
   436 00000E49 29D8                <1>     sub eax, ebx
   437 00000E4B 89C1                <1>     mov ecx, eax    ;ecx = TmpVal1
   438                              <1> 
   439 00000E4D 0FB64702            <1>     movzx eax, byte [rdi + bpb.secPerClus]
   440 00000E51 C1E008              <1>     shl eax, 8  ;multiply by 256
   441 00000E54 0FB65F05            <1>     movzx ebx, byte [rdi + bpb.numFATs]
   442 00000E58 01C3                <1>     add ebx, eax    ;ebx = TmpVal2
   443                              <1> 
   444 00000E5A 803D2A01000002      <1>     cmp byte [fatType], fs_fat32
   445 00000E61 7502                <1>     jne .notFat32
   446 00000E63 D1EB                <1>     shr ebx, 1  ;Divide by 2
   447                              <1> .notFat32: 
   448 00000E65 89C8                <1>     mov eax, ecx    ;TmpVal1
   449 00000E67 FFCB                <1>     dec ebx
   450 00000E69 01D8                <1>     add eax, ebx    ;TmpVal1 + (TmpVal2 - 1)
   451 00000E6B FFC3                <1>     inc ebx
   452 00000E6D 31D2                <1>     xor edx, edx
   453 00000E6F F7F3                <1>     div ebx ;Exit with eax = number of sectors needed per FAT
   454                              <1> .exit:
