   835                              <1> checkBreak:
   836                              <1> ;Checks if control C has been struck and triggers Int 23h.
   837                              <1> ;21h/0Bh does a non-blocking check of the keyboard buffer status.
   838                              <1> ;If there is a Ctrl+C waiting in buffer, it triggers Int 23h.
   839                              <1> ;If the user then doesn't want to exit the program, it reenters 
   840                              <1> ; the call to check the keyboard status which will just return 
   841                              <1> ; if the buffer is full or empty.
   842                              <1> ;If no Ctrl+C waiting in the buffer, it just return the keyboard status.
   843 00000958 B8000B0000          <1>     mov eax, 0B00h
   844 0000095D CD21                <1>     int 21h
   845                              <1>     return
    13                              <2> %%_ret:
    14 0000095F C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
