    59 00000FF0 10                  <1>     db 16
    60 00000FF1 0000000008000000    <1>     dq 67108864*512 ; Disk up to 32Gb, 16K clusters
    61 00000FF9 20                  <1>     db 32
    62 00000FFA FFFFFFFFFFFFFFFF    <1>     dq -1       ; Disk up to 2TB, 32K clusters
    63 00001002 40                  <1>     db 64
