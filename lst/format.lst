   539                              <1> computeFATSize:
   540                              <1> ; ;Works on the genericBPB in memory. Applies the following algorithm
   541                              <1> ; RootDirSectors = ((BPB_RootEntCnt * 32) + (BPB_BytsPerSec – 1)) / BPB_BytsPerSec;
   542                              <1> ; TmpVal1 = DskSize – (BPB_ResvdSecCnt + RootDirSectors);
   543                              <1> ; TmpVal2 = (256 * BPB_SecPerClus) + BPB_NumFATs;
   544                              <1> ; If(FATType == FAT32)
   545                              <1> ;   TmpVal2 = TmpVal2 / 2;
   546                              <1> ; FATSz = (TMPVal1 + (TmpVal2 – 1)) / TmpVal2;
   547                              <1> ;Input:
   548                              <1> ;   rdi = Pointer to the head of the BPB we are using
   549                              <1> ;Returns: 
   550                              <1> ;   eax = Number of sectors per FAT needed. Low word only valid for FAT12/16
   551 000006DB 53                  <1>     push rbx
   552 000006DC 51                  <1>     push rcx
   553 000006DD 52                  <1>     push rdx
   554 000006DE 57                  <1>     push rdi
   555                              <1>     
   556 000006DF 0FB74711            <1>     movzx eax, word [rdi + bpb.rootEntCnt]
   557 000006E3 C1E005              <1>     shl eax, 5  ;Multiply by 32
   558 000006E6 0FB75F0B            <1>     movzx ebx, word [rdi + bpb.bytsPerSec]
   559 000006EA FFCB                <1>     dec ebx
   560 000006EC 01D8                <1>     add eax, ebx
   561 000006EE FFC3                <1>     inc ebx
   562 000006F0 31D2                <1>     xor edx, edx
   563 000006F2 F7F3                <1>     div ebx
   564 000006F4 89C2                <1>     mov edx, eax    ;edx = RootDirSectors
   565                              <1> 
   566 000006F6 0FB74713            <1>     movzx eax, word [rdi + bpb.totSec16]
   567 000006FA 8B5F20              <1>     mov ebx, dword [rdi + bpb.totSec32]
   568 000006FD 85C0                <1>     test eax, eax   ;If totSec16 is 0, move totSec32 into eax
   569 000006FF 0F44C3              <1>     cmovz eax, ebx
   570 00000702 0FB75F0E            <1>     movzx ebx, word [rdi + bpb.revdSecCnt]
   571 00000706 01D3                <1>     add ebx, edx    ;Add RootDirSectors
   572 00000708 29D8                <1>     sub eax, ebx
   573 0000070A 89C1                <1>     mov ecx, eax    ;ecx = TmpVal1
   574                              <1> 
   575 0000070C 0FB6470D            <1>     movzx eax, byte [rdi + bpb.secPerClus]
   576 00000710 C1E008              <1>     shl eax, 8  ;multiply by 256
   577 00000713 0FB65F10            <1>     movzx ebx, byte [rdi + bpb.numFATs]
   578 00000717 01C3                <1>     add ebx, eax    ;ebx = TmpVal2
   579                              <1> 
   580 00000719 803DD300000002      <1>     cmp byte [fatType], 2
   581 00000720 7502                <1>     jne .notFat32
   582 00000722 D1EB                <1>     shr ebx, 1  ;Divide by 2
   583                              <1> .notFat32: 
   584 00000724 89C8                <1>     mov eax, ecx    ;TmpVal1
   585 00000726 FFCB                <1>     dec ebx
   586 00000728 01D8                <1>     add eax, ebx    ;TmpVal1 + (TmpVal2 - 1)
   587 0000072A FFC3                <1>     inc ebx
   588 0000072C 31D2                <1>     xor edx, edx
   589 0000072E F7F3                <1>     div ebx ;Exit with eax = number of sectors needed per FAT
   590                              <1> .exit:
   591 00000730 5F                  <1>     pop rdi
   592 00000731 5A                  <1>     pop rdx
   593 00000732 59                  <1>     pop rcx
   594 00000733 5B                  <1>     pop rbx
   595                              <1>     return
