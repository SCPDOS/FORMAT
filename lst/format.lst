     1                              <1> ;IOCTL request header
     2                              <1> reqTable:
     3                              <1>     istruc lbaParamsBlock
     4 00000716 20                  <1>         at .size,           db lbaParamsBlock_size
     5 00000717 01                  <1>         at .bSpecFuncs,     db 1    ;Get info for current partition
