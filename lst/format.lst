   523                              <1> decimalise:
   524                              <1> ;Input: rax = value to decimalise
   525                              <1> ;       rdi -> Ptr to byte buffer to store string in with commas
   526                              <1> ;       ecx = buffer length
   527                              <1> ;Output: Buffer @ rdi filled in! 
   528                              <1> ;       ecx = Number of chars in buffer.
   529                              <1> ; Warning: If the number of chars in the buffer reaches buffer length,
   530                              <1> ;   we return with CF=CY. Else, CF=NC.
   531 000006AD 57                  <1>     push rdi
   532 000006AE 89CE                <1>     mov esi, ecx    
   533 000006B0 31C9                <1>     xor ecx, ecx    ;Use cl as buffer length ctr, ch as comma ctr
   534 000006B2 BB0A000000          <1>     mov ebx, 0Ah    ;Divide by 10
   535                              <1> .lp:
   536 000006B7 80FD03              <1>     cmp ch, 3       ;Are we divisible by 3?
   537 000006BA 750F                <1>     jne .skipSep
   538 000006BC 4038CE              <1>     cmp sil, cl
   539 000006BF 742A                <1>     je .exitErr     ;Before we add a comma, do we have space?
   540                              <1>     ;mov dl, byte [ctryData + countryStruc.thouSep]
   541                              <1>     ;mov byte [rdi], dl
   542 000006C1 C6072C              <1>     mov byte [rdi], ","
   543 000006C4 48FFC7              <1>     inc rdi 
   544 000006C7 FEC1                <1>     inc cl          ;Inc number of chars
   545 000006C9 30ED                <1>     xor ch, ch      ;Reset comma counter
   546                              <1> .skipSep:
   547 000006CB 4038CE              <1>     cmp sil, cl
   548 000006CE 741B                <1>     je .exitErr     ;Before we add a digit, do we have space?
   549 000006D0 31D2                <1>     xor edx, edx
   550 000006D2 48F7F3              <1>     div rbx         ;Divide rax by 10
   551 000006D5 80C230              <1>     add dl, "0"     
   552 000006D8 8817                <1>     mov byte [rdi], dl
   553 000006DA 48FFC7              <1>     inc rdi
   554 000006DD FEC1                <1>     inc cl          ;Inc number of chars
   555 000006DF FEC5                <1>     inc ch          ;Inc to keep track of commas
   556 000006E1 4885C0              <1>     test rax, rax
   557 000006E4 75D1                <1>     jnz .lp
   558                              <1> ;The test cleared CF if we are here
   559 000006E6 0FB6C9              <1>     movzx ecx, cl
   560                              <1> .exit:
   561 000006E9 5F                  <1>     pop rdi
   562                              <1>     return
