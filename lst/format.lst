   559                              <1> makeBS:
   560                              <1> ;Makes a bootsector from the newly initialised bpb @ bpbPtr
   561 000008A3 488B1D0D0A0000      <1>     mov rbx, qword [pBuffer]    
   562 000008AA 4889DF              <1>     mov rdi, rbx    ;Point rdi to the buffer
   563                              <1> ;Now copy the default bootsector into the buffer. We require 512 byte
   564                              <1> ; boot sectors. If the sector size of the medium is less than 512 bytes
   565                              <1> ; then we skip the boot sector writing phase, instead just copying the
   566                              <1> ; BPB to the sector at the normal location. The jump bytes are 0 too.
   567 000008AD 66813D360A00000002  <1>     cmp word [sectorSize], 512
   568 000008B6 7316                <1>     jae .doBS
