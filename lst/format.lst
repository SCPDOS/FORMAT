   542 000006DF BB0A000000          <1>     mov ebx, 0Ah    ;Divide by 10
   543                              <1> .lp:
   544 000006E4 80FD03              <1>     cmp ch, 3       ;Are we divisible by 3?
   545 000006E7 750F                <1>     jne .skipSep
   546 000006E9 4038CE              <1>     cmp sil, cl
   547 000006EC 742A                <1>     je .exitErr     ;Before we add a comma, do we have space?
   548                              <1>     ;mov dl, byte [ctryData + countryStruc.thouSep]
   549                              <1>     ;mov byte [rdi], dl
   550 000006EE C6072C              <1>     mov byte [rdi], ","
   551 000006F1 48FFC7              <1>     inc rdi 
   552 000006F4 FEC1                <1>     inc cl          ;Inc number of chars
   553 000006F6 30ED                <1>     xor ch, ch      ;Reset comma counter
   554                              <1> .skipSep:
   555 000006F8 4038CE              <1>     cmp sil, cl
   556 000006FB 741B                <1>     je .exitErr     ;Before we add a digit, do we have space?
   557 000006FD 31D2                <1>     xor edx, edx
   558 000006FF 48F7F3              <1>     div rbx         ;Divide rax by 10
   559 00000702 80C230              <1>     add dl, "0"     
   560 00000705 8817                <1>     mov byte [rdi], dl
   561 00000707 48FFC7              <1>     inc rdi
   562 0000070A FEC1                <1>     inc cl          ;Inc number of chars
   563 0000070C FEC5                <1>     inc ch          ;Inc to keep track of commas
   564 0000070E 4885C0              <1>     test rax, rax
   565 00000711 75D1                <1>     jnz .lp
   566                              <1> ;The test cleared CF if we are here
   567 00000713 0FB6C9              <1>     movzx ecx, cl
   568                              <1> .exit:
   569 00000716 5F                  <1>     pop rdi
   570                              <1>     return
