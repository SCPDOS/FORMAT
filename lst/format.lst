     4                              <1> doYNWait:
     5                              <1> ;This does the below but also outputs a new line to 
     6                              <1> ; indicate that input has been recieved.
     7 00000A3B E80F000000          <1>     call .doWait
     8 00000A40 9C                  <1>     pushfq
     9 00000A41 488D15810B0000      <1>     lea rdx, crlfStr
    10 00000A48 E8AAFCFFFF          <1>     call printString    ;Output a new line!
    11 00000A4D 9D                  <1>     popfq
