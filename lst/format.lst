   337 00000DA5 B8FFFFFFFF          <1>     mov eax, -1
   338 00000DAA 894704              <1>     mov dword [rdi + 4], eax
   339                              <1> .exit:
   340 00000DAD 5B                  <1>     pop rbx
   341 00000DAE 58                  <1>     pop rax
   342                              <1>     return
