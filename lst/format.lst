   963                              <1> 
   964                              <1> checkBreak:
   965                              <1> ;Checks if control C has been struck and triggers Int 23h.
   966                              <1> ;21h/0Bh does a non-blocking check of the keyboard buffer status.
   967                              <1> ;If there is a Ctrl+C waiting in buffer, it triggers Int 23h.
   968                              <1> ;If the user then doesn't want to exit the program, it reenters 
   969                              <1> ; the call to check the keyboard status which will just return 
   970                              <1> ; if the buffer is full or empty.
   971                              <1> ;If no Ctrl+C waiting in the buffer, it just return the keyboard status.
   972 00000A37 B8000B0000          <1>     mov eax, 0B00h
   973 00000A3C CD21                <1>     int 21h
   974                              <1>     return
    13                              <2> %%_ret:
    14 00000A3E C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   975                              <1> 
   976                              <1> exitOk:
   977 00000A3F B8004C0000          <1>     mov eax, 4C00h
   978 00000A44 CD21                <1>     int 21h
   979                              <1> exitError:
   980 00000A46 B8044C0000          <1>     mov eax, 4C04h
   981 00000A4B CD21                <1>     int 21h
   982                              <1> exitNoFormatFixed:
   983 00000A4D B8054C0000          <1>     mov eax, 4C05h
   984 00000A52 CD21                <1>     int 21h
   985                              <1> 
   986                              <1> readSector:
   987                              <1> ;Input:
   988                              <1> ;ecx = Number of sectors to read
   989                              <1> ;rdx = Start LBA to read from
   990 00000A54 E8DEFFFFFF          <1>     call checkBreak
   991 00000A59 8A0573000000        <1>     mov al, byte [fmtDrive]     ; Always read from fmtDrive
   992 00000A5F 488B1D76000000      <1>     mov rbx, qword [bufferArea] ; Memory Buffer address to read from
   993 00000A66 CD25                <1>     int 25h
   994 00000A68 58                  <1>     pop rax ;Pop old flags into rax
   995                              <1>     return
    13                              <2> %%_ret:
    14 00000A69 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   996                              <1> writeSector:
   997                              <1> ;Input:
   998                              <1> ;ecx = Number of sectors to write
   999                              <1> ;rdx = Start LBA to write to
  1000 00000A6A E8C8FFFFFF          <1>     call checkBreak
  1001 00000A6F E8D9FBFFFF          <1>     call writeStatusUpdate      ; Update the percentage done message!
  1002 00000A74 8A0558000000        <1>     mov al, byte [fmtDrive]     ; Always write to fmtDrive
  1003 00000A7A 488B1D5B000000      <1>     mov rbx, qword [bufferArea] ; Memory Buffer address to read from
  1004 00000A81 48FF0590000000      <1>     inc qword [secWritten]  ;Always inc even if failed. Bad sectors get marked.
  1005 00000A88 CD26                <1>     int 26h
  1006 00000A8A 58                  <1>     pop rax ;Pop old flags into rax
  1007                              <1>     return
    13                              <2> %%_ret:
    14 00000A8B C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1008                              <1> 
  1009                              <1> setDriveAccess:
  1010                              <1> ;For now, I will simply force drive access on!
  1011 00000A8C C60581010000FF      <1>     mov byte [accFlgPkt + accFlgBlk.bAccMode], -1
  1012 00000A93 EB07                <1>     jmp short resetDriveAccess.cmn
  1013                              <1> resetDriveAccess:
  1014 00000A95 C6057801000000      <1>     mov byte [accFlgPkt + accFlgBlk.bAccMode], 0
