    65 00000000 <res 10h>           <1>     .fcb1       db 16 dup (?)  ;First FCB,    argument 1 
    66 00000010 <res 14h>           <1>     .fcb2       db 20 dup (?)  ;Second FCB,   argument 2
    67                              <1>     .dta:   ;Pointer to the default DTA in the PSP
    68 00000024 ??                  <1>     .parmList   db ?   ;Number of characters in command tail
    69 00000025 <res 7Fh>           <1>     .progTail   db 127 dup (?) ;Default DTA/Program tail
