   276                              <1> cleanBuffer:
   277                              <1> ;Cleans the sector buffer
   278 00000CC5 488B3D21030000      <1>     mov rdi, qword [pBuffer]
   279 00000CCC 0FB70D40030000      <1>     movzx ecx, word [sectorSize]
   280 00000CD3 31C0                <1>     xor eax, eax
   281 00000CD5 F3AA                <1>     rep stosb   ;Clean the Sector buffer
   282                              <1>     return
