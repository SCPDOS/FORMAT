   350                              <1> 
   351                              <1> prepBPB:
   352                              <1> ;Selects a file system for the medium and makes a correct bootsector 
   353                              <1> ; for it. Sets up necessary internal variables.
   354                              <1> ;Input: rdi -> Current BPB as reported by the driver.
   355                              <1> ;       qword [bpbPtr] = Same as rdi.
   356                              <1> ;       
   357                              <1> ;Output: Update the BPB pointed to by rdi.
   358                              <1> ;        Set all internal BPB vars.
   359                              <1> ;
   360                              <1> ;We trust the returned BPB even for FAT12 floppies, as even if the media 
   361                              <1> ; doesn't have a BPB on it, the driver will return one to us. The format 
   362                              <1> ; operation will then lay a fresh BPB on the media too.
   363                              <1> ;This means we convert old floppies to the new, better format.
   364                              <1> ;We also convert all drives to 512 bytes (unless it has 4096).
   365                              <1> 
   366                              <1> ;Start by ensuring that we always set the number of FATs to 2!
   367 0000065F C6470502            <1>     mov byte [rdi + bpb.numFATs], 2
   368                              <1>     ;movzx ebx, word [rdi + bpb.bytsPerSec]
   369                              <1>     ;mov word [sectorSize], bx 
   370 00000663 66C705800C00000002  <1>     mov word [sectorSize], 512
   371 0000066C 0FB6470A            <1>     movzx eax, byte [rdi + bpb.media]
   372 00000670 8805850C0000        <1>     mov byte [media], al
   373 00000676 0FB64702            <1>     movzx eax, byte [rdi + bpb.secPerClus]  ;Store the reported secPerClus val
   374 0000067A 8805760C0000        <1>     mov byte [secPerClust], al
   375 00000680 8B4711              <1>     mov eax, dword [rdi + bpb.hiddSec]
   376 00000683 8905730C0000        <1>     mov dword [hiddSector], eax
   377 00000689 0FB74708            <1>     movzx eax, word [rdi + bpb.totSec16]
   378 0000068D 8B4F15              <1>     mov ecx, dword [rdi + bpb.totSec32]
   379 00000690 85C0                <1>     test eax, eax   ;If totSec16 is 0, use totSec32
   380 00000692 0F44C1              <1>     cmovz eax, ecx
   381 00000695 488905520C0000      <1>     mov qword [numSectors], rax
   382                              <1> 
   383 0000069C 488D1D2D150000      <1>     lea rbx, bootloader     ;Now set the source bootloader.
   384 000006A3 48891D310C0000      <1>     mov qword [pBtLdr], rbx ;And store it. If FAT32, we will adjust below
   385                              <1> ;Now we select the FAT based on the size of the volume.
   386                              <1> ;If a hard drive, it is automatically a FAT 16 or 32 media.
   387                              <1> fatSelect:
   388 000006AA C605290C000000      <1>     mov byte [fatType], fs_fat12   ;Init fatType to be FAT 12
   389 000006B1 F605210C0000FF      <1>     test byte [fixDev], -1
   390 000006B8 752C                <1>     jnz .notFat12
   391                              <1> ;If removable, check media byte.
   392                              <1> ; If media byte known (F9h-FFh), we trust the driver data as these
   393                              <1> ; come from tables we know to be FAT12 OK.
   394                              <1> ; If media byte F0h, we again treat this as a marker to trust whatever 
   395                              <1> ; the driver gave us but we check FAT12 compliance.
   396                              <1> ;   If F0h volume compliant, we setup for FAT12.
   397                              <1> ; Else, use FAT16.
   398 000006BA 803D3A0C0000F9      <1>     cmp byte [media], 0F9h
   399 000006C1 7712                <1>     ja .medOk
   400 000006C3 803D310C0000F0      <1>     cmp byte [media], 0F0h
   401 000006CA 751A                <1>     jne .notFat12
   402                              <1> ;Now we check if the number of clusters on this volume is for FAT12. If so,
