   492                              <1> printDecimalValLB:
   493                              <1> ;Takes a value in rax and prints it's decimal representation with leading
   494                              <1> ; blanks and inserts commas where appropriate.
   495                              <1> ;Input: rax = Value to print
   496                              <1> ;       rcx = Buffer size to handle (usual values: 17 for max, 13 for dword)
   497 00000681 4889E5              <1>     mov rbp, rsp
   498 00000684 4829CC              <1>     sub rsp, rcx ;Allocate the buffer on the stack
   499 00000687 4889EF              <1>     mov rdi, rbp
   500 0000068A 4829CF              <1>     sub rdi, rcx
   501 0000068D 50                  <1>     push rax
   502 0000068E 51                  <1>     push rcx
   503 0000068F 57                  <1>     push rdi
   504 00000690 31C0                <1>     xor eax, eax
   505 00000692 F3AA                <1>     rep stosb   ;Initialise the buffer with a null value
   506 00000694 5F                  <1>     pop rdi     ;Now set the ptr to the head of the buffer
   507 00000695 59                  <1>     pop rcx
   508 00000696 58                  <1>     pop rax
   509 00000697 51                  <1>     push rcx    ;Save this value to keep the buffer length
   510 00000698 E83E000000          <1>     call decimalise   ;If return with CF=CY, error!
   511 0000069D 59                  <1>     pop rcx     ;Now print the buffer
   512 0000069E 4889EF              <1>     mov rdi, rbp
   513 000006A1 48FFCF              <1>     dec rdi     ;Doesn't affect CF
   514 000006A4 722C                <1>     jc .errPrint    ;Print a mis-aligned ? to clearly mark an error!
   515                              <1> .skipLp:
   516 000006A6 8A1F                <1>     mov bl, byte [rdi]
   517 000006A8 84DB                <1>     test bl, bl ;Any leading null's get replaced with a space
   518 000006AA 7514                <1>     jne .printLp
   519 000006AC B220                <1>     mov dl, " "
   520 000006AE E8F5020000          <1>     call putch
   521 000006B3 48FFCF              <1>     dec rdi
   522 000006B6 FFC9                <1>     dec ecx
   523 000006B8 81F901000000        <1>     cmp ecx, 1
   524 000006BE 75E6                <1>     jne .skipLp   ;Always print 1 byte for size
   525                              <1> .printLp:
   526 000006C0 8A17                <1>     mov dl, byte [rdi]
   527 000006C2 E8E1020000          <1>     call putch
   528 000006C7 48FFCF              <1>     dec rdi
