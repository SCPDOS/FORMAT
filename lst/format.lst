   878                              <1> 
   879                              <1> breakRoutine:
   880                              <1> ;This subroutine is called by ^C
   881                              <1> ;Prompts the user for what they want to do.
   882                              <1> ;Preserve registers across call.
   883                              <1> ;
   884                              <1> ;We always return IRETQ which means we always execute the 
   885                              <1> ; function code that we return to DOS in eax. Unless we wish
   886                              <1> ; to terminate, we just re-attempt the function that was 
   887                              <1> ; ^C-ed.
   888                              <1> ;
   889 0000099D 52                  <1>     push rdx
   890 0000099E 50                  <1>     push rax
   891 0000099F 488D1596050000      <1>     lea rdx, cancel
   892 000009A6 E8C0FFFFFF          <1>     call doYNWait       ;If ret CF=NC, we said yes so exit! Else just redo op!
   893 000009AB 720C                <1>     jc .noAbort
   894 000009AD E80F010000          <1>     call dosCrit1Exit   ;Exit the critical section since we are quitting
   895 000009B2 58                  <1>     pop rax
   896 000009B3 B8034C0000          <1>     mov eax, 4C03h      ;Tell DOS to terminate with error level 3
   897 000009B8 50                  <1>     push rax
   898                              <1> ;Let DOS reclaim memory and handles allocated to us
   899                              <1> .noAbort:
   900 000009B9 B20A                <1>     mov dl, LF
   901 000009BB E867000000          <1>     call putch
   902 000009C0 58                  <1>     pop rax
   903 000009C1 5A                  <1>     pop rdx
   904 000009C2 48CF                <1>     iretq   ;Redo the operation
   905                              <1> 
