   236                              <1> decimalise:
   237                              <1> ;Input: rax = value to decimalise
   238                              <1> ;       rdi -> Ptr to byte buffer to store string in with commas
   239                              <1> ;       ecx = buffer length
   240                              <1> ;Output: Buffer @ rdi filled in! 
   241                              <1> ;       ecx = Number of chars in buffer.
   242                              <1> ; Warning: If the number of chars in the buffer reaches buffer length,
   243                              <1> ;   we return with CF=CY. Else, CF=NC.
   244 000009EF 57                  <1>     push rdi
   245 000009F0 89CE                <1>     mov esi, ecx    
   246 000009F2 31C9                <1>     xor ecx, ecx    ;Use cl as buffer length ctr, ch as comma ctr
   247 000009F4 BB0A000000          <1>     mov ebx, 0Ah    ;Divide by 10
   248                              <1> .lp:
   249 000009F9 80FD03              <1>     cmp ch, 3       ;Are we divisible by 3?
   250 000009FC 750F                <1>     jne .skipSep
   251 000009FE 4038CE              <1>     cmp sil, cl
   252 00000A01 742A                <1>     je .exitErr     ;Before we add a comma, do we have space?
   253                              <1>     ;mov dl, byte [ctryData + countryStruc.thouSep]
   254                              <1>     ;mov byte [rdi], dl
   255 00000A03 C6072C              <1>     mov byte [rdi], ","
   256 00000A06 48FFC7              <1>     inc rdi 
   257 00000A09 FEC1                <1>     inc cl          ;Inc number of chars
   258 00000A0B 30ED                <1>     xor ch, ch      ;Reset comma counter
   259                              <1> .skipSep:
   260 00000A0D 4038CE              <1>     cmp sil, cl
   261 00000A10 741B                <1>     je .exitErr     ;Before we add a digit, do we have space?
   262 00000A12 31D2                <1>     xor edx, edx
   263 00000A14 48F7F3              <1>     div rbx         ;Divide rax by 10
   264 00000A17 80C230              <1>     add dl, "0"     
   265 00000A1A 8817                <1>     mov byte [rdi], dl
   266 00000A1C 48FFC7              <1>     inc rdi
   267 00000A1F FEC1                <1>     inc cl          ;Inc number of chars
   268 00000A21 FEC5                <1>     inc ch          ;Inc to keep track of commas
   269 00000A23 4885C0              <1>     test rax, rax
   270 00000A26 75D1                <1>     jnz .lp
   271                              <1> ;The test cleared CF if we are here
   272 00000A28 0FB6C9              <1>     movzx ecx, cl
   273                              <1> .exit:
   274 00000A2B 5F                  <1>     pop rdi
   275                              <1>     return
