    19 00000F9D FF                  <1> fatType     db -1       ;0 = FAT12, 1 = FAT16, 2 = FAT32, -1 = No FAT
    20 00000F9E 0002                <1> sectorSize  dw 512      ;Sector size in bytes: HARDCODED BYTES PER SECTOR VALUE
    21 00000FA0 0000000000000000    <1> numSectors  dq 0        ;Number of sectors in volume
    22 00000FA8 00                  <1> secPerClust db 0        ;Copy the sectors per cluster over
    23 00000FA9 00000000            <1> fatSize     dd 0        ;FAT size (number of sectors per FAT)
    24 00000FAD F0                  <1> media       db 0F0h     ;Media type (F0h or F8h)
    25 00000FAE 0000000000000000    <1> bpbPtr      dq 0        ;Pointer to the buffer for the BPB (in IOCTL block)
    26 00000FB6 00                  <1> bpbSize     db 0        ;Size of the BPB
    27 00000FB7 00000000            <1> hiddSector  dd 0        ;Only used for Fixed Disks, offset to add
    28 00000FBB 00000000            <1> f32RootClus dd 0        ;Cluster addr of the root dir cluster if FAT32
    29 00000FBF 00000000            <1> dSerNum     dd 0        ;Serial number
    30 00000FC3 00000000            <1> dBadClust   dd 0        ;Number of bad clusters on disk
    31                              <1> 
