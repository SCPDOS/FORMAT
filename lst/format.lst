   515                              <1> breakRoutine:
   516                              <1> ;This subroutine is called by ^C
   517                              <1> ;Prompts the user for what they want to do.
   518                              <1> ;Preserve registers across call.
   519                              <1> ;
   520                              <1> ;We always return IRETQ which means we always execute the 
   521                              <1> ; function code that we return to DOS in eax. Unless we wish
   522                              <1> ; to terminate, we just re-attempt the function that was 
   523                              <1> ; ^C-ed.
   524                              <1> ;
   525 00000678 52                  <1>     push rdx
   526 00000679 50                  <1>     push rax
   527 0000067A 488D15A00A0000      <1>     lea rdx, cancel
