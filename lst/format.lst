    82 00000A93 1200                <1>     at .secPerTrk,   dw 0012h        ;18 Sectors per track
    83 00000A95 0200                <1>     at .numHeads,    dw 0002h        ;2 Heads
    84 00000A97 FFFFFFFF            <1>     at .hiddSec,     dd -1           ;No hidden sectors on removable
    85 00000A9B 00000000            <1>     at .totSec32,    dd 0            ;Not a FAT32 BPB '
