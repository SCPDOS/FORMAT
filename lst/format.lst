    27 000007FE 7446                <1>     je .switchFnd
    28                              <1> ;This must be a drive letter and the next char must be a colon, else error.
    29 00000800 0FB6D0              <1>     movzx edx, al  ;Save the drive letter in dl
    30 00000803 E8AD010000          <1>     call readChar 
    31 00000808 0F8489060000        <1>     je badParamExit ;Cannot end with just a letter
    32 0000080E 3C3A                <1>     cmp al, ":"
