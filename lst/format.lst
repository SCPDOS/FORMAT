   591                              <1> checkBreak:
   592                              <1> ;Checks if control C has been struck and triggers Int 23h.
   593                              <1> ;21h/0Bh does a non-blocking check of the keyboard buffer status.
   594                              <1> ;If there is a Ctrl+C waiting in buffer, it triggers Int 23h.
   595                              <1> ;If the user then doesn't want to exit the program, it reenters 
   596                              <1> ; the call to check the keyboard status which will just return 
   597                              <1> ; if the buffer is full or empty.
   598                              <1> ;If no Ctrl+C waiting in the buffer, it just return the keyboard status.
   599 000006FF B8000B0000          <1>     mov eax, 0B00h
   600 00000704 CD21                <1>     int 21h
   601                              <1>     return
    13                              <2> %%_ret:
    14 00000706 C3                  <2>  ret
