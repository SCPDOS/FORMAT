    37                              <1> ;Tables
    38                              <1> ;All data here is RO.
    39                              <1> ;Each row is 5 bytes, {DWORD, BYTE} with DWORD = diskSize, BYTE=secPerClusVal
    40                              <1> ;This table assumes a 512 byte sector (fair assumption) but we do a byte size
    41                              <1> ; comparison in format to eventually allow for other sized sectors
    42                              <1> fat16ClusterTable:
    43 0000104D 00A04100            <1>     dd 8400*512 ;Disks up to 4.1MB, must use FAT12 with 0.5 K clusters
    44 00001051 01                  <1>     db 1    ;ALL FAT12 uses 1, unless it is a preexisting meddesc type medium
    45 00001052 0050FF00            <1>     dd 32680*512    ; Disk up to 16MB, 1K clusters
    46 00001056 02                  <1>     db 2
    47 00001057 00000008            <1>     dd 262144*512   ; Disk up to 128MB, 2K clusters
    48 0000105B 04                  <1>     db 4
    49 0000105C 00000010            <1>     dd 524288*512   ; Disk up to 256MB, 4K clusters
    50 00001060 08                  <1>     db 8
    51 00001061 00000020            <1>     dd 1048576*512  ; Disk up to 512Mb, 8K clusters
    52 00001065 10                  <1>     db 16
    53                              <1> 
