   295                              <1> getASCIINumber:
   296                              <1> ;Accumulates the value in ebx and returns it.
   297                              <1> ;First char read must be a digit, else, we treat a non-digit
   298                              <1> ; as a terminator of the number. 
   299                              <1> ;If the value is greater than 32 bits, treat as invalid input
   300 000009DF 31DB                <1>     xor ebx, ebx
   301 000009E1 E8A4FFFFFF          <1>     call readChar    ;First char after : must be a digit
   302 000009E6 E844000000          <1>     call isAlDigit
   303 000009EB 0F822D050000        <1>     jc badParamExit
   304                              <1> .lp:
   305 000009F1 250F000000          <1>     and eax, 0Fh    ;Save lower nybble only and zero the rest of the register
   306 000009F6 89DD                <1>     mov ebp, ebx    ;Dont use lea because we cant check for carry
   307 000009F8 C1E302              <1>     shl ebx, 2      ;4*ebx
   308 000009FB 0F821D050000        <1>     jc badParamExit
   309 00000A01 01EB                <1>     add ebx, ebp    ;5*ebx
   310 00000A03 0F8215050000        <1>     jc badParamExit
   311 00000A09 D1E3                <1>     shl ebx, 1      ;10*ebx
   312 00000A0B 0F820D050000        <1>     jc badParamExit
   313 00000A11 01C3                <1>     add ebx, eax    ;Add new digit value
   314 00000A13 0F8205050000        <1>     jc badParamExit
   315 00000A19 85C9                <1>     test ecx, ecx   ;Stop if we run out of chars to process
   316                              <1>     retz
    41                              <2> cret z
