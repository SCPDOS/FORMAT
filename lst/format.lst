    28                              <1> ;--------------------------------------
    29                              <1> ;          Utility functions          :
    30                              <1> ;--------------------------------------
    31                              <1> writeDiskStats:
    32                              <1> ;Writes the disk statistics after a format.
    33                              <1> ;-------------------------------------------------------
    34                              <1> ;<Number> bytes total disk space
    35                              <1> ;<Number> bytes used by system (if /S set and system files installed)
    36                              <1> ;<Number> bytes in bad sectors (if bad sectors. Always rounds to # of clusters)
    37                              <1> ;<Number> bytes available on disk 
    38                              <1> ;
    39                              <1> ;<Number> bytes in each allocation unit.
    40                              <1> ;<Number> allocation units available on disk. ;alloc units are clusters
    41                              <1> ;
    42                              <1> ;Volume Serial Number is <Serial-Number>
    43                              <1> ;-------------------------------------------------------
    44                              <1> ;Start start by putting a new line
    45 00000A6D 488D15550B0000      <1>     lea rdx, crlfStr
    46 00000A74 E87EFCFFFF          <1>     call printString
    47                              <1> ;Start by getting free sector count from DOS. We do this to make the 
    48                              <1> ; computation of the free sector count easier after /s and if any bad clusters.
    49 00000A79 B800360000          <1>     mov eax, 3600h  ;Get free space count
    50 00000A7E 0FB6155E050000      <1>     movzx edx, byte [fmtDrive]
    51 00000A85 FFC2                <1>     inc edx ;Turn into a 1 based count
    52 00000A87 CD21                <1>     int 21h
    53                              <1> ;If we have a FAT 32 drive, add one cluster to the free count to account for
    54                              <1> ; the root directory cluster.
    55 00000A89 803D8205000002      <1>     cmp byte [fatType], fs_fat32
    56 00000A90 7502                <1>     jne .goSave
    57 00000A92 FFC3                <1>     inc ebx ;Discount the root directory from initial count!
    58                              <1> .goSave:
    59                              <1> ;Use x64 regs instead of stack frame
    60 00000A94 4989D0              <1>     mov r8, rdx ;r8 = Total cluster count in data area
    61 00000A97 4989D9              <1>     mov r9, rbx ;r9 = Free cluster count in the data area
    62                              <1> ;Total number of bytes, ebx still has total count
    63 00000A9A 0FB6057C050000      <1>     movzx eax, byte [secPerClust]
    64 00000AA1 0FB70D6B050000      <1>     movzx ecx, word [sectorSize]
    65 00000AA8 F7E1                <1>     mul ecx     ;Get the number of bytes per cluster in eax
    66 00000AAA 4989C2              <1>     mov r10, rax    ;Save this value in r10
    67 00000AAD 49F7E0              <1>     mul r8      ;Get in eax the number of bytes on disk
    68 00000AB0 E868010000          <1>     call printDecimalDword
    69 00000AB5 488D15ED0B0000      <1>     lea rdx, totalBytesStr
    70 00000ABC E836FCFFFF          <1>     call printString
    71                              <1> ;System bytes
    72 00000AC1 F6052D05000002      <1>     test byte [bFlag1], bitSystem
    73 00000AC8 741E                <1>     jz .skipSystem
    74 00000ACA 4C89C9              <1>     mov rcx, r9     ;Get the free cluster count
    75 00000ACD 4C89C0              <1>     mov rax, r8     ;Get the total cluster count
    76 00000AD0 29C8                <1>     sub eax, ecx    ;Workout the amount of space taken by system files
    77 00000AD2 4C89D1              <1>     mov rcx, r10    ;Get word BytesPerClust
    78 00000AD5 F7E1                <1>     mul ecx         ;Get the number of bytes taken by system files
    79 00000AD7 E841010000          <1>     call printDecimalDword
    80 00000ADC 488D15E00B0000      <1>     lea rdx, sysBytesStr
    81 00000AE3 E80FFCFFFF          <1>     call printString
    82                              <1> .skipSystem:
    83                              <1> ;Bad cluster bytes
    84 00000AE8 8B0D4A050000        <1>     mov ecx, dword [dBadClust]
    85 00000AEE 85C9                <1>     test ecx, ecx
    86 00000AF0 741B                <1>     jz .skipBad
    87 00000AF2 4C89C0              <1>     mov rax, r8     ;Get the total cluster count
    88 00000AF5 29C8                <1>     sub eax, ecx
    89 00000AF7 4C89D1              <1>     mov rcx, r10    ;Get word BytesPerClust
    90 00000AFA F7E1                <1>     mul ecx         ;Get the number of bytes taken by bad clusters
    91 00000AFC E81C010000          <1>     call printDecimalDword
    92 00000B01 488D15D30B0000      <1>     lea rdx, badSectStr
    93 00000B08 E8EAFBFFFF          <1>     call printString
    94                              <1> .skipBad:
    95                              <1> ;Free bytes
    96 00000B0D 4C89C8              <1>     mov rax, r9     ;Get free cluster count
    97 00000B10 4C89D1              <1>     mov rcx, r10    ;Get word BytesPerClust
    98 00000B13 F7E1                <1>     mul ecx         ;Get the number of free bytes
    99 00000B15 E803010000          <1>     call printDecimalDword
   100 00000B1A 488D15D20B0000      <1>     lea rdx, availableBytesStr
   101 00000B21 E8D1FBFFFF          <1>     call printString
   102                              <1> ;Bytes per cluster
   103 00000B26 4C89D0              <1>     mov rax, r10    ;Get word BytesPerClust
   104 00000B29 E8EF000000          <1>     call printDecimalDword
   105 00000B2E 488D15DA0B0000      <1>     lea rdx, clustSzStr
   106 00000B35 E8BDFBFFFF          <1>     call printString
   107                              <1> ;Number of clusters
   108 00000B3A 4C89C0              <1>     mov rax, r8     ;Get the total cluster count
   109 00000B3D E8DB000000          <1>     call printDecimalDword
   110 00000B42 488D15E80B0000      <1>     lea rdx, totClusStr
   111 00000B49 E8A9FBFFFF          <1>     call printString
   112                              <1> ;Vol Serial Number
   113 00000B4E 488D15040C0000      <1>     lea rdx, volSerialNumStr
   114 00000B55 E89DFBFFFF          <1>     call printString
   115 00000B5A 488D35D3040000      <1>     lea rsi, qword [dSerNum]
   116 00000B61 AC                  <1>     lodsb
   117 00000B62 E829000000          <1>     call printHexByte
   118 00000B67 AC                  <1>     lodsb
   119 00000B68 E823000000          <1>     call printHexByte
   120 00000B6D BA2D000000          <1>     mov edx, "-"
   121 00000B72 E878FBFFFF          <1>     call putch
   122 00000B77 AC                  <1>     lodsb
   123 00000B78 E813000000          <1>     call printHexByte
   124 00000B7D AC                  <1>     lodsb
   125 00000B7E E80D000000          <1>     call printHexByte
   126                              <1> ;We are done so print a new line :)
   127 00000B83 488D153F0A0000      <1>     lea rdx, crlfStr
   128 00000B8A E868FBFFFF          <1>     call printString    ;Output a new line!
   129                              <1>     return
    13                              <2> %%_ret:
    14 00000B8F C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   130                              <1> 
   131                              <1> printHexByte:
   132 00000B90 488D1D1E000000      <1>     lea rbx, .tbl
   133 00000B97 50                  <1>     push rax
   134 00000B98 C1E804              <1>     shr eax, 4  ;Move nybble down
   135 00000B9B E807000000          <1>     call .phn
   136 00000BA0 58                  <1>     pop rax
   137 00000BA1 E801000000          <1>     call .phn
   138                              <1>     return
    13                              <2> %%_ret:
    14 00000BA6 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   139                              <1> .phn:
   140                              <1> ;Prints hex nybble in al.
   141 00000BA7 250F000000          <1>     and eax, 0Fh    ;Save lower nybble only
   142 00000BAC D7                  <1>     xlatb
   143 00000BAD 89C2                <1>     mov edx, eax
   144 00000BAF E83BFBFFFF          <1>     call putch
   145                              <1>     return
    13                              <2> %%_ret:
    14 00000BB4 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
