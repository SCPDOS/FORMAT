    63                                  %include "./dat/fmtData.asm"
     1                              <1> ;IOCTL request header
     2                              <1> reqTable:
     3                              <1>     istruc lbaParamsBlock
     4 000009C5 20                  <1>         at .bSize,          db lbaParamsBlock_size
     5 000009C6 01                  <1>         at .bSpecFuncs,     db 1    ;Get info for current partition
     6 000009C7 0000                <1>         at .wDevFlgs,       dw 0
     7 000009C9 0000                <1>         at .wFSType,        dw 0
     8 000009CB 0000                <1>         at .wRes,           dw 0
     9 000009CD 0000000000000000    <1>         at .qSectorSize,    dq 0
    10 000009D5 0000000000000000    <1>         at .qNumSectors,    dq 0
    11 000009DD 0000000000000000    <1>         at .qStartSector,   dq 0
    12                              <1>     iend
    13                              <1> accFlgPkt:
    14                              <1>     istruc accFlgBlk
    15 000009E5 00                  <1>         at .bSpecFuncs, db 0
    16 000009E6 00                  <1>         at .bAccMode,   db 0    ;If 0, disable access. If -1, enable.
    17                              <1>     iend
    18                              <1> ;Data area here
    19 000009E7 FF                  <1> fmtDrive    db -1       ;Drive we are operating on (0 based)
    20 000009E8 00                  <1> inCrit      db 0        ;If not 0, in a critical section, must exit
    21 000009E9 0000000000000000    <1> cdsPtr      dq 0        ;CDS ptr here
    22 000009F1 0000000000000000    <1> bufferArea  dq 0        ;Ptr to the buffer area
    23                              <1> ;HARDCODED TO BE QUICK FORMAT FOR NOW
    24 000009F9 FF                  <1> quickByte   db -1       ;If /Q, don't zero all sectors first. Set if /Q.
    25                              <1> ;Format Data here
    26 000009FA 00                  <1> remDev      db 0        ;0 = Removable, -1 = Fixed
    27 000009FB FF                  <1> fatType     db -1       ;0 = FAT12, 1 = FAT16, 2 = FAT32, -1 = No FAT
    28 000009FC 0000                <1> sectorSize  dw 0        ;Sector size in bytes
    29 000009FE 0000000000000000    <1> numSectors  dq 0        ;Number of sectors in volume
    30 00000A06 00                  <1> secPerClust db 0        ;Copy the sectors per cluster over
    31 00000A07 00000000            <1> fatSize     dd 0        ;FAT size (number of sectors per FAT)
    32 00000A0B F0                  <1> media       db 0F0h     ;Media type (F0h or F8h)
    33 00000A0C 0000000000000000    <1> bpbPointer  dq 0        ;Pointer to the BPB we will use
    34 00000A14 00                  <1> bpbSize     db 0        ;Size of the BPB
    35 00000A15 00000000            <1> hiddSector  dd 0        ;Only used for Fixed Disks, offset to add
    36                              <1> 
    37 00000A19 0000000000000000    <1> loaderPtr   dq 0        ;Point to the bootloader to use
    38                              <1> 
    39 00000A21 00000000            <1> f32RootClus dd 0        ;Cluster addr of the root dir cluster if FAT32
    40                              <1> 
    41                              <1> ;Tracking vars, used only for updating the percentage message!
    42 00000A25 0000000000000000    <1> secToWrite  dq 0        ;Number of sectors to write (neq numSectors if /Q set)
    43 00000A2D 0000000000000000    <1> secWritten  dq 0        ;Number of sectors written so far
    44 00000A35 FF                  <1> secPercent  db -1       ;The previous percentage (-1 not initialised)
    45                              <1> 
    46                              <1> ;Tables
    47                              <1> ;Each row is 5 bytes, {DWORD, BYTE} with DWORD = diskSize, BYTE=secPerClusVal
    48                              <1> ;This table assumes a 512 byte sector (fair assumption) but we do a byte size
    49                              <1> ; comparison in format to eventually allow for other sized sectors
    50                              <1> fat16ClusterTable:
    51 00000A36 00A04100            <1>     dd 8400*512 ;Disks up to 4.1MB, must use FAT12 with 0.5 K clusters
    52 00000A3A 01                  <1>     db 1    ;ALL FAT12 uses 1, unless it is a preexisting meddesc type medium
    53 00000A3B 0050FF00            <1>     dd 32680*512    ; Disk up to 16MB, 1K clusters
    54 00000A3F 02                  <1>     db 2
    55 00000A40 00000008            <1>     dd 262144*512   ; Disk up to 128MB, 2K clusters
    56 00000A44 04                  <1>     db 4
    57 00000A45 00000010            <1>     dd 524288*512   ; Disk up to 256MB, 4K clusters
    58 00000A49 08                  <1>     db 8
    59 00000A4A 00000020            <1>     dd 1048576*512  ; Disk up to 512Mb, 8K clusters
    60 00000A4E 10                  <1>     db 16
    61                              <1> 
    62                              <1> ;Here DWORD becomes QWORD
    63                              <1> fat32ClusterTable:
    64 00000A4F 0000000002000000    <1>     dq 16777216*512 ; Disk up to 8GB, 4K clusters
    65 00000A57 08                  <1>     db 8        
    66 00000A58 0000000004000000    <1>     dq 33554432*512 ; Disk up to 16GB, 8K clusters
    67 00000A60 10                  <1>     db 16
    68 00000A61 0000000008000000    <1>     dq 67108864*512 ; Disk up to 32Gb, 16K clusters
    69 00000A69 20                  <1>     db 32
    70 00000A6A FFFFFFFFFFFFFFFF    <1>     dq -1       ; Disk up to 2TB, 32K clusters
    71 00000A72 40                  <1>     db 64
    72                              <1> 
    73                              <1> ;Static BPBs here, fields set to -1 must be edited.
    74                              <1> ;Fields with a preset value should NOT be touched.
    75                              <1> genericBPB12:
    76                              <1>     istruc bpb
    77 00000A73 FFFF                <1>     at .bytsPerSec,  dw -1           ;512 bytes per sector, normally
    78 00000A75 FF                  <1>     at .secPerClus,  db -1           ;1 sector per cluster, normally
    79 00000A76 0100                <1>     at .revdSecCnt,  dw 0001h        ;1 Reserved Sector
    80 00000A78 02                  <1>     at .numFATs,     db 02h          ;2 FAT tables
    81 00000A79 E000                <1>     at .rootEntCnt,  dw 00E0h        ;224 root entries
    82 00000A7B FFFF                <1>     at .totSec16,    dw -1           ;Total number of sectors on disk
    83 00000A7D F0                  <1>     at .media,       db 0F0h         ;Media byte
    84 00000A7E FFFF                <1>     at .FATsz16,     dw -1           ;9 FAT sectors, normally
    85 00000A80 1200                <1>     at .secPerTrk,   dw 0012h        ;18 Sectors per track
    86 00000A82 0200                <1>     at .numHeads,    dw 0002h        ;2 Heads
    87 00000A84 FFFFFFFF            <1>     at .hiddSec,     dd -1           ;No hidden sectors on removable
    88 00000A88 00000000            <1>     at .totSec32,    dd 0            ;Not a FAT32 BPB '
    89                              <1>     iend
    90                              <1>     istruc extBs 
    91 00000A8C FF                  <1>     at .drvNum,         db -1   ;Set to 0 for Remdev, 80h for fixed disk
    92 00000A8D 00                  <1>     at .reserved1,      db 00h
    93 00000A8E 29                  <1>     at .bootSig,        db extBsSig ;Normal signature
    94 00000A8F FFFFFFFF            <1>     at .volId,          dd -1       ;Set to date/time @ format
    95 00000A93 4E4F204E414D452020- <1>     at .volLab,         db 'NO NAME    '    
    95 00000A9C 2020                <1>
    96 00000A9E 4641543132202020    <1>     at .filSysType,     db 'FAT12   '
    97                              <1>     iend
    98                              <1> 
    99                              <1> 
