   531                              <1> decimalise:
   532                              <1> ;Input: rax = value to decimalise
   533                              <1> ;       rdi -> Ptr to byte buffer to store string in with commas
   534                              <1> ;       ecx = buffer length
   535                              <1> ;Output: Buffer @ rdi filled in! 
   536                              <1> ;       ecx = Number of chars in buffer.
   537                              <1> ; Warning: If the number of chars in the buffer reaches buffer length,
   538                              <1> ;   we return with CF=CY. Else, CF=NC.
   539 000006DA 57                  <1>     push rdi
   540 000006DB 89CE                <1>     mov esi, ecx    
