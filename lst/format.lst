   608 0000076A 742A                <1>     je .fat32
   609 0000076C 488B35FF020000      <1>     mov rsi, qword [bpbPointer]
   610 00000773 0FB74606            <1>     movzx eax, word [rsi + bpb.rootEntCnt]  ;Number of 32 bit entries
   611 00000777 C1E005              <1>     shl eax, 5  ;Get number of bytes in root dir
