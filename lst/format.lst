    83 000007CF FFFFFFFF            <1>     at .volId,          dd -1       ;Set to date/time @ format
    84 000007D3 4E4F204E414D452020- <1>     at .volLab,         db 'NO NAME    '    
    84 000007DC 2020                <1>
    85 000007DE 4641543132202020    <1>     at .filSysType,     db 'FAT12   '
    86                              <1>     iend
