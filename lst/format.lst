   308 00000A8F C1E005              <1>     shl eax, 5  ;Get number of bytes in root dir
   309 00000A92 0FB736              <1>     movzx esi, word [rsi + bpb.bytsPerSec]
   310 00000A95 31D2                <1>     xor edx, edx
