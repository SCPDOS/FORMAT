   933                              <1> syncBpb:
   934                              <1> ;Input: al[0] = Set if to lock bpb. Clear if to unlock bpb.
   935                              <1> ;Output: Returns if ok. Doesn't return if something went wrong.
   936                              <1> ;       Handles errors internally and exits.
   937 000009FB B940080000          <1>     mov ecx, 0840h          ;Disk drive type IOCTL, set FAT parameters
   938 00000A00 0D04000000          <1>     or eax, specFuncSec     ;We only format media to all sectors equal size
