   648                              <1> breakRoutine:
   649                              <1> ;This subroutine is called by ^C
   650                              <1> ;Prompts the user for what they want to do.
   651 00000795 488D1508020000      <1>     lea rdx, cancel
   652 0000079C B409                <1>     mov ah, 09h
   653 0000079E CD21                <1>     int 21h
   654 000007A0 B401                <1>     mov ah, 01h ;Get a char
   655 000007A2 CD21                <1>     int 21h
   656 000007A4 3C79                <1>     cmp al, "y"
   657 000007A6 740C                <1>     je short .breakReturnExit
   658 000007A8 3C59                <1>     cmp al, "Y"
   659 000007AA 7408                <1>     je short .breakReturnExit
   660 000007AC 3C6E                <1>     cmp al, "n"
   661 000007AE 740E                <1>     je short .breakReturnNoExit
   662 000007B0 3C4E                <1>     cmp al, "N"
   663 000007B2 EBE1                <1>     jmp short breakRoutine 
   664                              <1> .breakReturnExit:
   665 000007B4 804C241001          <1>     or byte [rsp + 8*2], 1  ;Set CF on the stack flags
   666 000007B9 E8CDFFFFFF          <1>     call dosCrit1Exit   ;Exit the critical section since we are quitting
   667                              <1> .breakReturnNoExit:
   668 000007BE 48CF                <1>     iretq   ;Redo the operation
