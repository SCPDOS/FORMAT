   249                              <1> ;Output: rsi points to the first non-delimiter char
   250                              <1> ;       ecx = Chars left to process after skipping
   251                              <1> ;       ZF=ZE: No more chars left to process
   252                              <1> ;       ZF=NZ: Chars left to process
