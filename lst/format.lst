   535                              <1> .errPrint:
   536                              <1> ;Print a default ? symbol if an overflow occurs.
   537 000006CC B23F                <1>     mov dl, "?"
   538 000006CE E8CF020000          <1>     call putch
   539 000006D3 EBF3                <1>     jmp short .exit
