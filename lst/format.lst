   609                              <1> writeFATStartSig:
   610                              <1> ;Writes the first two cluster blocks with the necessary signature
   611                              <1> ;Input: rdi -> Start of the FAT sector
   612 00000782 50                  <1>     push rax
   613 00000783 53                  <1>     push rbx
   614 00000784 488B1D81020000      <1>     mov rbx, qword [bpbPointer]
   615 0000078B 0FBE430A            <1>     movsx eax, byte [rbx + bpb.media]   ;Get the media byte, sign extend
   616 0000078F 803D6502000001      <1>     cmp byte [fatType], 1
   617 00000796 7407                <1>     je .fat16
   618 00000798 7709                <1>     ja .fat32
   619                              <1> ;Fat 12 here
   620 0000079A 25FFFFFF00          <1>     and eax, 00FFFFFFh  ;Save only low three bytes
   621                              <1> .fat16:
   622 0000079F 8907                <1>     mov dword [rdi], eax
   623 000007A1 EB0A                <1>     jmp short .exit
   624                              <1> .fat32:
   625 000007A3 8907                <1>     mov dword [rdi], eax
   626 000007A5 B8FFFFFFFF          <1>     mov eax, -1
   627 000007AA 894704              <1>     mov dword [rdi + 4], eax
   628                              <1> .exit:
   629 000007AD 5B                  <1>     pop rbx
   630 000007AE 58                  <1>     pop rax
   631                              <1>     return
