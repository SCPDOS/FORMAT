   183                              <1> printDecimalValLB:
   184                              <1> ;Takes a value in rax and prints it's decimal representation with leading
   185                              <1> ; blanks and inserts commas where appropriate.
   186                              <1> ;Input: rax = Value to print
   187                              <1> ;       rcx = Buffer size to handle (usual values: 17 for max, 13 for dword)
   188 00000C2A 4889E5              <1>     mov rbp, rsp
   189 00000C2D 4829CC              <1>     sub rsp, rcx ;Allocate the buffer on the stack
   190 00000C30 4889EF              <1>     mov rdi, rbp
   191 00000C33 4829CF              <1>     sub rdi, rcx
   192 00000C36 50                  <1>     push rax
   193 00000C37 51                  <1>     push rcx
   194 00000C38 57                  <1>     push rdi
   195 00000C39 31C0                <1>     xor eax, eax
   196 00000C3B F3AA                <1>     rep stosb   ;Initialise the buffer with a null value
   197 00000C3D 5F                  <1>     pop rdi     ;Now set the ptr to the head of the buffer
   198 00000C3E 59                  <1>     pop rcx
   199 00000C3F 58                  <1>     pop rax
   200 00000C40 51                  <1>     push rcx    ;Save this value to keep the buffer length
   201 00000C41 E83E000000          <1>     call decimalise   ;If return with CF=CY, error!
   202 00000C46 59                  <1>     pop rcx     ;Now print the buffer
   203 00000C47 4889EF              <1>     mov rdi, rbp
   204 00000C4A 48FFCF              <1>     dec rdi     ;Doesn't affect CF
   205 00000C4D 722C                <1>     jc .errPrint    ;Print a mis-aligned ? to clearly mark an error!
   206                              <1> .skipLp:
   207 00000C4F 8A1F                <1>     mov bl, byte [rdi]
   208 00000C51 84DB                <1>     test bl, bl ;Any leading null's get replaced with a space
   209 00000C53 7514                <1>     jne .printLp
   210 00000C55 B220                <1>     mov dl, " "
   211 00000C57 E893FAFFFF          <1>     call putch
   212 00000C5C 48FFCF              <1>     dec rdi
   213 00000C5F FFC9                <1>     dec ecx
   214 00000C61 81F901000000        <1>     cmp ecx, 1
   215 00000C67 75E6                <1>     jne .skipLp   ;Always print 1 byte for size
   216                              <1> .printLp:
   217 00000C69 8A17                <1>     mov dl, byte [rdi]
   218 00000C6B E87FFAFFFF          <1>     call putch
   219 00000C70 48FFCF              <1>     dec rdi
   220 00000C73 FFC9                <1>     dec ecx
   221 00000C75 75F2                <1>     jnz .printLp
   222                              <1> .exit:
   223 00000C77 4889EC              <1>     mov rsp, rbp    ;Deallocate the buffer and exit!
   224                              <1>     return
    13                              <2> %%_ret:
    14 00000C7A C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   225                              <1> .errPrint:
   226                              <1> ;Print a default ? symbol if an overflow occurs.
   227 00000C7B B23F                <1>     mov dl, "?"
   228 00000C7D E86DFAFFFF          <1>     call putch
   229 00000C82 EBF3                <1>     jmp short .exit
