    37                              <1> ;Tables
    38                              <1> ;All data here is RO.
    39                              <1> ;Each row is 5 bytes, {DWORD, BYTE} with DWORD = diskSize, BYTE=secPerClusVal
    40                              <1> ;This table assumes a 512 byte sector (fair assumption) but we do a byte size
    41                              <1> ; comparison in format to eventually allow for other sized sectors
    42                              <1> fat16ClusterTable:
    43 00000FC6 00A04100            <1>     dd 8400*512 ;Disks up to 4.1MB, must use FAT12 with 0.5 K clusters
    44 00000FCA 01                  <1>     db 1    ;ALL FAT12 uses 1, unless it is a preexisting meddesc type medium
    45 00000FCB 0050FF00            <1>     dd 32680*512    ; Disk up to 16MB, 1K clusters
    46 00000FCF 02                  <1>     db 2
    47 00000FD0 00000008            <1>     dd 262144*512   ; Disk up to 128MB, 2K clusters
    48 00000FD4 04                  <1>     db 4
