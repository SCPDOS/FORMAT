   128 00000B9E 3F00                <1>     at .secPerTrk,   dw 003Fh        ;FAT16 and 32 have Hard disk geometry 
   129 00000BA0 FF00                <1>     at .numHeads,    dw 00FFh        ;255 Heads
   130 00000BA2 FFFFFFFF            <1>     at .hiddSec,     dd -1           ;No hidden sectors on removable
   131 00000BA6 00000000            <1>     at .totSec32,    dd 0            ;Not a FAT32 BPB
   132                              <1>     iend
   133                              <1>     istruc extBs 
   134 00000BAA FF                  <1>     at .drvNum,         db -1   ;Set to 0 for Remdev, 80h for fixed disk
   135 00000BAB 00                  <1>     at .reserved1,      db 00h
   136 00000BAC 29                  <1>     at .bootSig,        db extBsSig ;Normal signature
   137 00000BAD FFFFFFFF            <1>     at .volId,          dd -1       ;Set to date/time @ format
   138 00000BB1 4E4F204E414D452020- <1>     at .volLab,         db 'NO NAME    '    
   138 00000BBA 2020                <1>
   139 00000BBC 4641543136202020    <1>     at .filSysType,     db 'FAT16   '
