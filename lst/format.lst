   661                              <1> computeFATSize:
   662                              <1> ; ;Works on the genericBPB in memory. Applies the following algorithm
   663                              <1> ; RootDirSectors = ((BPB_RootEntCnt * 32) + (BPB_BytsPerSec – 1)) / BPB_BytsPerSec;
   664                              <1> ; TmpVal1 = DskSize – (BPB_ResvdSecCnt + RootDirSectors);
   665                              <1> ; TmpVal2 = (256 * BPB_SecPerClus) + BPB_NumFATs;
   666                              <1> ; If(FATType == FAT32)
   667                              <1> ;   TmpVal2 = TmpVal2 / 2;
   668                              <1> ; FATSz = (TMPVal1 + (TmpVal2 – 1)) / TmpVal2;
   669                              <1> ;Input:
   670                              <1> ;   rdi = Pointer to the head of the BPB we are using
   671                              <1> ;Returns: 
   672                              <1> ;   eax = Number of sectors per FAT needed. Low word only valid for FAT12/16
   673 000007F1 53                  <1>     push rbx
   674 000007F2 51                  <1>     push rcx
   675 000007F3 52                  <1>     push rdx
   676 000007F4 57                  <1>     push rdi
   677                              <1>     
   678 000007F5 0FB74706            <1>     movzx eax, word [rdi + bpb.rootEntCnt]
   679 000007F9 C1E005              <1>     shl eax, 5  ;Multiply by 32
   680 000007FC 0FB71F              <1>     movzx ebx, word [rdi + bpb.bytsPerSec]
   681 000007FF FFCB                <1>     dec ebx
   682 00000801 01D8                <1>     add eax, ebx
   683 00000803 FFC3                <1>     inc ebx
   684 00000805 31D2                <1>     xor edx, edx
   685 00000807 F7F3                <1>     div ebx
   686 00000809 89C2                <1>     mov edx, eax    ;edx = RootDirSectors
   687                              <1> 
   688 0000080B 0FB74708            <1>     movzx eax, word [rdi + bpb.totSec16]
   689 0000080F 8B5F15              <1>     mov ebx, dword [rdi + bpb.totSec32]
   690 00000812 85C0                <1>     test eax, eax   ;If totSec16 is 0, move totSec32 into eax
   691 00000814 0F44C3              <1>     cmovz eax, ebx
   692 00000817 0FB75F03            <1>     movzx ebx, word [rdi + bpb.revdSecCnt]
   693 0000081B 01D3                <1>     add ebx, edx    ;Add RootDirSectors
   694 0000081D 29D8                <1>     sub eax, ebx
   695 0000081F 89C1                <1>     mov ecx, eax    ;ecx = TmpVal1
   696                              <1> 
   697 00000821 0FB64702            <1>     movzx eax, byte [rdi + bpb.secPerClus]
   698 00000825 C1E008              <1>     shl eax, 8  ;multiply by 256
   699 00000828 0FB65F05            <1>     movzx ebx, byte [rdi + bpb.numFATs]
   700 0000082C 01C3                <1>     add ebx, eax    ;ebx = TmpVal2
   701                              <1> 
   702 0000082E 803D3202000002      <1>     cmp byte [fatType], 2
   703 00000835 7502                <1>     jne .notFat32
   704 00000837 D1EB                <1>     shr ebx, 1  ;Divide by 2
   705                              <1> .notFat32: 
   706 00000839 89C8                <1>     mov eax, ecx    ;TmpVal1
   707 0000083B FFCB                <1>     dec ebx
   708 0000083D 01D8                <1>     add eax, ebx    ;TmpVal1 + (TmpVal2 - 1)
   709 0000083F FFC3                <1>     inc ebx
   710 00000841 31D2                <1>     xor edx, edx
   711 00000843 F7F3                <1>     div ebx ;Exit with eax = number of sectors needed per FAT
   712                              <1> .exit:
   713 00000845 5F                  <1>     pop rdi
   714 00000846 5A                  <1>     pop rdx
   715 00000847 59                  <1>     pop rcx
   716 00000848 5B                  <1>     pop rbx
   717                              <1>     return
    13                              <2> %%_ret:
    14 00000849 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
