   301                              <1> prepPrintVals:
   302                              <1> ;Compute secToDo and initialise secDone and secPercent.
   303                              <1> ;Input: ebx = 0 means prep for one full verify
   304                              <1> ;       ebx = 1 means prep for verify, clean, and write of file system area
   305                              <1> ;Output: vars initialised.
   306 0000111C 31C0                <1>     xor eax, eax
   307 0000111E 4889050D020000      <1>     mov qword [secDone], rax   ;Initialised for when multiple formats
   308 00001125 C6050E020000FF      <1>     mov byte [secPercent], -1
   309 0000112C 85DB                <1>     test ebx, ebx
