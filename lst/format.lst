   112                              <1> computeFSVals:
   113                              <1> ;Computes various meta-data related to the format we have selected.
   114                              <1> ;Output:
   115                              <1> ;   byte [bNumDirSect], number of sectors in the root directory initially
   116                              <1> ;   dword [dFSAreaSz],  size of reserved section + 2 FATs + initial root dir
   117                              <1> ;   qword [qDataAreaSz], number of sectors in the data section
   118 000003B9 0FB74603            <1>     movzx eax, word [rsi + bpb.revdSecCnt]  ;Get reserved count
   119 000003BD 89C3                <1>     mov ebx, eax    ;Set reserved count
   120 000003BF 8B05320F0000        <1>     mov eax, dword [fatSize]
   121 000003C5 D1E0                <1>     shl eax, 1      ;Multiply this value by 2 for two FATs
   122 000003C7 01C3                <1>     add ebx, eax
   123 000003C9 803D0A0F000002      <1>     cmp byte [fatType], fs_fat32
   124 000003D0 743D                <1>     je .fat32
   125                              <1> ;Add the sectors for the root directory
   126 000003D2 488B350A0F0000      <1>     mov rsi, qword [bpbPtr]
   127 000003D9 0FB74606            <1>     movzx eax, word [rsi + bpb.rootEntCnt]  ;Number of 32 bit entries
   128 000003DD C1E005              <1>     shl eax, 5  ;Get number of bytes in root dir
   129 000003E0 0FB736              <1>     movzx esi, word [rsi + bpb.bytsPerSec]
   130 000003E3 31D2                <1>     xor edx, edx
   131 000003E5 F7F6                <1>     div esi ;Get number of whole sectors in eax. edx is remainder. 
   132 000003E7 85D2                <1>     test edx, edx   ;If no remainder (should never be a remainder), proceed
   133 000003E9 7403                <1>     jz .final
   134 000003EB 48FFC0              <1>     inc rax  ;Add one for remainder
   135                              <1> .final:
   136                              <1> ;Come here with rbx = rolling count of sectors and 
   137                              <1> ; al = Number of sectors in the root directory initially.
   138 000003EE 8805140F0000        <1>     mov byte [bNumDirSect], al
   139 000003F4 4801C3              <1>     add rbx, rax    ;Add to rolling count
   140 000003F7 891D0C0F0000        <1>     mov dword [dFSAreaSz], ebx
   141 000003FD 488B05EA0E0000      <1>     mov rax, qword [numSectors]
   142 00000404 4829D8              <1>     sub rax, rbx
   143 00000407 488905FF0E0000      <1>     mov qword [qDataAreaSz], rax
   144                              <1>     return
