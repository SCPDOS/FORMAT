    20                              <1> checkBreak:
    21                              <1> ;Checks if control C has been struck and triggers Int 23h.
    22                              <1> ;21h/0Bh does a non-blocking check of the keyboard buffer status.
    23                              <1> ;If there is a Ctrl+C waiting in buffer, it triggers Int 23h.
    24                              <1> ;If the user then doesn't want to exit the program, it reenters 
    25                              <1> ; the call to check the keyboard status which will just return 
    26                              <1> ; if the buffer is full or empty.
    27                              <1> ;If no Ctrl+C waiting in the buffer, it just return the keyboard status.
    28 00000E90 B8000B0000          <1>     mov eax, 0B00h
    29 00000E95 CD21                <1>     int 21h
    30                              <1>     return
    13                              <2> %%_ret:
    14 00000E97 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
