   624                              <1> checkBreak:
   625                              <1> ;Checks if control C has been struck and triggers Int 23h.
   626                              <1> ;21h/0Bh does a non-blocking check of the keyboard buffer status.
   627                              <1> ;If there is a Ctrl+C waiting in buffer, it triggers Int 23h.
   628                              <1> ;If the user then doesn't want to exit the program, it reenters 
   629                              <1> ; the call to check the keyboard status which will just return 
   630                              <1> ; if the buffer is full or empty.
   631                              <1> ;If no Ctrl+C waiting in the buffer, it just return the keyboard status.
   632 00000739 B8000B0000          <1>     mov eax, 0B00h
   633 0000073E CD21                <1>     int 21h
   634                              <1>     return
    13                              <2> %%_ret:
