   284                              <1> prepPrintVals:
   285                              <1> ;Compute secToWrite and initialise secWritten and secPercent.
   286 00000CD8 31C0                <1>     xor eax, eax
   287 00000CDA 48890563030000      <1>     mov qword [secWritten], rax   ;Initialised for when multiple formats
   288 00000CE1 C60564030000FF      <1>     mov byte [secPercent], -1
   289 00000CE8 F6050603000001      <1>     test byte [bFlag1], bitQuick  ;If quick set, won't process rest of disk.
   290 00000CEF 750F                <1>     jnz .quick
   291 00000CF1 488B051D030000      <1>     mov rax, qword [numSectors]
   292 00000CF8 4889053D030000      <1>     mov qword [secToWrite], rax
   293                              <1>     return
    13                              <2> %%_ret:
    14 00000CFF C3                  <2>  ret
