   783 00000900 E89B000000          <1>     call getch
   784 00000905 3C79                <1>     cmp al, "y"
   785 00000907 740F                <1>     je .yes
   786 00000909 3C59                <1>     cmp al, "Y"
   787 0000090B 740B                <1>     je .yes
   788 0000090D 3C6E                <1>     cmp al, "n"
   789 0000090F 7408                <1>     je .no
   790 00000911 3C4E                <1>     cmp al, "N"
   791 00000913 7404                <1>     je .no
