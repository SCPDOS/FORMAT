   231                              <1> decimalise:
   232                              <1> ;Input: rax = value to decimalise
   233                              <1> ;       rdi -> Ptr to byte buffer to store string in with commas
   234                              <1> ;       ecx = buffer length
   235                              <1> ;Output: Buffer @ rdi filled in! 
   236                              <1> ;       ecx = Number of chars in buffer.
   237                              <1> ; Warning: If the number of chars in the buffer reaches buffer length,
   238                              <1> ;   we return with CF=CY. Else, CF=NC.
   239 00000C84 57                  <1>     push rdi
   240 00000C85 89CE                <1>     mov esi, ecx    
   241 00000C87 31C9                <1>     xor ecx, ecx    ;Use cl as buffer length ctr, ch as comma ctr
   242 00000C89 BB0A000000          <1>     mov ebx, 0Ah    ;Divide by 10
   243                              <1> .lp:
   244 00000C8E 80FD03              <1>     cmp ch, 3       ;Are we divisible by 3?
   245 00000C91 750F                <1>     jne .skipSep
   246 00000C93 4038CE              <1>     cmp sil, cl
   247 00000C96 742A                <1>     je .exitErr     ;Before we add a comma, do we have space?
   248                              <1>     ;mov dl, byte [ctryData + countryStruc.thouSep]
   249                              <1>     ;mov byte [rdi], dl
   250 00000C98 C6072C              <1>     mov byte [rdi], ","
   251 00000C9B 48FFC7              <1>     inc rdi 
   252 00000C9E FEC1                <1>     inc cl          ;Inc number of chars
   253 00000CA0 30ED                <1>     xor ch, ch      ;Reset comma counter
   254                              <1> .skipSep:
   255 00000CA2 4038CE              <1>     cmp sil, cl
   256 00000CA5 741B                <1>     je .exitErr     ;Before we add a digit, do we have space?
   257 00000CA7 31D2                <1>     xor edx, edx
   258 00000CA9 48F7F3              <1>     div rbx         ;Divide rax by 10
   259 00000CAC 80C230              <1>     add dl, "0"     
   260 00000CAF 8817                <1>     mov byte [rdi], dl
   261 00000CB1 48FFC7              <1>     inc rdi
   262 00000CB4 FEC1                <1>     inc cl          ;Inc number of chars
   263 00000CB6 FEC5                <1>     inc ch          ;Inc to keep track of commas
   264 00000CB8 4885C0              <1>     test rax, rax
   265 00000CBB 75D1                <1>     jnz .lp
   266                              <1> ;The test cleared CF if we are here
   267 00000CBD 0FB6C9              <1>     movzx ecx, cl
   268                              <1> .exit:
   269 00000CC0 5F                  <1>     pop rdi
   270                              <1>     return
    13                              <2> %%_ret:
    14 00000CC1 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   271                              <1> .exitErr:
   272 00000CC2 F9                  <1>     stc
   273 00000CC3 EBFB                <1>     jmp short .exit
   274                              <1> 
