    58                                  %include "./dat/fmtData.asm"
     1                              <1> ;IOCTL request header
     2                              <1> reqTable:
     3                              <1>     istruc lbaParamsBlock
     4 000009D8 20                  <1>         at .bSize,          db lbaParamsBlock_size
     5 000009D9 01                  <1>         at .bSpecFuncs,     db 1    ;Get info for current partition
     6 000009DA 0000                <1>         at .wDevFlgs,       dw 0
     7 000009DC 0000                <1>         at .wFSType,        dw 0
     8 000009DE 0000                <1>         at .wRes,           dw 0
     9 000009E0 0000000000000000    <1>         at .qSectorSize,    dq 0
    10 000009E8 0000000000000000    <1>         at .qNumSectors,    dq 0
    11 000009F0 0000000000000000    <1>         at .qStartSector,   dq 0
    12                              <1>     iend
    13                              <1> 
    14                              <1> ;Data area here
    15 000009F8 FF                  <1> fmtDrive    db -1       ;Drive we are operating on (0 based)
    16 000009F9 00                  <1> inCrit      db 0        ;If not 0, in a critical section, must exit
    17 000009FA 0000000000000000    <1> cdsPtr      dq 0        ;CDS ptr here
    18 00000A02 0000000000000000    <1> bufferArea  dq 0        ;Ptr to the buffer area
    19                              <1> ;HARDCODED TO BE QUICK FORMAT FOR NOW
    20 00000A0A FF                  <1> quickByte   db -1       ;If /Q, don't zero all sectors first. Set if /Q.
    21                              <1> ;Format Data here
    22 00000A0B 00                  <1> remDev      db 0        ;0 = Removable, -1 = Fixed
    23 00000A0C FF                  <1> fatType     db -1       ;0 = FAT12, 1 = FAT16, 2 = FAT32, -1 = No FAT
    24 00000A0D 0000                <1> sectorSize  dw 0        ;Sector size in bytes
    25 00000A0F 0000000000000000    <1> numSectors  dq 0        ;Number of sectors in volume
    26 00000A17 00                  <1> secPerClust db 0        ;Copy the sectors per cluster over
    27 00000A18 00000000            <1> fatSize     dd 0        ;FAT size (number of sectors per FAT)
    28 00000A1C F0                  <1> media       db 0F0h     ;Media type (F0h or F8h)
    29 00000A1D 0000000000000000    <1> bpbPointer  dq 0        ;Pointer to the BPB we will use
    30 00000A25 00                  <1> bpbSize     db 0        ;Size of the BPB
    31 00000A26 00000000            <1> hiddSector  dd 0        ;Only used for Fixed Disks, offset to add
    32                              <1> 
    33 00000A2A 0000000000000000    <1> loaderPtr   dq 0        ;Point to the bootloader to use
    34 00000A32 0000                <1> loaderBytes dw 0        ;Number of bytes to copy
    35                              <1> 
    36 00000A34 00000000            <1> f32RootClus dd 0        ;Cluster addr of the root dir cluster if FAT32
    37                              <1> 
    38                              <1> ;Tracking vars, used only for updating the percentage message!
    39 00000A38 0000000000000000    <1> secToWrite  dq 0        ;Number of sectors to write (neq numSectors if /Q set)
    40 00000A40 0000000000000000    <1> secWritten  dq 0        ;Number of sectors written so far
    41 00000A48 FF                  <1> secPercent  db -1       ;The previous percentage (-1 not initialised)
    42                              <1> 
    43                              <1> ;Tables
    44                              <1> ;Each row is 5 bytes, {DWORD, BYTE} with DWORD = diskSize, BYTE=secPerClusVal
    45                              <1> ;This table assumes a 512 byte sector (fair assumption) but we do a byte size
    46                              <1> ; comparison in format to eventually allow for other sized sectors
    47                              <1> fat16ClusterTable:
    48 00000A49 00A04100            <1>     dd 8400*512 ;Disks up to 4.1MB, must use FAT12 with 0.5 K clusters
    49 00000A4D 01                  <1>     db 1    ;ALL FAT12 uses 1, unless it is a preexisting meddesc type medium
    50 00000A4E 0050FF00            <1>     dd 32680*512    ; Disk up to 16MB, 1K clusters
    51 00000A52 02                  <1>     db 2
