   352 00000D90 0FB7C1              <1>     movzx eax, cx
   353 00000D93 C1E310              <1>     shl ebx, 10h
   354 00000D96 09D8                <1>     or eax, ebx
   355 00000D98 5B                  <1>     pop rbx
   356                              <1>     return
