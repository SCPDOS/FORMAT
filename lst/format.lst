   217                              <1> findDelimiter:
   218                              <1> ;Goes to the next delimiter.
   219                              <1> ;Input: rsi must point to the start of the data string
   220                              <1> ;       ecx = Number of chars left to to process
   221                              <1> ;Output: rsi points to the first non-delimiter char
   222                              <1> ;       ecx = Chars left to process after skipping
   223                              <1> ;       ZF=ZE: No more chars left to process
   224                              <1> ;       ZF=NZ: Chars left to process
   225 000009BD 50                  <1>     push rax
   226                              <1> .l1:
   227 000009BE E8F2FFFFFF          <1>     call readChar
   228 000009C3 740C                <1>     je .exit2
