   614 00000774 FFC0                <1>     inc eax ;Add one for the bootsector
   615 00000776 480105A1020000      <1>     add qword [secToWrite], rax ;Add whole sectors and bootsector to count
   616 0000077D 85D2                <1>     test edx, edx   ;If no remainder (should never be a remainder), exit
   617                              <1>     retz
