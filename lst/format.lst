   822                              <1> 
   823                              <1> checkBreak:
   824                              <1> ;Checks if control C has been struck and triggers Int 23h.
   825                              <1> ;21h/0Bh does a non-blocking check of the keyboard buffer status.
   826                              <1> ;If there is a Ctrl+C waiting in buffer, it triggers Int 23h.
   827                              <1> ;If the user then doesn't want to exit the program, it reenters 
   828                              <1> ; the call to check the keyboard status which will just return 
   829                              <1> ; if the buffer is full or empty.
   830                              <1> ;If no Ctrl+C waiting in the buffer, it just return the keyboard status.
   831 0000092A B8000B0000          <1>     mov eax, 0B00h
   832 0000092F CD21                <1>     int 21h
   833                              <1>     return
    13                              <2> %%_ret:
    14 00000931 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
