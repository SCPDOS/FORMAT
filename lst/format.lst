    37                              <1> ;Tables
    38                              <1> ;All data here is RO.
    39                              <1> ;Each row is 5 bytes, {DWORD, BYTE} with DWORD = diskSize, BYTE=secPerClusVal
    40                              <1> ;This table assumes a 512 byte sector (fair assumption) but we do a byte size
    41                              <1> ; comparison in format to eventually allow for other sized sectors
    42                              <1> fat16ClusterTable:
    43 00000FD8 00A04100            <1>     dd 8400*512 ;Disks up to 4.1MB, must use FAT12 with 0.5 K clusters
    44 00000FDC 01                  <1>     db 1    ;ALL FAT12 uses 1, unless it is a preexisting meddesc type medium
    45 00000FDD 0050FF00            <1>     dd 32680*512    ; Disk up to 16MB, 1K clusters
    46 00000FE1 02                  <1>     db 2
    47 00000FE2 00000008            <1>     dd 262144*512   ; Disk up to 128MB, 2K clusters
    48 00000FE6 04                  <1>     db 4
    49 00000FE7 00000010            <1>     dd 524288*512   ; Disk up to 256MB, 4K clusters
    50 00000FEB 08                  <1>     db 8
    51 00000FEC 00000020            <1>     dd 1048576*512  ; Disk up to 512Mb, 8K clusters
    52 00000FF0 10                  <1>     db 16
    53                              <1> 
    54                              <1> ;Here DWORD becomes QWORD
    55                              <1> fat32ClusterTable:
    56 00000FF1 0000000002000000    <1>     dq 16777216*512 ; Disk up to 8GB, 4K clusters
    57 00000FF9 08                  <1>     db 8        
    58 00000FFA 0000000004000000    <1>     dq 33554432*512 ; Disk up to 16GB, 8K clusters
    59 00001002 10                  <1>     db 16
    60 00001003 0000000008000000    <1>     dq 67108864*512 ; Disk up to 32Gb, 16K clusters
    61 0000100B 20                  <1>     db 32
    62 0000100C FFFFFFFFFFFFFFFF    <1>     dq -1       ; Disk up to 2TB, 32K clusters
    63 00001014 40                  <1>     db 64
