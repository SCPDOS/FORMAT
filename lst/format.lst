   188                              <1> printDecimalValLB:
   189                              <1> ;Takes a value in rax and prints it's decimal representation with leading
   190                              <1> ; blanks and inserts commas where appropriate.
   191                              <1> ;Input: rax = Value to print
   192                              <1> ;       rcx = Buffer size to handle (usual values: 17 for max, 13 for dword)
   193 00000995 4889E5              <1>     mov rbp, rsp
   194 00000998 4829CC              <1>     sub rsp, rcx ;Allocate the buffer on the stack
   195 0000099B 4889EF              <1>     mov rdi, rbp
   196 0000099E 4829CF              <1>     sub rdi, rcx
   197 000009A1 50                  <1>     push rax
   198 000009A2 51                  <1>     push rcx
   199 000009A3 57                  <1>     push rdi
   200 000009A4 31C0                <1>     xor eax, eax
   201 000009A6 F3AA                <1>     rep stosb   ;Initialise the buffer with a null value
   202 000009A8 5F                  <1>     pop rdi     ;Now set the ptr to the head of the buffer
   203 000009A9 59                  <1>     pop rcx
   204 000009AA 58                  <1>     pop rax
   205 000009AB 51                  <1>     push rcx    ;Save this value to keep the buffer length
   206 000009AC E83E000000          <1>     call decimalise   ;If return with CF=CY, error!
   207 000009B1 59                  <1>     pop rcx     ;Now print the buffer
   208 000009B2 4889EF              <1>     mov rdi, rbp
   209 000009B5 48FFCF              <1>     dec rdi     ;Doesn't affect CF
   210 000009B8 722C                <1>     jc .errPrint    ;Print a mis-aligned ? to clearly mark an error!
   211                              <1> .skipLp:
   212 000009BA 8A1F                <1>     mov bl, byte [rdi]
   213 000009BC 84DB                <1>     test bl, bl ;Any leading null's get replaced with a space
   214 000009BE 7514                <1>     jne .printLp
   215 000009C0 B220                <1>     mov dl, " "
   216 000009C2 E83CFDFFFF          <1>     call putch
   217 000009C7 48FFCF              <1>     dec rdi
   218 000009CA FFC9                <1>     dec ecx
   219 000009CC 81F901000000        <1>     cmp ecx, 1
   220 000009D2 75E6                <1>     jne .skipLp   ;Always print 1 byte for size
   221                              <1> .printLp:
