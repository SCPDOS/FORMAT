   160 00000BEA 31D2                <1>     xor edx, edx
   161 00000BEC 48F7F3              <1>     div rbx ;Get percentage of written sectors in rax (formally al)
   162 00000BEF 3A0557040000        <1>     cmp al, byte [secPercent]
   163 00000BF5 7423                <1>     je .exit    ;If they are equal, dont bother printing again
   164                              <1> ;Here we have a new percentage! Update the message!
   165 00000BF7 88054F040000        <1>     mov byte [secPercent], al
   166 00000BFD B903000000          <1>     mov ecx, 3  ;Max 3 chars to print (up to 100)
