   153                              <1> writeStatusUpdate:
   154 00000BD2 51                  <1>     push rcx
   155 00000BD3 52                  <1>     push rdx
   156 00000BD4 488B0569040000      <1>     mov rax, qword [secWritten]
   157 00000BDB BB64000000          <1>     mov ebx, 100
   158 00000BE0 48F7E3              <1>     mul rbx ;Multiply number of sectors by 100
