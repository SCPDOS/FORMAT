   777                              <1> doYNWait:
   778                              <1> ;Input: rdx -> String to wait for Y/N on.
   779                              <1> ;Output: CF=NC -> N
   780                              <1> ;        CF=CY -> Y
   781 000008FA 52                  <1>     push rdx
