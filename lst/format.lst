     4 00000F70 0000000000000000    <1> cdsPtr      dq 0        ;CDS ptr here
     5 00000F78 0000000000000000    <1> pBuffer     dq 0        ;Ptr to the buffer area
     6 00000F80 01                  <1> bFlag1      db bitQuick ;HARDCODED TO BE QUICK FORMAT FOR NOW
