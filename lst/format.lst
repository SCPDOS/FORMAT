   746                              <1> badExitCmn:
   747                              <1> ;Jumped to with rdx = Error message or 0 if no message
   748 000008B3 E8FC000000          <1>     call dosCrit1Exit   ;Just returns if not in a critical section
   749 000008B8 4885D2              <1>     test rdx, rdx
   750 000008BB 7405                <1>     jz .noPrint
