   620                              <1> .fat32:
   621                              <1> ;Now add dir sectors and two bootsectors and two fsinfo sectors (4)
   622 00000789 0FB6056F020000      <1>     movzx eax, byte [secPerClust]   ;Sectors per cluster (1 cluster for dir)
