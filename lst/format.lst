   607 0000075D 742A                <1>     je .fat32
   608 0000075F 488B359F020000      <1>     mov rsi, qword [bpbPointer]
   609 00000766 0FB74606            <1>     movzx eax, word [rsi + bpb.rootEntCnt]  ;Number of 32 bit entries
   610 0000076A C1E005              <1>     shl eax, 5  ;Get number of bytes in root dir
   611 0000076D 0FB736              <1>     movzx esi, word [rsi + bpb.bytsPerSec]
   612 00000770 31D2                <1>     xor edx, edx
