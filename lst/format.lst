   114 00000000 ??                  <1>     .bSize          db ?
   115 00000001 ??                  <1>     .bNumSectors    db ?  ;# sectors to act on. Returns sectors acted on
   116 00000002 ????????????        <1>     .sRes           db 6 dup (?)
   117 00000008 ????????????????    <1>     .qStartSector   dq ?  ;Sector to start action on
