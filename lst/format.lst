    10 00000CAB 00                  <1> remDev      db 0        ;0 = Removable, -1 = Fixed
    11 00000CAC FF                  <1> fatType     db -1       ;0 = FAT12, 1 = FAT16, 2 = FAT32, -1 = No FAT
    12 00000CAD 0002                <1> sectorSize  dw 512      ;Sector size in bytes: HARDCODED BYTES PER SECTOR VALUE
    13 00000CAF 0000000000000000    <1> numSectors  dq 0        ;Number of sectors in volume
    14 00000CB7 00                  <1> secPerClust db 0        ;Copy the sectors per cluster over
    15 00000CB8 00000000            <1> fatSize     dd 0        ;FAT size (number of sectors per FAT)
    16 00000CBC F0                  <1> media       db 0F0h     ;Media type (F0h or F8h)
    17 00000CBD 0000000000000000    <1> bpbPtr      dq 0        ;Pointer to the buffer for the BPB (in IOCTL block)
    18 00000CC5 00                  <1> bpbSize     db 0        ;Size of the BPB
    19 00000CC6 00000000            <1> hiddSector  dd 0        ;Only used for Fixed Disks, offset to add
    20 00000CCA 00000000            <1> f32RootClus dd 0        ;Cluster addr of the root dir cluster if FAT32
    21 00000CCE 00000000            <1> dSerNum     dd 0        ;Serial number
    22 00000CD2 00000000            <1> dBadClust   dd 0        ;Number of bad clusters on disk
    23                              <1> 
    24                              <1> ;Tracking vars, used only for updating the percentage message!
    25 00000CD6 0000000000000000    <1> secToWrite  dq 0        ;Number of sectors to write (neq numSectors if /Q set)
    26 00000CDE 0000000000000000    <1> secWritten  dq 0        ;Number of sectors written so far
    27 00000CE6 FF                  <1> secPercent  db -1       ;The previous percentage (-1 not initialised)
    28                              <1> 
    29                              <1> ;Tables
    30                              <1> ;All data here is RO.
    31                              <1> ;Each row is 5 bytes, {DWORD, BYTE} with DWORD = diskSize, BYTE=secPerClusVal
    32                              <1> ;This table assumes a 512 byte sector (fair assumption) but we do a byte size
    33                              <1> ; comparison in format to eventually allow for other sized sectors
    34                              <1> fat16ClusterTable:
    35 00000CE7 00A04100            <1>     dd 8400*512 ;Disks up to 4.1MB, must use FAT12 with 0.5 K clusters
    36 00000CEB 01                  <1>     db 1    ;ALL FAT12 uses 1, unless it is a preexisting meddesc type medium
    37 00000CEC 0050FF00            <1>     dd 32680*512    ; Disk up to 16MB, 1K clusters
    38 00000CF0 02                  <1>     db 2
    39 00000CF1 00000008            <1>     dd 262144*512   ; Disk up to 128MB, 2K clusters
    40 00000CF5 04                  <1>     db 4
    41 00000CF6 00000010            <1>     dd 524288*512   ; Disk up to 256MB, 4K clusters
    42 00000CFA 08                  <1>     db 8
    43 00000CFB 00000020            <1>     dd 1048576*512  ; Disk up to 512Mb, 8K clusters
    44 00000CFF 10                  <1>     db 16
    45                              <1> 
    46                              <1> ;Here DWORD becomes QWORD
    47                              <1> fat32ClusterTable:
    48 00000D00 0000000002000000    <1>     dq 16777216*512 ; Disk up to 8GB, 4K clusters
    49 00000D08 08                  <1>     db 8        
    50 00000D09 0000000004000000    <1>     dq 33554432*512 ; Disk up to 16GB, 8K clusters
    51 00000D11 10                  <1>     db 16
    52 00000D12 0000000008000000    <1>     dq 67108864*512 ; Disk up to 32Gb, 16K clusters
    53 00000D1A 20                  <1>     db 32
    54 00000D1B FFFFFFFFFFFFFFFF    <1>     dq -1       ; Disk up to 2TB, 32K clusters
    55 00000D23 40                  <1>     db 64
    56                              <1> 
    57                              <1> ;Bpbs are for remdevs of 1.44Mb and 2.88Mb capacity.
    58                              <1> ;We have these built-in so that if (when supported) /F:1.44 or /F:2.88
    59                              <1> ; is selected, we can format to these standard values. 
    60                              <1> ;bpb144Mb:
    61                              <1> ;    istruc bpb
    62                              <1> ;    at .bytsPerSec, dw 200h
    63                              <1> ;    at .secPerClus, db 01h
    64                              <1> ;    at .revdSecCnt, dw 0001h
    65                              <1> ;    at .numFATs,    db 02h    
    66                              <1> ;    at .rootEntCnt, dw 00E0h    
    67                              <1> ;    at .totSec16,   dw 0B40h    
    68                              <1> ;    at .media,      db 0F0h    
    69                              <1> ;    at .FATsz16,    dw 0009h    
    70                              <1> ;    at .secPerTrk,  dw 0012h    
    71                              <1> ;    at .numHeads,   dw 0002h    
    72                              <1> ;    at .hiddSec,    dd 0    
    73                              <1> ;    at .totSec32,   dd 0     
    74                              <1> ;    iend
    75                              <1> ;bpb288Mb:
    76                              <1> ;    istruc bpb
    77                              <1> ;    at .bytsPerSec, dw 200h
    78                              <1> ;    at .secPerClus, db 02h  ;To be FAT 12 OK, we need 2 sectors/clust
    79                              <1> ;    at .revdSecCnt, dw 0001h
    80                              <1> ;    at .numFATs,    db 02h
    81                              <1> ;    at .rootEntCnt, dw 00E0h
    82                              <1> ;    at .totSec16,   dw 1680h
    83                              <1> ;    at .media,      db 0F0h
    84                              <1> ;    at .FATsz16,    dw 0012h
    85                              <1> ;    at .secPerTrk,  dw 0024h    
    86                              <1> ;    at .numHeads,   dw 0002h    
    87                              <1> ;    at .hiddSec,    dd 0    
    88                              <1> ;    at .totSec32,   dd 0     
    89                              <1> ;    iend
    90                              <1> 
    91                              <1> ;Generic BPBs here, fields set to -1 must be edited in the copy made.
    92                              <1> genericBPB12:
    93                              <1>     istruc bpb
    94 00000D24 FFFF                <1>     at .bytsPerSec,  dw -1           ;512 bytes per sector, normally
    95 00000D26 FF                  <1>     at .secPerClus,  db -1           ;1 sector per cluster, normally
    96 00000D27 0100                <1>     at .revdSecCnt,  dw 0001h        ;1 Reserved Sector
    97 00000D29 02                  <1>     at .numFATs,     db 02h          ;2 FAT tables
    98 00000D2A E000                <1>     at .rootEntCnt,  dw 00E0h        ;224 root entries
    99 00000D2C FFFF                <1>     at .totSec16,    dw -1           ;Total number of sectors on disk
   100 00000D2E F0                  <1>     at .media,       db 0F0h         ;Media byte
   101 00000D2F FFFF                <1>     at .FATsz16,     dw -1           ;9 FAT sectors, normally
   102 00000D31 1200                <1>     at .secPerTrk,   dw 0012h        ;18 Sectors per track
   103 00000D33 0200                <1>     at .numHeads,    dw 0002h        ;2 Heads
   104 00000D35 FFFFFFFF            <1>     at .hiddSec,     dd -1           ;No hidden sectors on removable
   105 00000D39 00000000            <1>     at .totSec32,    dd 0            ;Not a FAT32 BPB
   106                              <1>     iend
   107                              <1>     istruc extBs 
   108 00000D3D FF                  <1>     at .drvNum,         db -1   ;Set to 0 for Remdev, 80h for fixed disk
   109 00000D3E 00                  <1>     at .reserved1,      db 00h
   110 00000D3F 29                  <1>     at .bootSig,        db extBsSig ;Normal signature
   111 00000D40 FFFFFFFF            <1>     at .volId,          dd -1       ;Set to date/time @ format
   112 00000D44 4E4F204E414D452020- <1>     at .volLab,         db 'NO NAME    '    
   112 00000D4D 2020                <1>
   113 00000D4F 4641543132202020    <1>     at .filSysType,     db 'FAT12   '
   114                              <1>     iend
   115                              <1> 
   116                              <1> 
   117                              <1> genericBPB16:
   118                              <1>     istruc bpb
   119 00000D57 FFFF                <1>     at .bytsPerSec,  dw -1           ;512 bytes per sector, normally
   120 00000D59 FF                  <1>     at .secPerClus,  db -1           ;Sectors per cluster
   121 00000D5A 0100                <1>     at .revdSecCnt,  dw 0001h        ;1 Reserved Sector
   122 00000D5C 02                  <1>     at .numFATs,     db 02h          ;2 FAT tables
   123 00000D5D 0002                <1>     at .rootEntCnt,  dw 0200h        ;512 root entries
   124 00000D5F FFFF                <1>     at .totSec16,    dw -1           ;Total number of sectors on disk
   125 00000D61 F0                  <1>     at .media,       db 0F0h         ;Media byte
   126 00000D62 FFFF                <1>     at .FATsz16,     dw -1           ;Number of sectors per FAT
   127 00000D64 3F00                <1>     at .secPerTrk,   dw 003Fh        ;FAT16 and 32 have Hard disk geometry 
   128 00000D66 FF00                <1>     at .numHeads,    dw 00FFh        ;255 Heads
   129 00000D68 FFFFFFFF            <1>     at .hiddSec,     dd -1           ;No hidden sectors on removable
   130 00000D6C 00000000            <1>     at .totSec32,    dd 0            ;Not a FAT32 BPB
   131                              <1>     iend
   132                              <1>     istruc extBs 
   133 00000D70 FF                  <1>     at .drvNum,         db -1   ;Set to 0 for Remdev, 80h for fixed disk
   134 00000D71 00                  <1>     at .reserved1,      db 00h
   135 00000D72 29                  <1>     at .bootSig,        db extBsSig ;Normal signature
   136 00000D73 FFFFFFFF            <1>     at .volId,          dd -1       ;Set to date/time @ format
   137 00000D77 4E4F204E414D452020- <1>     at .volLab,         db 'NO NAME    '    
   137 00000D80 2020                <1>
   138 00000D82 4641543136202020    <1>     at .filSysType,     db 'FAT16   '
   139                              <1>     iend
   140                              <1> gbs_size equ ($ - genericBPB16) + 11
   141                              <1> 
   142                              <1> genericBPB32:
   143                              <1>     istruc bpb32
   144 00000D8A FFFF                <1>     at .bytsPerSec,  dw -1           ;512 bytes per sector, normally
   145 00000D8C FF                  <1>     at .secPerClus,  db -1           ;Sectors per cluster
   146 00000D8D 1000                <1>     at .revdSecCnt,  dw 0010h        ;16 Reserved Sectors
   147 00000D8F 02                  <1>     at .numFATs,     db 02h          ;2 FAT tables
   148 00000D90 0000                <1>     at .rootEntCnt,  dw 0000h        ;Invalid field for FAT32
   149 00000D92 0000                <1>     at .totSec16,    dw 0            ;Not a FAT 12/16 BPB
   150 00000D94 F0                  <1>     at .media,       db 0F0h         ;Media byte
   151 00000D95 0000                <1>     at .FATsz16,     dw 0            ;Not a FAT 12/16 BPB
   152 00000D97 3F00                <1>     at .secPerTrk,   dw 003Fh        ;FAT16 and 32 have Hard disk geometry 
   153 00000D99 FF00                <1>     at .numHeads,    dw 00FFh        ;255 Heads
   154 00000D9B FFFFFFFF            <1>     at .hiddSec,     dd -1           ;No hidden sectors on removable
   155 00000D9F FFFFFFFF            <1>     at .totSec32,    dd -1           ;Total number of sectors on disk
   156                              <1> 
   157 00000DA3 FFFFFFFF            <1>     at .FATsz32,     dd -1  ;Number of sectors per FAT
   158 00000DA7 FFFF                <1>     at .extFlags,    dw -1  ;Extended Flags word
   159 00000DA9 0000                <1>     at .FSver,       dw 0   ;File system version word, must be 0
   160 00000DAB FFFFFFFF            <1>     at .RootClus,    dd -1  ;First Cluster of Root Directory
   161 00000DAF 0100                <1>     at .FSinfo,      dw 1   ;Sector number of FSINFO structure, usually 1
   162 00000DB1 0600                <1>     at .BkBootSec,   dw 6   ;Backup Boot sector, either 0 or 6
   163 00000DB3 000000000000000000- <1>     at .reserved,    db 12 dup (0) ;Reserved 12 bytes
   163 00000DBC 000000              <1>
   164                              <1>     iend
   165                              <1>     istruc extBs 
   166 00000DBF FF                  <1>     at .drvNum,         db -1   ;Set to 0 for Remdev, 80h for fixed disk
   167 00000DC0 00                  <1>     at .reserved1,      db 00h
   168 00000DC1 29                  <1>     at .bootSig,        db extBsSig ;Normal signature
   169 00000DC2 FFFFFFFF            <1>     at .volId,          dd -1       ;Set to date/time @ format
   170 00000DC6 4E4F204E414D452020- <1>     at .volLab,         db 'NO NAME    '    
   170 00000DCF 2020                <1>
   171 00000DD1 4641543332202020    <1>     at .filSysType,     db 'FAT32   '
   172                              <1>     iend
   173                              <1> gbs32_size equ ($ - genericBPB32) + 11
   174                              <1> 
