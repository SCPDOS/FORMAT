   928                              <1> getBpb:
   929                              <1> ;Gets the BPB from the bootsector into the buffer
   930                              <1> ;Input: = al[0] = Set if we return backup bpb. Clear if get from disk.
   931 000009F4 B960080000          <1>     mov ecx, 0860h         ;Disk drive type IOCTL, get FAT parameters
