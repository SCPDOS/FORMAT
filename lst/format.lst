   643                              <1> 
   644                              <1> computeFATSize:
   645                              <1> ; ;Works on the genericBPB in memory. Applies the following algorithm
   646                              <1> ; RootDirSectors = ((BPB_RootEntCnt * 32) + (BPB_BytsPerSec – 1)) / BPB_BytsPerSec;
   647                              <1> ; TmpVal1 = DskSize – (BPB_ResvdSecCnt + RootDirSectors);
   648                              <1> ; TmpVal2 = (256 * BPB_SecPerClus) + BPB_NumFATs;
   649                              <1> ; If(FATType == FAT32)
   650                              <1> ;   TmpVal2 = TmpVal2 / 2;
   651                              <1> ; FATSz = (TMPVal1 + (TmpVal2 – 1)) / TmpVal2;
   652                              <1> ;Input:
   653                              <1> ;   rdi = Pointer to the head of the BPB we are using
   654                              <1> ;Returns: 
   655                              <1> ;   eax = Number of sectors per FAT needed. Low word only valid for FAT12/16
   656 000007C3 53                  <1>     push rbx
   657 000007C4 51                  <1>     push rcx
   658 000007C5 52                  <1>     push rdx
   659 000007C6 57                  <1>     push rdi
   660                              <1>     
   661 000007C7 0FB74706            <1>     movzx eax, word [rdi + bpb.rootEntCnt]
   662 000007CB C1E005              <1>     shl eax, 5  ;Multiply by 32
   663 000007CE 0FB71F              <1>     movzx ebx, word [rdi + bpb.bytsPerSec]
   664 000007D1 FFCB                <1>     dec ebx
   665 000007D3 01D8                <1>     add eax, ebx
   666 000007D5 FFC3                <1>     inc ebx
   667 000007D7 31D2                <1>     xor edx, edx
   668 000007D9 F7F3                <1>     div ebx
   669 000007DB 89C2                <1>     mov edx, eax    ;edx = RootDirSectors
   670                              <1> 
   671 000007DD 0FB74708            <1>     movzx eax, word [rdi + bpb.totSec16]
   672 000007E1 8B5F15              <1>     mov ebx, dword [rdi + bpb.totSec32]
   673 000007E4 85C0                <1>     test eax, eax   ;If totSec16 is 0, move totSec32 into eax
   674 000007E6 0F44C3              <1>     cmovz eax, ebx
   675 000007E9 0FB75F03            <1>     movzx ebx, word [rdi + bpb.revdSecCnt]
   676 000007ED 01D3                <1>     add ebx, edx    ;Add RootDirSectors
   677 000007EF 29D8                <1>     sub eax, ebx
   678 000007F1 89C1                <1>     mov ecx, eax    ;ecx = TmpVal1
   679                              <1> 
   680 000007F3 0FB64702            <1>     movzx eax, byte [rdi + bpb.secPerClus]
   681 000007F7 C1E008              <1>     shl eax, 8  ;multiply by 256
   682 000007FA 0FB65F05            <1>     movzx ebx, byte [rdi + bpb.numFATs]
   683 000007FE 01C3                <1>     add ebx, eax    ;ebx = TmpVal2
   684                              <1> 
   685 00000800 803DF401000002      <1>     cmp byte [fatType], 2
   686 00000807 7502                <1>     jne .notFat32
   687 00000809 D1EB                <1>     shr ebx, 1  ;Divide by 2
   688                              <1> .notFat32: 
   689 0000080B 89C8                <1>     mov eax, ecx    ;TmpVal1
   690 0000080D FFCB                <1>     dec ebx
   691 0000080F 01D8                <1>     add eax, ebx    ;TmpVal1 + (TmpVal2 - 1)
   692 00000811 FFC3                <1>     inc ebx
   693 00000813 31D2                <1>     xor edx, edx
   694 00000815 F7F3                <1>     div ebx ;Exit with eax = number of sectors needed per FAT
   695                              <1> .exit:
   696 00000817 5F                  <1>     pop rdi
   697 00000818 5A                  <1>     pop rdx
   698 00000819 59                  <1>     pop rcx
   699 0000081A 5B                  <1>     pop rbx
   700                              <1>     return
    13                              <2> %%_ret:
    14 0000081B C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
