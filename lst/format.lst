   603                              <1> .fat32:
   604                              <1> ;Now add dir sectors and two bootsectors and two fsinfo sectors (4)
   605 0000076E 0FB60591020000      <1>     movzx eax, byte [secPerClust]   ;Sectors per cluster (1 cluster for dir)
   606 00000775 0504000000          <1>     add eax, 4  ;Two BS + 2 FSINFO
   607 0000077A 480105A4020000      <1>     add qword [secToWrite], rax
   608                              <1>     return
