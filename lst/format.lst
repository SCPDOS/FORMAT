    74 00000A86 FFFF                <1>     at .bytsPerSec,  dw -1           ;512 bytes per sector, normally
    75 00000A88 FF                  <1>     at .secPerClus,  db -1           ;1 sector per cluster, normally
    76 00000A89 0100                <1>     at .revdSecCnt,  dw 0001h        ;1 Reserved Sector
    77 00000A8B 02                  <1>     at .numFATs,     db 02h          ;2 FAT tables
