   101                              <1>     istruc bpb
   102 00000AA6 FFFF                <1>     at .bytsPerSec,  dw -1           ;512 bytes per sector, normally
   103 00000AA8 FF                  <1>     at .secPerClus,  db -1           ;Sectors per cluster
   104 00000AA9 0100                <1>     at .revdSecCnt,  dw 0001h        ;1 Reserved Sector
