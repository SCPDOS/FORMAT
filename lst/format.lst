   536 00000694 B20A                <1>     mov dl, LF
   537 00000696 E868000000          <1>     call putch
   538 0000069B 58                  <1>     pop rax
   539 0000069C 5A                  <1>     pop rdx
   540 0000069D 48CF                <1>     iretq   ;Redo the operation
