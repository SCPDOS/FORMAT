    68 000007B6 0100                <1>     at .revdSecCnt,  dw 0001h        ;1 Reserved Sector
    69 000007B8 02                  <1>     at .numFATs,     db 02h          ;2 FAT tables
    70 000007B9 E000                <1>     at .rootEntCnt,  dw 00E0h        ;224 root entries
