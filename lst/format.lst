   134 00000B75 00                  <1>     at .reserved1,      db 00h
   135 00000B76 29                  <1>     at .bootSig,        db extBsSig ;Normal signature
   136 00000B77 FFFFFFFF            <1>     at .volId,          dd -1       ;Set to date/time @ format
