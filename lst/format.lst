   625                              <1> checkBreak:
   626                              <1> ;Checks if control C has been struck and triggers Int 23h.
   627                              <1> ;21h/0Bh does a non-blocking check of the keyboard buffer status.
   628                              <1> ;If there is a Ctrl+C waiting in buffer, it triggers Int 23h.
   629                              <1> ;If the user then doesn't want to exit the program, it reenters 
   630                              <1> ; the call to check the keyboard status which will just return 
   631                              <1> ; if the buffer is full or empty.
   632                              <1> ;If no Ctrl+C waiting in the buffer, it just return the keyboard status.
   633 0000073C B8000B0000          <1>     mov eax, 0B00h
   634 00000741 CD21                <1>     int 21h
   635                              <1>     return
    13                              <2> %%_ret:
