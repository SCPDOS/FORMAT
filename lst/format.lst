  1016 00000A9C 488D1570010000      <1>     lea rdx, accFlgPkt
  1017 00000AA3 B947080000          <1>     mov ecx, 0847h  ;Set Access flag on disk drive
  1018 00000AA8 0FB61D23000000      <1>     movzx ebx, byte [fmtDrive]
  1019 00000AAF FFC3                <1>     inc ebx ;Turn into a 1 based drive number
  1020 00000AB1 B80D440000          <1>     mov eax, 440Dh  ;Generic IOCTL
  1021 00000AB6 CD21                <1>     int 21h
  1022                              <1>     return
    13                              <2> %%_ret:
    14 00000AB8 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1023                              <1> 
  1024                              <1> ;Do not put the whole format through a critical section, that is insane!
  1025                              <1> ;Use a DOS networking extension to obtain a handle to the drive.
  1026                              <1> dosCrit1Enter:
  1027 00000AB9 C60513000000FF      <1>     mov byte [inCrit], -1   ;Entering a DOS level 1 critical section
  1028                              <1>     ;push rax 
  1029                              <1>     ;mov eax, 8001h
  1030                              <1>     ;int 2ah
  1031                              <1>     ;pop rax
  1032                              <1>     return
    13                              <2> %%_ret:
    14 00000AC0 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1033                              <1> dosCrit1Exit:
  1034 00000AC1 F6050B000000FF      <1>     test byte [inCrit], -1  ;If we are not in a critical section, just return
  1035                              <1>     retz
    41                              <2> cret z
    19                              <3> %%_base:
    20                              <3> %assign baseVar %%_base-$$
    21                              <3>  %ifdef retOff
    22                              <3>  %if (baseVar - retOff <= 126) && (baseVar > retOff)
    23                              <3>  %ifdef currSegVBase
    24                              <3>  j%+1 short (retOff+currSegVBase)
    25                              <3>  %else
    26 00000AC8 74(C0)              <3>  j%+1 short retOff
    27                              <3>  %endif
    28                              <3>  %else
    29                              <3>  j%-1 short %%a
    30                              <3>  return
    31                              <3> %%a:
    32                              <3>  %endif
    33                              <3>  %else
    34                              <3>  j%-1 short %%a
    35                              <3>  return
    36                              <3> %%a:
    37                              <3>  %endif
  1036                              <1>     ;push rax 
  1037                              <1>     ;mov eax, 8101h          
  1038                              <1>     ;int 2ah
  1039                              <1>     ;pop rax
  1040 00000ACA C6050200000000      <1>     mov byte [inCrit], 0    ;Indicate we have exited the critical section
  1041                              <1>     return
