   736                              <1> computeFATSize:
   737                              <1> ; Reads from the bpb in rdi. Applies the following algorithm
   738                              <1> ; RootDirSectors = ((BPB_RootEntCnt * 32) + (BPB_BytsPerSec – 1)) / BPB_BytsPerSec;
   739                              <1> ; TmpVal1 = DskSize – (BPB_ResvdSecCnt + RootDirSectors);
   740                              <1> ; TmpVal2 = (256 * BPB_SecPerClus) + BPB_NumFATs;
   741                              <1> ; If(FATType == FAT32)
   742                              <1> ;   TmpVal2 = TmpVal2 / 2;
   743                              <1> ; FATSz = (TMPVal1 + (TmpVal2 – 1)) / TmpVal2;
   744                              <1> ;Input:
   745                              <1> ;   rdi = Pointer to the head of the BPB we are using
   746                              <1> ;Returns: 
   747                              <1> ;   eax = Number of sectors per FAT needed. Low word only valid for FAT12/16
   748 00000862 53                  <1>     push rbx
   749 00000863 51                  <1>     push rcx
   750 00000864 52                  <1>     push rdx
   751 00000865 57                  <1>     push rdi
   752                              <1>     
   753 00000866 0FB74706            <1>     movzx eax, word [rdi + bpb.rootEntCnt]
   754 0000086A C1E005              <1>     shl eax, 5  ;Multiply by 32
   755 0000086D 0FB71F              <1>     movzx ebx, word [rdi + bpb.bytsPerSec]
   756 00000870 FFCB                <1>     dec ebx
   757 00000872 01D8                <1>     add eax, ebx
   758 00000874 FFC3                <1>     inc ebx
   759 00000876 31D2                <1>     xor edx, edx
   760 00000878 F7F3                <1>     div ebx
   761 0000087A 89C2                <1>     mov edx, eax    ;edx = RootDirSectors
   762                              <1> 
   763 0000087C 0FB74708            <1>     movzx eax, word [rdi + bpb.totSec16]
   764 00000880 8B5F15              <1>     mov ebx, dword [rdi + bpb.totSec32]
   765 00000883 85C0                <1>     test eax, eax   ;If totSec16 is 0, move totSec32 into eax
   766 00000885 0F44C3              <1>     cmovz eax, ebx
   767 00000888 0FB75F03            <1>     movzx ebx, word [rdi + bpb.revdSecCnt]
   768 0000088C 01D3                <1>     add ebx, edx    ;Add RootDirSectors
   769 0000088E 29D8                <1>     sub eax, ebx
   770 00000890 89C1                <1>     mov ecx, eax    ;ecx = TmpVal1
   771                              <1> 
   772 00000892 0FB64702            <1>     movzx eax, byte [rdi + bpb.secPerClus]
   773 00000896 C1E008              <1>     shl eax, 8  ;multiply by 256
   774 00000899 0FB65F05            <1>     movzx ebx, byte [rdi + bpb.numFATs]
   775 0000089D 01C3                <1>     add ebx, eax    ;ebx = TmpVal2
   776                              <1> 
   777 0000089F 803D4002000002      <1>     cmp byte [fatType], 2
   778 000008A6 7502                <1>     jne .notFat32
   779 000008A8 D1EB                <1>     shr ebx, 1  ;Divide by 2
   780                              <1> .notFat32: 
   781 000008AA 89C8                <1>     mov eax, ecx    ;TmpVal1
   782 000008AC FFCB                <1>     dec ebx
   783 000008AE 01D8                <1>     add eax, ebx    ;TmpVal1 + (TmpVal2 - 1)
   784 000008B0 FFC3                <1>     inc ebx
   785 000008B2 31D2                <1>     xor edx, edx
   786 000008B4 F7F3                <1>     div ebx ;Exit with eax = number of sectors needed per FAT
   787                              <1> .exit:
   788 000008B6 5F                  <1>     pop rdi
   789 000008B7 5A                  <1>     pop rdx
   790 000008B8 59                  <1>     pop rcx
   791 000008B9 5B                  <1>     pop rbx
   792                              <1>     return
    13                              <2> %%_ret:
    14 000008BA C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
