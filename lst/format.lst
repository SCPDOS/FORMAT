    21 00001015 0000000000000000    <1> numSectors  dq 0        ;Number of sectors in volume
    22 0000101D 00                  <1> secPerClust db 0        ;Copy the sectors per cluster over
    23 0000101E 00000000            <1> fatSize     dd 0        ;FAT size (number of sectors per FAT)
    24 00001022 F0                  <1> media       db 0F0h     ;Media type (F0h or F8h)
