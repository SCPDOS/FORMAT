   582 000008DC C683FD01000000      <1>     mov byte [rbx + 509], 0 ;Make the disk not bootable
   583 000008E3 66C783FE01000055AA  <1>     mov word [rbx + 510], 0AA55h
   584                              <1> .noBS:
   585                              <1> ;Now copy the accurate BPB into the bootsector
   586 000008EC 488D7B0B            <1>     lea rdi, qword [rbx + 11]    ;Point rdi to the BPB in the sector
   587 000008F0 488B35EC090000      <1>     mov rsi, qword [bpbPtr]
   588 000008F7 0FB60DED090000      <1>     movzx ecx, byte [bpbSize]   ;Now copy the bpb
