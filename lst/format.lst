   190                              <1> ;Generic BPBs here, fields set to -1 must be edited in the copy made.
   191                              <1> genericBPB12:
   192                              <1>     istruc bpb
   193 00001152 FFFF                <1>         at .bytsPerSec, dw -1   ;512 bytes per sector, normally
   194 00001154 FF                  <1>         at .secPerClus, db -1   ;1 sector per cluster, normally
   195 00001155 0100                <1>         at .revdSecCnt, dw 1    ;1 Reserved Sector
   196 00001157 02                  <1>         at .numFATs,    db 2    ;2 FAT tables
   197 00001158 E000                <1>         at .rootEntCnt, dw 224  ;224 root entries
   198 0000115A FFFF                <1>         at .totSec16,   dw -1   ;Total number of sectors on disk
   199 0000115C F0                  <1>         at .media,      db 0F0h ;Media byte
   200 0000115D FFFF                <1>         at .FATsz16,    dw -1   ;9 FAT sectors, normally
   201 0000115F 1200                <1>         at .secPerTrk,  dw 18   ;18 Sectors per track
   202 00001161 0200                <1>         at .numHeads,   dw 2    ;2 Heads
   203 00001163 FFFFFFFF            <1>         at .hiddSec,    dd -1   ;No hidden sectors on removable
   204 00001167 00000000            <1>         at .totSec32,   dd 0    ;16 bit entry suffices
   205                              <1>     iend
   206                              <1>     istruc extBs 
   207 0000116B FF                  <1>         at .drvNum,     db -1   ;Set to 0 for Remdev, 80h for fixed disk
   208 0000116C 00                  <1>         at .reserved1,  db 00h
   209 0000116D 29                  <1>         at .bootSig,    db extBsSig ;Normal signature
   210 0000116E FFFFFFFF            <1>         at .volId,      dd -1       ;Set to date/time @ format
   211 00001172 4E4F204E414D452020- <1>         at .volLab,     db 'NO NAME    '    
   211 0000117B 2020                <1>
   212 0000117D 4641543132202020    <1>         at .filSysType, db 'FAT12   '
   213                              <1>     iend
   214                              <1> 
   215                              <1> 
   216                              <1> genericBPB16:
   217                              <1>     istruc bpb
   218 00001185 FFFF                <1>         at .bytsPerSec, dw -1   ;512 bytes per sector, normally
   219 00001187 FF                  <1>         at .secPerClus, db -1   ;Sectors per cluster
   220 00001188 0100                <1>         at .revdSecCnt, dw 1    ;1 Reserved Sector
   221 0000118A 02                  <1>         at .numFATs,    db 2    ;2 FAT tables
   222 0000118B 0002                <1>         at .rootEntCnt, dw 512  ;512 root entries
   223 0000118D FFFF                <1>         at .totSec16,   dw -1   ;Total number of sectors on disk
   224 0000118F F0                  <1>         at .media,      db 0F0h ;Media byte
   225 00001190 FFFF                <1>         at .FATsz16,    dw -1   ;Number of sectors per FAT
   226 00001192 3F00                <1>         at .secPerTrk,  dw 03Fh ;FAT16 and 32 have Hard disk geometry 
   227 00001194 FF00                <1>         at .numHeads,   dw 0FFh ;255 Heads
   228 00001196 FFFFFFFF            <1>         at .hiddSec,    dd -1   ;No hidden sectors on removable
   229 0000119A 00000000            <1>         at .totSec32,   dd 0    ;16 bit entry suffices
   230                              <1>     iend
   231                              <1>     istruc extBs 
   232 0000119E FF                  <1>         at .drvNum,     db -1   ;Set to 0 for Remdev, 80h for fixed disk
   233 0000119F 00                  <1>         at .reserved1,  db 0
   234 000011A0 29                  <1>         at .bootSig,    db extBsSig ;Normal signature
   235 000011A1 FFFFFFFF            <1>         at .volId,      dd -1       ;Set to date/time @ format
   236 000011A5 4E4F204E414D452020- <1>         at .volLab,     db 'NO NAME    '    
   236 000011AE 2020                <1>
   237 000011B0 4641543136202020    <1>         at .filSysType, db 'FAT16   '
   238                              <1>     iend
   239                              <1> gbs_size equ ($ - genericBPB16) + 11
