   129 00000ADC 1000                <1>     at .revdSecCnt,  dw 0010h        ;16 Reserved Sectors
   130 00000ADE 02                  <1>     at .numFATs,     db 02h          ;2 FAT tables
   131 00000ADF 0000                <1>     at .rootEntCnt,  dw 0000h        ;Invalid field for FAT32
   132 00000AE1 0000                <1>     at .totSec16,    dw 0            ;Not a FAT 12/16 BPB
   133 00000AE3 F0                  <1>     at .media,       db 0F0h         ;Media byte
   134 00000AE4 0000                <1>     at .FATsz16,     dw 0            ;Not a FAT 12/16 BPB
   135 00000AE6 3F00                <1>     at .secPerTrk,   dw 003Fh        ;FAT16 and 32 have Hard disk geometry 
   136 00000AE8 FF00                <1>     at .numHeads,    dw 00FFh        ;255 Heads
   137 00000AEA FFFFFFFF            <1>     at .hiddSec,     dd -1           ;No hidden sectors on removable
