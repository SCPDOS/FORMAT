   849 00000947 E8DEFFFFFF          <1>     call checkBreak
   850 0000094C 8A0595000000        <1>     mov al, byte [fmtDrive]     ; Always read from fmtDrive
   851 00000952 488B1D98000000      <1>     mov rbx, qword [bufferArea] ; Memory Buffer address to read from
   852 00000959 CD25                <1>     int 25h
   853 0000095B 58                  <1>     pop rax ;Pop old flags into rax
   854                              <1>     return
    13                              <2> %%_ret:
    14 0000095C C3                  <2>  ret
