   136                              <1> printHexByte:
   137 000008FB 488D1D1E000000      <1>     lea rbx, .tbl
   138 00000902 50                  <1>     push rax
   139 00000903 C1E804              <1>     shr eax, 4  ;Move nybble down
   140 00000906 E807000000          <1>     call .phn
   141 0000090B 58                  <1>     pop rax
