   534                              <1> .errPrint:
   535                              <1> ;Print a default ? symbol if an overflow occurs.
   536 000006BF B23F                <1>     mov dl, "?"
   537 000006C1 E86F020000          <1>     call putch
   538 000006C6 EBF3                <1>     jmp short .exit
