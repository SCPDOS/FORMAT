   183                              <1> printDecimalValLB:
   184                              <1> ;Takes a value in rax and prints it's decimal representation with leading
   185                              <1> ; blanks and inserts commas where appropriate.
   186                              <1> ;Input: rax = Value to print
   187                              <1> ;       rcx = Buffer size to handle (usual values: 17 for max, 13 for dword)
   188 00000C55 4889E5              <1>     mov rbp, rsp
   189 00000C58 4829CC              <1>     sub rsp, rcx ;Allocate the buffer on the stack
   190 00000C5B 4889EF              <1>     mov rdi, rbp
   191 00000C5E 4829CF              <1>     sub rdi, rcx
   192 00000C61 50                  <1>     push rax
   193 00000C62 51                  <1>     push rcx
   194 00000C63 57                  <1>     push rdi
   195 00000C64 31C0                <1>     xor eax, eax
   196 00000C66 F3AA                <1>     rep stosb   ;Initialise the buffer with a null value
   197 00000C68 5F                  <1>     pop rdi     ;Now set the ptr to the head of the buffer
   198 00000C69 59                  <1>     pop rcx
   199 00000C6A 58                  <1>     pop rax
   200 00000C6B 51                  <1>     push rcx    ;Save this value to keep the buffer length
   201 00000C6C E83E000000          <1>     call decimalise   ;If return with CF=CY, error!
   202 00000C71 59                  <1>     pop rcx     ;Now print the buffer
   203 00000C72 4889EF              <1>     mov rdi, rbp
   204 00000C75 48FFCF              <1>     dec rdi     ;Doesn't affect CF
   205 00000C78 722C                <1>     jc .errPrint    ;Print a mis-aligned ? to clearly mark an error!
   206                              <1> .skipLp:
   207 00000C7A 8A1F                <1>     mov bl, byte [rdi]
   208 00000C7C 84DB                <1>     test bl, bl ;Any leading null's get replaced with a space
   209 00000C7E 7514                <1>     jne .printLp
   210 00000C80 B220                <1>     mov dl, " "
   211 00000C82 E8A2FAFFFF          <1>     call putch
   212 00000C87 48FFCF              <1>     dec rdi
   213 00000C8A FFC9                <1>     dec ecx
   214 00000C8C 81F901000000        <1>     cmp ecx, 1
   215 00000C92 75E6                <1>     jne .skipLp   ;Always print 1 byte for size
   216                              <1> .printLp:
   217 00000C94 8A17                <1>     mov dl, byte [rdi]
   218 00000C96 E88EFAFFFF          <1>     call putch
   219 00000C9B 48FFCF              <1>     dec rdi
   220 00000C9E FFC9                <1>     dec ecx
   221 00000CA0 75F2                <1>     jnz .printLp
   222                              <1> .exit:
   223 00000CA2 4889EC              <1>     mov rsp, rbp    ;Deallocate the buffer and exit!
   224                              <1>     return
    13                              <2> %%_ret:
    14 00000CA5 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   225                              <1> .errPrint:
   226                              <1> ;Print a default ? symbol if an overflow occurs.
   227 00000CA6 B23F                <1>     mov dl, "?"
   228 00000CA8 E87CFAFFFF          <1>     call putch
   229 00000CAD EBF3                <1>     jmp short .exit
   230                              <1> 
   231                              <1> decimalise:
   232                              <1> ;Input: rax = value to decimalise
   233                              <1> ;       rdi -> Ptr to byte buffer to store string in with commas
   234                              <1> ;       ecx = buffer length
   235                              <1> ;Output: Buffer @ rdi filled in! 
   236                              <1> ;       ecx = Number of chars in buffer.
   237                              <1> ; Warning: If the number of chars in the buffer reaches buffer length,
   238                              <1> ;   we return with CF=CY. Else, CF=NC.
   239 00000CAF 57                  <1>     push rdi
   240 00000CB0 89CE                <1>     mov esi, ecx    
   241 00000CB2 31C9                <1>     xor ecx, ecx    ;Use cl as buffer length ctr, ch as comma ctr
   242 00000CB4 BB0A000000          <1>     mov ebx, 0Ah    ;Divide by 10
   243                              <1> .lp:
   244 00000CB9 80FD03              <1>     cmp ch, 3       ;Are we divisible by 3?
   245 00000CBC 750F                <1>     jne .skipSep
   246 00000CBE 4038CE              <1>     cmp sil, cl
   247 00000CC1 742A                <1>     je .exitErr     ;Before we add a comma, do we have space?
   248                              <1>     ;mov dl, byte [ctryData + countryStruc.thouSep]
   249                              <1>     ;mov byte [rdi], dl
   250 00000CC3 C6072C              <1>     mov byte [rdi], ","
   251 00000CC6 48FFC7              <1>     inc rdi 
   252 00000CC9 FEC1                <1>     inc cl          ;Inc number of chars
   253 00000CCB 30ED                <1>     xor ch, ch      ;Reset comma counter
   254                              <1> .skipSep:
   255 00000CCD 4038CE              <1>     cmp sil, cl
   256 00000CD0 741B                <1>     je .exitErr     ;Before we add a digit, do we have space?
   257 00000CD2 31D2                <1>     xor edx, edx
   258 00000CD4 48F7F3              <1>     div rbx         ;Divide rax by 10
   259 00000CD7 80C230              <1>     add dl, "0"     
   260 00000CDA 8817                <1>     mov byte [rdi], dl
   261 00000CDC 48FFC7              <1>     inc rdi
   262 00000CDF FEC1                <1>     inc cl          ;Inc number of chars
   263 00000CE1 FEC5                <1>     inc ch          ;Inc to keep track of commas
   264 00000CE3 4885C0              <1>     test rax, rax
   265 00000CE6 75D1                <1>     jnz .lp
   266                              <1> ;The test cleared CF if we are here
   267 00000CE8 0FB6C9              <1>     movzx ecx, cl
   268                              <1> .exit:
   269 00000CEB 5F                  <1>     pop rdi
   270                              <1>     return
    13                              <2> %%_ret:
    14 00000CEC C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   271                              <1> .exitErr:
   272 00000CED F9                  <1>     stc
   273 00000CEE EBFB                <1>     jmp short .exit
