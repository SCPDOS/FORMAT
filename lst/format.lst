   255                              <1> .exit:
   256 000009E2 48FFCE              <1>     dec rsi ;Point rsi back to the char which is not a command delimiter
   257 000009E5 FFC1                <1>     inc ecx
   258                              <1> .exit2:
   259 000009E7 58                  <1>     pop rax
   260                              <1>     return
