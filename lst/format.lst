   517                              <1> printDecimalValLB:
   518                              <1> ;Takes a value in rax and prints it's decimal representation with leading
   519                              <1> ; blanks and inserts commas where appropriate.
   520                              <1> ;Input: rax = Value to print
   521                              <1> ;       rcx = Buffer size to handle (usual values: 17 for max, 13 for dword)
   522 00000698 4889E5              <1>     mov rbp, rsp
   523 0000069B 4829CC              <1>     sub rsp, rcx ;Allocate the buffer on the stack
   524 0000069E 4889EF              <1>     mov rdi, rbp
   525 000006A1 4829CF              <1>     sub rdi, rcx
   526 000006A4 50                  <1>     push rax
   527 000006A5 51                  <1>     push rcx
   528 000006A6 57                  <1>     push rdi
   529 000006A7 31C0                <1>     xor eax, eax
   530 000006A9 F3AA                <1>     rep stosb   ;Initialise the buffer with a null value
   531 000006AB 5F                  <1>     pop rdi     ;Now set the ptr to the head of the buffer
   532 000006AC 59                  <1>     pop rcx
   533 000006AD 58                  <1>     pop rax
   534 000006AE 51                  <1>     push rcx    ;Save this value to keep the buffer length
   535 000006AF E83E000000          <1>     call decimalise   ;If return with CF=CY, error!
   536 000006B4 59                  <1>     pop rcx     ;Now print the buffer
   537 000006B5 4889EF              <1>     mov rdi, rbp
   538 000006B8 48FFCF              <1>     dec rdi     ;Doesn't affect CF
   539 000006BB 722C                <1>     jc .errPrint    ;Print a mis-aligned ? to clearly mark an error!
   540                              <1> .skipLp:
   541 000006BD 8A1F                <1>     mov bl, byte [rdi]
   542 000006BF 84DB                <1>     test bl, bl ;Any leading null's get replaced with a space
   543 000006C1 7514                <1>     jne .printLp
   544 000006C3 B220                <1>     mov dl, " "
   545 000006C5 E85D030000          <1>     call putch
   546 000006CA 48FFCF              <1>     dec rdi
   547 000006CD FFC9                <1>     dec ecx
   548 000006CF 81F901000000        <1>     cmp ecx, 1
   549 000006D5 75E6                <1>     jne .skipLp   ;Always print 1 byte for size
   550                              <1> .printLp:
   551 000006D7 8A17                <1>     mov dl, byte [rdi]
   552 000006D9 E849030000          <1>     call putch
   553 000006DE 48FFCF              <1>     dec rdi
   554 000006E1 FFC9                <1>     dec ecx
   555 000006E3 75F2                <1>     jnz .printLp
   556                              <1> .exit:
   557 000006E5 4889EC              <1>     mov rsp, rbp    ;Deallocate the buffer and exit!
   558                              <1>     return
    13                              <2> %%_ret:
    14 000006E8 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   559                              <1> .errPrint:
   560                              <1> ;Print a default ? symbol if an overflow occurs.
   561 000006E9 B23F                <1>     mov dl, "?"
   562 000006EB E837030000          <1>     call putch
   563 000006F0 EBF3                <1>     jmp short .exit
   564                              <1> 
   565                              <1> decimalise:
   566                              <1> ;Input: rax = value to decimalise
   567                              <1> ;       rdi -> Ptr to byte buffer to store string in with commas
   568                              <1> ;       ecx = buffer length
   569                              <1> ;Output: Buffer @ rdi filled in! 
   570                              <1> ;       ecx = Number of chars in buffer.
   571                              <1> ; Warning: If the number of chars in the buffer reaches buffer length,
   572                              <1> ;   we return with CF=CY. Else, CF=NC.
   573 000006F2 57                  <1>     push rdi
   574 000006F3 89CE                <1>     mov esi, ecx    
   575 000006F5 31C9                <1>     xor ecx, ecx    ;Use cl as buffer length ctr, ch as comma ctr
   576 000006F7 BB0A000000          <1>     mov ebx, 0Ah    ;Divide by 10
   577                              <1> .lp:
   578 000006FC 80FD03              <1>     cmp ch, 3       ;Are we divisible by 3?
   579 000006FF 750F                <1>     jne .skipSep
   580 00000701 4038CE              <1>     cmp sil, cl
   581 00000704 742A                <1>     je .exitErr     ;Before we add a comma, do we have space?
   582                              <1>     ;mov dl, byte [ctryData + countryStruc.thouSep]
   583                              <1>     ;mov byte [rdi], dl
   584 00000706 C6072C              <1>     mov byte [rdi], ","
   585 00000709 48FFC7              <1>     inc rdi 
   586 0000070C FEC1                <1>     inc cl          ;Inc number of chars
   587 0000070E 30ED                <1>     xor ch, ch      ;Reset comma counter
   588                              <1> .skipSep:
   589 00000710 4038CE              <1>     cmp sil, cl
   590 00000713 741B                <1>     je .exitErr     ;Before we add a digit, do we have space?
   591 00000715 31D2                <1>     xor edx, edx
   592 00000717 48F7F3              <1>     div rbx         ;Divide rax by 10
   593 0000071A 80C230              <1>     add dl, "0"     
   594 0000071D 8817                <1>     mov byte [rdi], dl
   595 0000071F 48FFC7              <1>     inc rdi
   596 00000722 FEC1                <1>     inc cl          ;Inc number of chars
   597 00000724 FEC5                <1>     inc ch          ;Inc to keep track of commas
   598 00000726 4885C0              <1>     test rax, rax
   599 00000729 75D1                <1>     jnz .lp
   600                              <1> ;The test cleared CF if we are here
   601 0000072B 0FB6C9              <1>     movzx ecx, cl
   602                              <1> .exit:
   603 0000072E 5F                  <1>     pop rdi
   604                              <1>     return
    13                              <2> %%_ret:
    14 0000072F C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   605                              <1> .exitErr:
   606 00000730 F9                  <1>     stc
   607 00000731 EBFB                <1>     jmp short .exit
