     4                              <1> doYNWait:
     5                              <1> ;This does the below but also outputs a new line to 
     6                              <1> ; indicate that input has been recieved.
     7 00000A66 E80F000000          <1>     call .doWait
     8 00000A6B 9C                  <1>     pushfq
     9 00000A6C 488D15CF0B0000      <1>     lea rdx, crlfStr
    10 00000A73 E8B9FCFFFF          <1>     call printString    ;Output a new line!
    11 00000A78 9D                  <1>     popfq
    12                              <1>     return
