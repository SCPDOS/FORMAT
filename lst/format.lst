   485                              <1> computeFATSize:
   486                              <1> ; ;Works on the genericBPB in memory. Applies the following algorithm
   487                              <1> ; RootDirSectors = ((BPB_RootEntCnt * 32) + (BPB_BytsPerSec – 1)) / BPB_BytsPerSec;
   488                              <1> ; TmpVal1 = DskSize – (BPB_ResvdSecCnt + RootDirSectors);
   489                              <1> ; TmpVal2 = (256 * BPB_SecPerClus) + BPB_NumFATs;
   490                              <1> ; If(FATType == FAT32)
   491                              <1> ;   TmpVal2 = TmpVal2 / 2;
   492                              <1> ; FATSz = (TMPVal1 + (TmpVal2 – 1)) / TmpVal2;
   493                              <1> ;Input:
   494                              <1> ;   rdi = Pointer to the head of the BPB we are using
   495                              <1> ;Returns: 
   496                              <1> ;   eax = Number of sectors per FAT needed. Low word only valid for FAT12/16
   497 00000632 53                  <1>     push rbx
   498 00000633 51                  <1>     push rcx
   499 00000634 52                  <1>     push rdx
   500 00000635 57                  <1>     push rdi
   501                              <1>     
   502 00000636 0FB74706            <1>     movzx eax, word [rdi + bpb.rootEntCnt]
   503 0000063A C1E005              <1>     shl eax, 5  ;Multiply by 32
   504 0000063D 0FB71F              <1>     movzx ebx, word [rdi + bpb.bytsPerSec]
   505 00000640 FFCB                <1>     dec ebx
   506 00000642 01D8                <1>     add eax, ebx
   507 00000644 FFC3                <1>     inc ebx
   508 00000646 31D2                <1>     xor edx, edx
   509 00000648 F7F3                <1>     div ebx
   510 0000064A 89C2                <1>     mov edx, eax    ;edx = RootDirSectors
   511                              <1> 
   512 0000064C 0FB74708            <1>     movzx eax, word [rdi + bpb.totSec16]
   513 00000650 8B5F15              <1>     mov ebx, dword [rdi + bpb.totSec32]
   514 00000653 85C0                <1>     test eax, eax   ;If totSec16 is 0, move totSec32 into eax
   515 00000655 0F44C3              <1>     cmovz eax, ebx
   516 00000658 0FB75F03            <1>     movzx ebx, word [rdi + bpb.revdSecCnt]
   517 0000065C 01D3                <1>     add ebx, edx    ;Add RootDirSectors
   518 0000065E 29D8                <1>     sub eax, ebx
   519 00000660 89C1                <1>     mov ecx, eax    ;ecx = TmpVal1
   520                              <1> 
   521 00000662 0FB64702            <1>     movzx eax, byte [rdi + bpb.secPerClus]
   522 00000666 C1E008              <1>     shl eax, 8  ;multiply by 256
   523 00000669 0FB65F05            <1>     movzx ebx, byte [rdi + bpb.numFATs]
   524 0000066D 01C3                <1>     add ebx, eax    ;ebx = TmpVal2
   525                              <1> 
   526 0000066F 803DD400000002      <1>     cmp byte [fatType], 2
   527 00000676 7502                <1>     jne .notFat32
   528 00000678 D1EB                <1>     shr ebx, 1  ;Divide by 2
   529                              <1> .notFat32: 
   530 0000067A 89C8                <1>     mov eax, ecx    ;TmpVal1
   531 0000067C FFCB                <1>     dec ebx
   532 0000067E 01D8                <1>     add eax, ebx    ;TmpVal1 + (TmpVal2 - 1)
   533 00000680 FFC3                <1>     inc ebx
   534 00000682 31D2                <1>     xor edx, edx
   535 00000684 F7F3                <1>     div ebx ;Exit with eax = number of sectors needed per FAT
   536                              <1> .exit:
   537 00000686 5F                  <1>     pop rdi
   538 00000687 5A                  <1>     pop rdx
   539 00000688 59                  <1>     pop rcx
   540 00000689 5B                  <1>     pop rbx
