   117 00000AC0 00                  <1>     at .reserved1,      db 00h
   118 00000AC1 29                  <1>     at .bootSig,        db extBsSig ;Normal signature
   119 00000AC2 FFFFFFFF            <1>     at .volId,          dd -1       ;Set to date/time @ format
