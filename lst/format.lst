    35                              <1> writeDiskStats:
    36                              <1> ;Writes the disk statistics after a format.
    37                              <1> ;-------------------------------------------------------
    38                              <1> ;<Number> bytes total disk space
    39                              <1> ;<Number> bytes used by system (if /S set and system files installed)
    40                              <1> ;<Number> bytes in bad sectors (if bad sectors. Always rounds to # of clusters)
    41                              <1> ;<Number> bytes available on disk 
    42                              <1> ;
    43                              <1> ;<Number> bytes in each allocation unit.
    44                              <1> ;<Number> allocation units available on disk. ;alloc units are clusters
    45                              <1> ;
    46                              <1> ;Volume Serial Number is <Serial-Number>
    47                              <1> ;-------------------------------------------------------
    48                              <1> ;Start start by putting a new line
    49 000007D5 488D15AB090000      <1>     lea rdx, crlfStr
    50 000007DC E82AFFFFFF          <1>     call printString
    51                              <1>     breakpoint
    81 000007E1 6687DB              <2> xchg bx, bx
    52                              <1> ;Start by getting free sector count from DOS. We do this to make the 
    53                              <1> ; computation of the free sector count easier after /s and if any bad clusters.
    54 000007E4 B800360000          <1>     mov eax, 3600h  ;Get free space count
    55 000007E9 0FB615A0040000      <1>     movzx edx, byte [fmtDrive]
    56 000007F0 FFC2                <1>     inc edx ;Turn into a 1 based count
    57 000007F2 CD21                <1>     int 21h
    58                              <1> ;If we have a FAT 32 drive, add one cluster to the free count to account for
    59                              <1> ; the root directory cluster.
    60 000007F4 803DB104000002      <1>     cmp byte [fatType], fs_fat32
    61 000007FB 7502                <1>     jne .goSave
    62 000007FD FFC3                <1>     inc ebx ;Discount the root directory from initial count!
    63                              <1> .goSave:
    64                              <1> ;Use x64 regs instead of stack frame
    65 000007FF 4989D0              <1>     mov r8, rdx ;r8 = Total cluster count in data area
    66 00000802 4989D9              <1>     mov r9, rbx ;r9 = Free cluster count in the data area
    67                              <1> ;Total number of bytes, ebx still has total count
    68 00000805 0FB605AB040000      <1>     movzx eax, byte [secPerClust]
    69 0000080C 0FB70D9A040000      <1>     movzx ecx, word [sectorSize]
    70 00000813 F7E1                <1>     mul ecx     ;Get the number of bytes per cluster in eax
    71 00000815 4989C2              <1>     mov r10, rax    ;Save this value in r10
    72 00000818 49F7E0              <1>     mul r8      ;Get in eax the number of bytes on disk
    73 0000081B E868010000          <1>     call printDecimalDword
    74 00000820 488D15400A0000      <1>     lea rdx, totalBytesStr
    75 00000827 E8DFFEFFFF          <1>     call printString
    76                              <1> ;System bytes
    77 0000082C F6056F04000002      <1>     test byte [bFlag1], bitSystem
    78 00000833 741E                <1>     jz .skipSystem
    79 00000835 4C89C9              <1>     mov rcx, r9     ;Get the free cluster count
    80 00000838 4C89C0              <1>     mov rax, r8     ;Get the total cluster count
    81 0000083B 29C8                <1>     sub eax, ecx    ;Workout the amount of space taken by system files
    82 0000083D 4C89D1              <1>     mov rcx, r10    ;Get word BytesPerClust
    83 00000840 F7E1                <1>     mul ecx         ;Get the number of bytes taken by system files
    84 00000842 E841010000          <1>     call printDecimalDword
    85 00000847 488D15330A0000      <1>     lea rdx, sysBytesStr
    86 0000084E E8B8FEFFFF          <1>     call printString
    87                              <1> .skipSystem:
    88                              <1> ;Bad cluster bytes
    89 00000853 8B0D79040000        <1>     mov ecx, dword [dBadClust]
    90 00000859 85C9                <1>     test ecx, ecx
    91 0000085B 741B                <1>     jz .skipBad
    92 0000085D 4C89C0              <1>     mov rax, r8     ;Get the total cluster count
    93 00000860 29C8                <1>     sub eax, ecx
    94 00000862 4C89D1              <1>     mov rcx, r10    ;Get word BytesPerClust
    95 00000865 F7E1                <1>     mul ecx         ;Get the number of bytes taken by bad clusters
    96 00000867 E81C010000          <1>     call printDecimalDword
    97 0000086C 488D15260A0000      <1>     lea rdx, badSectStr
    98 00000873 E893FEFFFF          <1>     call printString
    99                              <1> .skipBad:
   100                              <1> ;Free bytes
   101 00000878 4C89C8              <1>     mov rax, r9     ;Get free cluster count
   102 0000087B 4C89D1              <1>     mov rcx, r10    ;Get word BytesPerClust
   103 0000087E F7E1                <1>     mul ecx         ;Get the number of free bytes
   104 00000880 E803010000          <1>     call printDecimalDword
   105 00000885 488D15250A0000      <1>     lea rdx, availableBytesStr
   106 0000088C E87AFEFFFF          <1>     call printString
   107                              <1> ;Bytes per cluster
   108 00000891 4C89D0              <1>     mov rax, r10    ;Get word BytesPerClust
   109 00000894 E8EF000000          <1>     call printDecimalDword
   110 00000899 488D152D0A0000      <1>     lea rdx, clustSzStr
   111 000008A0 E866FEFFFF          <1>     call printString
   112                              <1> ;Number of clusters
   113 000008A5 4C89C0              <1>     mov rax, r8     ;Get the total cluster count
   114 000008A8 E8DB000000          <1>     call printDecimalDword
   115 000008AD 488D153B0A0000      <1>     lea rdx, totClusStr
   116 000008B4 E852FEFFFF          <1>     call printString
   117                              <1> ;Vol Serial Number
   118 000008B9 488D15570A0000      <1>     lea rdx, volSerialNumStr
   119 000008C0 E846FEFFFF          <1>     call printString
   120 000008C5 488D3502040000      <1>     lea rsi, qword [dSerNum]
   121 000008CC AC                  <1>     lodsb
   122 000008CD E829000000          <1>     call printHexByte
   123 000008D2 AC                  <1>     lodsb
   124 000008D3 E823000000          <1>     call printHexByte
   125 000008D8 BA2D000000          <1>     mov edx, "-"
   126 000008DD E821FEFFFF          <1>     call putch
   127 000008E2 AC                  <1>     lodsb
   128 000008E3 E813000000          <1>     call printHexByte
   129 000008E8 AC                  <1>     lodsb
   130 000008E9 E80D000000          <1>     call printHexByte
   131                              <1> ;We are done so print a new line :)
   132 000008EE 488D1592080000      <1>     lea rdx, crlfStr
   133 000008F5 E811FEFFFF          <1>     call printString    ;Output a new line!
   134                              <1>     return
    13                              <2> %%_ret:
    14 000008FA C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
