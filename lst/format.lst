   165                              <1> endstruc
    47                                  ;Default behaviour is to always zero all data sectors of the disk as well. 
    48                                  ; This is done to also pick up bad clusters to mark them as bad in the FAT.
    49                                  bitQuick    equ 1   ;/Q -> Do quick format, no zeroing. No bad sect. checks.
    50                                  bitSystem   equ 2   ;/S -> Install system files. 
    51                                  ;Checks: current drive:\currentdir, A:\ [copies whole files into memory]
    52                                  bitVolume   equ 4   ;/V:[LABEL] -> Don't prompt volume, use LABEL directly.
    53                                  bitBadChck  equ 8   ;/C -> Checks if bad clusters are still bad. 
    54                                  ; If this is specified, doesn't format the disk.
    55                                  ;Next three hold only on remdevs. If these bits set on fixed disk, bad parm!
    56                                  ;-----------------------------------v
    57                                  bitSec      equ 10  ;/N:<Sectors>.  | These two must both be set, else
    58                                  bitTrk      equ 20  ;/T:<Tracks>.   |  bad parameter! Suppose double sided
    59                                  ;-----------------------------------^
    60                                  bitFloppy   equ 40  ;/F:<size> -> Specify the size of volume. 
    61                                  ;Options are: 160, 180, 320, 360, 720, 1.2, 1.44, 2.88 (written as strings)
    62                                  
    63                                  ;Either /F Floppy is set or {/N /T}. Not both!
    64                                  
