   776                              <1> doYNWait:
   777                              <1> ;Input: rdx -> String to wait for Y/N on.
   778                              <1> ;Output: CF=NC -> N
   779                              <1> ;        CF=CY -> Y
   780 000008E2 52                  <1>     push rdx
   781 000008E3 E855000000          <1>     call printString
   782 000008E8 E840000000          <1>     call getch
   783 000008ED 3C79                <1>     cmp al, "y"
   784 000008EF 740F                <1>     je .yes
   785 000008F1 3C59                <1>     cmp al, "Y"
   786 000008F3 740B                <1>     je .yes
   787 000008F5 3C6E                <1>     cmp al, "n"
   788 000008F7 7408                <1>     je .no
   789 000008F9 3C4E                <1>     cmp al, "N"
   790 000008FB 7404                <1>     je .no
   791 000008FD 5A                  <1>     pop rdx
   792 000008FE EB03                <1>     jmp short breakRoutine
   793                              <1> .yes:
   794 00000900 F9                  <1>     stc
   795                              <1> .no:
   796 00000901 5A                  <1>     pop rdx
   797                              <1>     return
