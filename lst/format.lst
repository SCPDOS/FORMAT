   357 00000AFB 0FB7C1              <1>     movzx eax, cx
   358 00000AFE C1E310              <1>     shl ebx, 10h
   359 00000B01 09D8                <1>     or eax, ebx
   360 00000B03 5B                  <1>     pop rbx
   361                              <1>     return
