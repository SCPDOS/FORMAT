   492                              <1> printDecimalValLB:
   493                              <1> ;Takes a value in rax and prints it's decimal representation with leading
   494                              <1> ; blanks and inserts commas where appropriate.
   495                              <1> ;Input: rax = Value to print
   496                              <1> ;       rcx = Buffer size to handle (usual values: 17 for max, 13 for dword)
   497 0000066E 4889E5              <1>     mov rbp, rsp
   498 00000671 4829CC              <1>     sub rsp, rcx ;Allocate the buffer on the stack
   499 00000674 4889EF              <1>     mov rdi, rbp
   500 00000677 4829CF              <1>     sub rdi, rcx
   501 0000067A 50                  <1>     push rax
   502 0000067B 51                  <1>     push rcx
   503 0000067C 57                  <1>     push rdi
   504 0000067D 31C0                <1>     xor eax, eax
   505 0000067F F3AA                <1>     rep stosb   ;Initialise the buffer with a null value
   506 00000681 5F                  <1>     pop rdi     ;Now set the ptr to the head of the buffer
   507 00000682 59                  <1>     pop rcx
   508 00000683 58                  <1>     pop rax
   509 00000684 51                  <1>     push rcx    ;Save this value to keep the buffer length
   510 00000685 E83E000000          <1>     call decimalise   ;If return with CF=CY, error!
   511 0000068A 59                  <1>     pop rcx     ;Now print the buffer
   512 0000068B 4889EF              <1>     mov rdi, rbp
   513 0000068E 48FFCF              <1>     dec rdi     ;Doesn't affect CF
   514 00000691 722C                <1>     jc .errPrint    ;Print a mis-aligned ? to clearly mark an error!
   515                              <1> .skipLp:
   516 00000693 8A1F                <1>     mov bl, byte [rdi]
   517 00000695 84DB                <1>     test bl, bl ;Any leading null's get replaced with a space
   518 00000697 7514                <1>     jne .printLp
   519 00000699 B220                <1>     mov dl, " "
   520 0000069B E895020000          <1>     call putch
   521 000006A0 48FFCF              <1>     dec rdi
   522 000006A3 FFC9                <1>     dec ecx
   523 000006A5 81F901000000        <1>     cmp ecx, 1
   524 000006AB 75E6                <1>     jne .skipLp   ;Always print 1 byte for size
   525                              <1> .printLp:
   526 000006AD 8A17                <1>     mov dl, byte [rdi]
   527 000006AF E881020000          <1>     call putch
   528 000006B4 48FFCF              <1>     dec rdi
   529 000006B7 FFC9                <1>     dec ecx
   530 000006B9 75F2                <1>     jnz .printLp
   531                              <1> .exit:
   532 000006BB 4889EC              <1>     mov rsp, rbp    ;Deallocate the buffer and exit!
   533                              <1>     return
