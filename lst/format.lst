   208                              <1> checkDrvFixed:
   209                              <1> ;Checks if the drive input is fixed
   210                              <1> ;Input: ebx = Drive number (1-based)
   211                              <1> ;Output: CF=NC -> Fixed
   212                              <1> ;        CF=CY -> Removable
   213 00000DE6 50                  <1>     push rax
   214 00000DE7 52                  <1>     push rdx
   215 00000DE8 B808440000          <1>     mov eax, 4408h  ;Fixed check
   216 00000DED CD21                <1>     int 21h
   217 00000DEF 7312                <1>     jnc .check
   218 00000DF1 B809440000          <1>     mov eax, 4409h  ;Net check, default to fixed if something goes awry
   219 00000DF6 CD21                <1>     int 21h
   220 00000DF8 7216                <1>     jc .fixed
   221 00000DFA 66F7C20010          <1>     test dx, 1000h  ;Is this a net disk?
   222 00000DFF 750F                <1>     jnz .fixed
   223 00000E01 EB07                <1>     jmp short .rem
   224                              <1> .check:
   225 00000E03 A901000000          <1>     test eax, 1 ;eax = 1 if fixed
   226 00000E08 7506                <1>     jnz .fixed
   227                              <1> .rem:
   228 00000E0A F9                  <1>     stc
   229 00000E0B EB04                <1>     jmp short .exit
   230 00000E0D 5A                  <1>     pop rdx
   231 00000E0E 58                  <1>     pop rax
   232                              <1>     return
    13                              <2> %%_ret:
    14 00000E0F C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
