   158                              <1> writeStatusUpdate:
   159 0000093D 51                  <1>     push rcx
   160 0000093E 52                  <1>     push rdx
   161 0000093F 488B0598030000      <1>     mov rax, qword [secWritten]
   162 00000946 BB64000000          <1>     mov ebx, 100
   163 0000094B 48F7E3              <1>     mul rbx ;Multiply number of sectors by 100
   164 0000094E 488B1D81030000      <1>     mov rbx, qword [secToWrite]
   165 00000955 31D2                <1>     xor edx, edx
   166 00000957 48F7F3              <1>     div rbx ;Get percentage of written sectors in rax (formally al)
   167 0000095A 3A0586030000        <1>     cmp al, byte [secPercent]
   168 00000960 7423                <1>     je .exit    ;If they are equal, dont bother printing again
   169                              <1> ;Here we have a new percentage! Update the message!
   170 00000962 88057E030000        <1>     mov byte [secPercent], al
   171 00000968 B903000000          <1>     mov ecx, 3  ;Max 3 chars to print (up to 100)
   172 0000096D E823000000          <1>     call printDecimalValLB
   173 00000972 488D1521080000      <1>     lea rdx, fmtPcntMsg
   174 00000979 E88DFDFFFF          <1>     call printString
   175 0000097E B20D                <1>     mov dl, CR
   176 00000980 E87EFDFFFF          <1>     call putch  ;End by returning to the start of the line
   177                              <1> .exit:
   178 00000985 5A                  <1>     pop rdx
   179 00000986 59                  <1>     pop rcx
   180                              <1>     return 
