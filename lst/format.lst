   230 000009CA 75F2                <1>     jnz .l1
   231                              <1> .exit:
   232 000009CC 48FFCE              <1>     dec rsi ;Point rsi back to the char which is a command delimiter
   233 000009CF FFC1                <1>     inc ecx
   234                              <1> .exit2:
   235 000009D1 58                  <1>     pop rax
   236                              <1>     return
