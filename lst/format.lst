    57                              <1> computeFAT:
    58                              <1> ;Returns if FAT12/16/32 should be used for volume parameters input.
    59                              <1> ;Output: ecx = 0 => FAT 12, ecx = 1 => FAT 16, ecx = 2 => FAT 32
    60                              <1> ;All other regs preserved
    61 00000CD4 50                  <1>     push rax
    62 00000CD5 52                  <1>     push rdx
    63 00000CD6 57                  <1>     push rdi
    64 00000CD7 488B3D05060000      <1>     mov rdi, [bpbPtr]   ;Get ptr to the returned bpb
    65                              <1> ;Compute space taken by fats
    66 00000CDE 0FB7470B            <1>     movzx eax, word [rdi + bpb.FATsz16]
    67 00000CE2 0FB64F05            <1>     movzx ecx, byte [rdi + bpb.numFATs]
    68 00000CE6 F7E1                <1>     mul ecx ;Get number of sectors occupied by all the fat copies
    69 00000CE8 66034703            <1>     add ax, word [rdi + bpb.revdSecCnt] ;Add the number of reserved sectors
    70 00000CEC 66034706            <1>     add ax, word [rdi + bpb.rootEntCnt] ;Add the root dir sectors
    71 00000CF0 50                  <1>     push rax    ;Save the non-data space
    72                              <1> ;Get the total number of sectors on the volume in eax
    73 00000CF1 0FB74708            <1>     movzx eax, word [rdi + bpb.totSec16]
    74 00000CF5 8B4F15              <1>     mov ecx, dword [rdi + bpb.totSec32]
    75 00000CF8 85C0                <1>     test eax, eax
    76 00000CFA 0F44C1              <1>     cmovz eax, ecx  ;Move ecx to to eax if eax is zero
    77 00000CFD 59                  <1>     pop rcx
    78 00000CFE 29C8                <1>     sub eax, ecx    ;Get the data space only in eax.
    79 00000D00 0FB64F02            <1>     movzx ecx, byte [rdi + bpb.secPerClus]
    80 00000D04 85C9                <1>     test ecx, ecx
    81 00000D06 67E31F              <1>     jecxz .err  ;If this is zero, due to malformed field, escape. Use FAT16
    82 00000D09 31D2                <1>     xor edx, edx
    83 00000D0B F7F1                <1>     div ecx         ;Get number of clusters in eax
    84                              <1> ;Now setup the return value in ecx
    85 00000D0D B902000000          <1>     mov ecx, 2  ;FAT 32 marker
    86 00000D12 3DF5FF0000          <1>     cmp eax, fat16MaxClustCnt
    87 00000D17 730B                <1>     jae .exit
    88 00000D19 FFC9                <1>     dec ecx     ;FAT 16 marker
    89 00000D1B 3DF50F0000          <1>     cmp eax, fat12MaxClustCnt
    90 00000D20 7302                <1>     jae .exit
    91 00000D22 FFC9                <1>     dec ecx     ;FAT 12 marker
    92                              <1> .exit:
    93 00000D24 5F                  <1>     pop rdi
    94 00000D25 5A                  <1>     pop rdx
    95 00000D26 58                  <1>     pop rax
    96                              <1>     return
    13                              <2> %%_ret:
    14 00000D27 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
    97                              <1> .err:
    98                              <1> ;To prevent a divide by 0 error!
    99 00000D28 FFC9                <1>     dec ecx
   100 00000D2A EBF8                <1>     jmp short .exit
   101                              <1> 
   102                              <1> computeFATSize:
   103                              <1> ; Reads from the bpb in rdi. Applies the following algorithm
   104                              <1> ; RootDirSectors = ((BPB_RootEntCnt * 32) + (BPB_BytsPerSec – 1)) / BPB_BytsPerSec;
   105                              <1> ; TmpVal1 = DskSize – (BPB_ResvdSecCnt + RootDirSectors);
   106                              <1> ; TmpVal2 = (256 * BPB_SecPerClus) + BPB_NumFATs;
   107                              <1> ; If(FATType == FAT32)
   108                              <1> ;   TmpVal2 = TmpVal2 / 2;
   109                              <1> ; FATSz = (TMPVal1 + (TmpVal2 – 1)) / TmpVal2;
   110                              <1> ;Input:
   111                              <1> ;   rdi = Pointer to the head of the BPB we are using
   112                              <1> ;Returns: 
   113                              <1> ;   eax = Number of sectors per FAT needed. Low word only valid for FAT12/16
   114                              <1> ;   dword [fatSize] = eax
   115 00000D2C 53                  <1>     push rbx
   116 00000D2D 51                  <1>     push rcx
   117 00000D2E 52                  <1>     push rdx
   118 00000D2F 57                  <1>     push rdi
   119                              <1>     
   120 00000D30 0FB74706            <1>     movzx eax, word [rdi + bpb.rootEntCnt]
   121 00000D34 C1E005              <1>     shl eax, 5  ;Multiply by 32
   122 00000D37 0FB71F              <1>     movzx ebx, word [rdi + bpb.bytsPerSec]
   123 00000D3A FFCB                <1>     dec ebx
   124 00000D3C 01D8                <1>     add eax, ebx
   125 00000D3E FFC3                <1>     inc ebx
   126 00000D40 31D2                <1>     xor edx, edx
   127 00000D42 F7F3                <1>     div ebx
   128 00000D44 89C2                <1>     mov edx, eax    ;edx = RootDirSectors
   129                              <1> 
   130 00000D46 0FB74708            <1>     movzx eax, word [rdi + bpb.totSec16]
   131 00000D4A 8B5F15              <1>     mov ebx, dword [rdi + bpb.totSec32]
   132 00000D4D 85C0                <1>     test eax, eax   ;If totSec16 is 0, move totSec32 into eax
   133 00000D4F 0F44C3              <1>     cmovz eax, ebx
   134 00000D52 0FB75F03            <1>     movzx ebx, word [rdi + bpb.revdSecCnt]
   135 00000D56 01D3                <1>     add ebx, edx    ;Add RootDirSectors
   136 00000D58 29D8                <1>     sub eax, ebx
   137 00000D5A 89C1                <1>     mov ecx, eax    ;ecx = TmpVal1
   138                              <1> 
   139 00000D5C 0FB64702            <1>     movzx eax, byte [rdi + bpb.secPerClus]
   140 00000D60 C1E008              <1>     shl eax, 8  ;multiply by 256
   141 00000D63 0FB65F05            <1>     movzx ebx, byte [rdi + bpb.numFATs]
   142 00000D67 01C3                <1>     add ebx, eax    ;ebx = TmpVal2
   143                              <1> 
   144 00000D69 803D6A05000002      <1>     cmp byte [fatType], fs_fat32
   145 00000D70 7502                <1>     jne .notFat32
   146 00000D72 D1EB                <1>     shr ebx, 1  ;Divide by 2
   147                              <1> .notFat32: 
   148 00000D74 89C8                <1>     mov eax, ecx    ;TmpVal1
   149 00000D76 FFCB                <1>     dec ebx
   150 00000D78 01D8                <1>     add eax, ebx    ;TmpVal1 + (TmpVal2 - 1)
   151 00000D7A FFC3                <1>     inc ebx
   152 00000D7C 31D2                <1>     xor edx, edx
   153 00000D7E F7F3                <1>     div ebx ;Exit with eax = number of sectors needed per FAT
   154 00000D80 890571050000        <1>     mov dword [fatSize], eax
   155 00000D86 5F                  <1>     pop rdi
   156 00000D87 5A                  <1>     pop rdx
   157 00000D88 59                  <1>     pop rcx
   158 00000D89 5B                  <1>     pop rbx
   159                              <1>     return
    13                              <2> %%_ret:
    14 00000D8A C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   160                              <1> 
   161                              <1> clust2FATEntry:
   162                              <1> ;Converts a cluster number to a offset in the FAT
   163                              <1> ;Entry:  Uses the bpbPtr to convert cluster number
   164                              <1> ;        eax = Cluster number to look for
   165                              <1> ;Exit:   eax = Sector on disk of FAT 
   166                              <1> ;        ecx = 0 => FAT12, 1 => FAT16, 2 => FAT32
   167                              <1> ;        edx = 1.5Byte/Word/DWord in sector of entry
   168 00000D8B 53                  <1>     push rbx
   169 00000D8C 55                  <1>     push rbp
   170 00000D8D 488B2D4F050000      <1>     mov rbp, qword [bpbPtr]
   171 00000D94 0FB61D3F050000      <1>     movzx ebx, byte [fatType]
   172 00000D9B 81FB01000000        <1>     cmp ebx, 1
   173 00000DA1 720B                <1>     jb .fat12
   174 00000DA3 7716                <1>     ja .fat32
   175                              <1> ;FAT16
   176 00000DA5 D1E0                <1>     shl eax, 1  ;Multiply cluster number by 2
   177 00000DA7 6801000000          <1>     push qword 1
   178 00000DAC EB15                <1>     jmp short .common
   179                              <1> .fat12:
   180 00000DAE 89C1                <1>     mov ecx, eax    ;ecx = eax
   181 00000DB0 D1E9                <1>     shr ecx, 1      ;ecx = ecx / 2
   182 00000DB2 01C8                <1>     add eax, ecx    ;eax = eax + ecx    (eax * 1.5)
   183 00000DB4 6800000000          <1>     push qword 0
   184 00000DB9 EB08                <1>     jmp short .common
   185                              <1> .fat32:
   186 00000DBB 6802000000          <1>     push qword 2
   187 00000DC0 C1E002              <1>     shl eax, 2  ;Multiply cluster number by 4
   188                              <1> .common:
   189                              <1> ;eax has the FAToffset
   190 00000DC3 0FB74D00            <1>     movzx ecx, word [rbp + bpb.bytsPerSec]
   191 00000DC7 31D2                <1>     xor edx, edx    ;edx = 0
   192 00000DC9 F7F1                <1>     div ecx         ;Divide by bytes per sector (0:eax / ecx)
   193 00000DCB 0FB75D03            <1>     movzx ebx, word [rbp + bpb.revdSecCnt]   ;Add the offset to the first FAT
   194 00000DCF 01D8                <1>     add eax, ebx
   195 00000DD1 59                  <1>     pop rcx ;Pop the FAT type back into rcx
   196 00000DD2 5D                  <1>     pop rbp
   197 00000DD3 5B                  <1>     pop rbx
   198                              <1>     return
    13                              <2> %%_ret:
    14 00000DD4 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   199                              <1> 
   200                              <1> cleanBuffer:
   201                              <1> ;Cleans the 4K buffer
   202 00000DD5 488B3DDB040000      <1>     mov rdi, qword [pBuffer]
   203 00000DDC B900100000          <1>     mov ecx, 4096
   204 00000DE1 31C0                <1>     xor eax, eax
   205 00000DE3 F3AA                <1>     rep stosb   ;Clean the Sector buffer
   206                              <1>     return
    13                              <2> %%_ret:
    14 00000DE5 C3                  <2>  ret
