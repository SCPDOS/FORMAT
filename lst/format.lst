   294                              <1> .quick:
   295 00000D00 8B0518030000        <1>     mov eax, dword [fatSize]
   296 00000D06 48D1E0              <1>     shl rax, 1  ;Multiply this value by 2 for two FATs
   297 00000D09 4889052C030000      <1>     mov qword [secToWrite], rax
   298 00000D10 803DFB02000002      <1>     cmp byte [fatType], fs_fat32
   299 00000D17 742A                <1>     je .fat32
   300                              <1> ;Add the sectors for the root directory and single bootsector
   301 00000D19 488B3503030000      <1>     mov rsi, qword [bpbPtr]
   302 00000D20 0FB74606            <1>     movzx eax, word [rsi + bpb.rootEntCnt]  ;Number of 32 bit entries
   303 00000D24 C1E005              <1>     shl eax, 5  ;Get number of bytes in root dir
   304 00000D27 0FB736              <1>     movzx esi, word [rsi + bpb.bytsPerSec]
   305 00000D2A 31D2                <1>     xor edx, edx
   306 00000D2C F7F6                <1>     div esi ;Get number of whole sectors in eax. edx is remainder. 
   307 00000D2E FFC0                <1>     inc eax ;Add one for the bootsector
   308 00000D30 48010505030000      <1>     add qword [secToWrite], rax ;Add whole sectors and bootsector to count
   309 00000D37 85D2                <1>     test edx, edx   ;If no remainder (should never be a remainder), exit
   310                              <1>     retz
    41                              <2> cret z
