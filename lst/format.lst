   117 00000B4F F0                  <1>     at .media,       db 0F0h         ;Media byte
   118 00000B50 0000                <1>     at .FATsz16,     dw 0            ;Not a FAT 12/16 BPB
   119 00000B52 3F00                <1>     at .secPerTrk,   dw 003Fh        ;FAT16 and 32 have Hard disk geometry 
   120 00000B54 FF00                <1>     at .numHeads,    dw 00FFh        ;255 Heads
   121 00000B56 FFFFFFFF            <1>     at .hiddSec,     dd -1           ;No hidden sectors on removable
