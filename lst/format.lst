    56                              <1> ;--------------------------------------
    57                              <1> ;          Utility functions          :
    58                              <1> ;--------------------------------------
    59                              <1> writeDiskStats:
    60                              <1> ;Writes the disk statistics after a format.
    61                              <1> ;-------------------------------------------------------
    62                              <1> ;<Number> bytes total disk space
    63                              <1> ;<Number> bytes used by system (if /S set and system files installed)
    64                              <1> ;<Number> bytes in bad sectors (if bad sectors. Always rounds to # of clusters)
    65                              <1> ;<Number> bytes available on disk 
    66                              <1> ;
    67                              <1> ;<Number> bytes in each allocation unit.
    68                              <1> ;<Number> allocation units available on disk. ;alloc units are clusters
    69                              <1> ;
    70                              <1> ;Volume Serial Number is <Serial-Number>
    71                              <1> ;-------------------------------------------------------
    72                              <1> ;Start start by putting a new line
    73 00000ECA 488D15440A0000      <1>     lea rdx, crlfStr
    74 00000ED1 E8B2FFFFFF          <1>     call printString
    75                              <1> ;Start by getting free sector count from DOS. We do this to make the 
    76                              <1> ; computation of the free sector count easier after /s and if any bad clusters.
    77 00000ED6 B800360000          <1>     mov eax, 3600h  ;Get free space count
    78 00000EDB 0FB615D4030000      <1>     movzx edx, byte [fmtDrive]
    79 00000EE2 FFC2                <1>     inc edx ;Turn into a 1 based count
    80 00000EE4 CD21                <1>     int 21h
    81                              <1> ;If we have a FAT 32 drive, add one cluster to the free count to account for
    82                              <1> ; the root directory cluster.
    83 00000EE6 803DED03000002      <1>     cmp byte [fatType], fs_fat32
    84 00000EED 7502                <1>     jne .goSave
    85 00000EEF FFC3                <1>     inc ebx ;Discount the root directory from initial count!
    86                              <1> .goSave:
    87                              <1> ;Use x64 regs instead of stack frame
    88 00000EF1 4989D0              <1>     mov r8, rdx ;r8 = Total cluster count in data area
    89 00000EF4 4989D9              <1>     mov r9, rbx ;r9 = Free cluster count in the data area
    90                              <1> ;Total number of bytes, ebx still has total count
    91 00000EF7 0FB605F8030000      <1>     movzx eax, byte [secPerClust]
    92 00000EFE 0FB70DE7030000      <1>     movzx ecx, word [sectorSize]
    93 00000F05 F7E1                <1>     mul ecx     ;Get the number of bytes per cluster in eax
    94 00000F07 4989C2              <1>     mov r10, rax    ;Save this value in r10
    95 00000F0A 49F7E0              <1>     mul r8      ;Get in eax the number of bytes on disk
    96 00000F0D E862010000          <1>     call printDecimalDword
    97 00000F12 488D150A0B0000      <1>     lea rdx, totalBytesStr
    98 00000F19 E86AFFFFFF          <1>     call printString
    99                              <1> ;System bytes
   100 00000F1E F6059A03000002      <1>     test byte [bFlag1], bitSystem
   101 00000F25 741E                <1>     jz .skipSystem
   102 00000F27 4C89C9              <1>     mov rcx, r9     ;Get the free cluster count
   103 00000F2A 4C89C0              <1>     mov rax, r8     ;Get the total cluster count
   104 00000F2D 29C8                <1>     sub eax, ecx    ;Workout the amount of space taken by system files
   105 00000F2F 4C89D1              <1>     mov rcx, r10    ;Get word BytesPerClust
   106 00000F32 F7E1                <1>     mul ecx         ;Get the number of bytes taken by system files
   107 00000F34 E83B010000          <1>     call printDecimalDword
   108 00000F39 488D15FD0A0000      <1>     lea rdx, sysBytesStr
   109 00000F40 E843FFFFFF          <1>     call printString
   110                              <1> .skipSystem:
   111                              <1> ;Bad cluster bytes
   112 00000F45 8B0DCA030000        <1>     mov ecx, dword [dBadClust]
   113 00000F4B 85C9                <1>     test ecx, ecx
   114 00000F4D 741B                <1>     jz .skipBad
   115 00000F4F 4C89C0              <1>     mov rax, r8     ;Get the total cluster count
   116 00000F52 29C8                <1>     sub eax, ecx
   117 00000F54 4C89D1              <1>     mov rcx, r10    ;Get word BytesPerClust
   118 00000F57 F7E1                <1>     mul ecx         ;Get the number of bytes taken by bad clusters
   119 00000F59 E816010000          <1>     call printDecimalDword
   120 00000F5E 488D15F00A0000      <1>     lea rdx, badSectStr
   121 00000F65 E81EFFFFFF          <1>     call printString
   122                              <1> .skipBad:
   123                              <1> ;Free bytes
   124 00000F6A 4C89C8              <1>     mov rax, r9     ;Get free cluster count
   125 00000F6D 4C89D1              <1>     mov rcx, r10    ;Get word BytesPerClust
   126 00000F70 F7E1                <1>     mul ecx         ;Get the number of free bytes
   127 00000F72 E8FD000000          <1>     call printDecimalDword
   128 00000F77 488D15EF0A0000      <1>     lea rdx, availableBytesStr
   129 00000F7E E805FFFFFF          <1>     call printString
   130                              <1> ;Bytes per cluster
   131 00000F83 4C89D0              <1>     mov rax, r10    ;Get word BytesPerClust
   132 00000F86 E8E9000000          <1>     call printDecimalDword
   133 00000F8B 488D15F70A0000      <1>     lea rdx, clustSzStr
   134 00000F92 E8F1FEFFFF          <1>     call printString
   135                              <1> ;Number of clusters
   136 00000F97 4C89C0              <1>     mov rax, r8     ;Get the total cluster count
   137 00000F9A E8D5000000          <1>     call printDecimalDword
   138 00000F9F 488D15050B0000      <1>     lea rdx, totClusStr
   139 00000FA6 E8DDFEFFFF          <1>     call printString
   140                              <1> ;Vol Serial Number
   141 00000FAB 488D15210B0000      <1>     lea rdx, volSerialNumStr
   142 00000FB2 E8D1FEFFFF          <1>     call printString
   143 00000FB7 488D3546030000      <1>     lea rsi, qword [dSerNum]
   144 00000FBE AC                  <1>     lodsb
   145 00000FBF E829000000          <1>     call printHexByte
   146 00000FC4 AC                  <1>     lodsb
   147 00000FC5 E823000000          <1>     call printHexByte
   148 00000FCA BA2D000000          <1>     mov edx, "-"
   149 00000FCF E8ACFEFFFF          <1>     call putch
   150 00000FD4 AC                  <1>     lodsb
   151 00000FD5 E813000000          <1>     call printHexByte
   152 00000FDA AC                  <1>     lodsb
   153 00000FDB E80D000000          <1>     call printHexByte
   154                              <1> ;We are done so print a new line :)
   155 00000FE0 488D152E090000      <1>     lea rdx, crlfStr
   156 00000FE7 E89CFEFFFF          <1>     call printString    ;Output a new line!
   157                              <1>     return
