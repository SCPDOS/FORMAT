   940                              <1> 
   941                              <1> ;Do not put the whole format through a critical section, that is insane!
   942                              <1> ;Use a DOS networking extension to obtain a handle to the drive.
   943                              <1> dosCrit1Enter:
   944 00000A34 C60513000000FF      <1>     mov byte [inCrit], -1   ;Entering a DOS level 1 critical section
   945                              <1>     ;push rax 
   946                              <1>     ;mov eax, 8001h
   947                              <1>     ;int 2ah
   948                              <1>     ;pop rax
   949                              <1>     return
    13                              <2> %%_ret:
    14 00000A3B C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   950                              <1> dosCrit1Exit:
   951 00000A3C F6050B000000FF      <1>     test byte [inCrit], -1  ;If we are not in a critical section, just return
   952                              <1>     retz
    41                              <2> cret z
    19                              <3> %%_base:
    20                              <3> %assign baseVar %%_base-$$
    21                              <3>  %ifdef retOff
    22                              <3>  %if (baseVar - retOff <= 126) && (baseVar > retOff)
    23                              <3>  %ifdef currSegVBase
    24                              <3>  j%+1 short (retOff+currSegVBase)
    25                              <3>  %else
    26 00000A43 74(3B)              <3>  j%+1 short retOff
    27                              <3>  %endif
    28                              <3>  %else
    29                              <3>  j%-1 short %%a
    30                              <3>  return
    31                              <3> %%a:
    32                              <3>  %endif
    33                              <3>  %else
    34                              <3>  j%-1 short %%a
    35                              <3>  return
    36                              <3> %%a:
    37                              <3>  %endif
   953                              <1>     ;push rax 
   954                              <1>     ;mov eax, 8101h          
   955                              <1>     ;int 2ah
   956                              <1>     ;pop rax
   957 00000A45 C6050200000000      <1>     mov byte [inCrit], 0    ;Indicate we have exited the critical section
   958                              <1>     return
    13                              <2> %%_ret:
    14 00000A4C C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
    62                                  %include "./dat/fmtData.asm"
     1                              <1> ;IOCTL request header
     2                              <1> ;Data area here
     3 00000A4D FF                  <1> fmtDrive    db -1       ;Drive we are operating on (0 based)
     4 00000A4E 00                  <1> inCrit      db 0        ;If not 0, in a critical section, must exit
     5 00000A4F 0000000000000000    <1> cdsPtr      dq 0        ;CDS ptr here
     6 00000A57 0000000000000000    <1> bufferArea  dq 0        ;Ptr to the buffer area
     7                              <1> ;HARDCODED TO BE QUICK FORMAT FOR NOW
     8 00000A5F FF                  <1> quickByte   db -1       ;If /Q, don't zero all sectors first. Set if /Q.
     9                              <1> ;Format Data here
    10 00000A60 00                  <1> remDev      db 0        ;0 = Removable, -1 = Fixed
    11 00000A61 FF                  <1> fatType     db -1       ;0 = FAT12, 1 = FAT16, 2 = FAT32, -1 = No FAT
    12 00000A62 0000                <1> sectorSize  dw 0        ;Sector size in bytes
    13 00000A64 0000000000000000    <1> numSectors  dq 0        ;Number of sectors in volume
    14 00000A6C 00                  <1> secPerClust db 0        ;Copy the sectors per cluster over
    15 00000A6D 00000000            <1> fatSize     dd 0        ;FAT size (number of sectors per FAT)
    16 00000A71 F0                  <1> media       db 0F0h     ;Media type (F0h or F8h)
    17 00000A72 0000000000000000    <1> bpbPointer  dq 0        ;Pointer to the buffer for the BPB
    18 00000A7A 00                  <1> bpbSize     db 0        ;Size of the BPB
    19 00000A7B 00000000            <1> hiddSector  dd 0        ;Only used for Fixed Disks, offset to add
    20                              <1> 
    21 00000A7F 0000000000000000    <1> loaderPtr   dq 0        ;Point to the bootloader to use
    22                              <1> 
    23 00000A87 00000000            <1> f32RootClus dd 0        ;Cluster addr of the root dir cluster if FAT32
    24                              <1> 
    25                              <1> ;Tracking vars, used only for updating the percentage message!
    26 00000A8B 0000000000000000    <1> secToWrite  dq 0        ;Number of sectors to write (neq numSectors if /Q set)
    27 00000A93 0000000000000000    <1> secWritten  dq 0        ;Number of sectors written so far
    28 00000A9B FF                  <1> secPercent  db -1       ;The previous percentage (-1 not initialised)
    29                              <1> 
    30                              <1> ;Tables
    31                              <1> ;Each row is 5 bytes, {DWORD, BYTE} with DWORD = diskSize, BYTE=secPerClusVal
    32                              <1> ;This table assumes a 512 byte sector (fair assumption) but we do a byte size
    33                              <1> ; comparison in format to eventually allow for other sized sectors
    34                              <1> fat16ClusterTable:
    35 00000A9C 00A04100            <1>     dd 8400*512 ;Disks up to 4.1MB, must use FAT12 with 0.5 K clusters
    36 00000AA0 01                  <1>     db 1    ;ALL FAT12 uses 1, unless it is a preexisting meddesc type medium
    37 00000AA1 0050FF00            <1>     dd 32680*512    ; Disk up to 16MB, 1K clusters
    38 00000AA5 02                  <1>     db 2
    39 00000AA6 00000008            <1>     dd 262144*512   ; Disk up to 128MB, 2K clusters
    40 00000AAA 04                  <1>     db 4
    41 00000AAB 00000010            <1>     dd 524288*512   ; Disk up to 256MB, 4K clusters
    42 00000AAF 08                  <1>     db 8
    43 00000AB0 00000020            <1>     dd 1048576*512  ; Disk up to 512Mb, 8K clusters
    44 00000AB4 10                  <1>     db 16
    45                              <1> 
    46                              <1> ;Here DWORD becomes QWORD
    47                              <1> fat32ClusterTable:
    48 00000AB5 0000000002000000    <1>     dq 16777216*512 ; Disk up to 8GB, 4K clusters
    49 00000ABD 08                  <1>     db 8        
    50 00000ABE 0000000004000000    <1>     dq 33554432*512 ; Disk up to 16GB, 8K clusters
    51 00000AC6 10                  <1>     db 16
    52 00000AC7 0000000008000000    <1>     dq 67108864*512 ; Disk up to 32Gb, 16K clusters
    53 00000ACF 20                  <1>     db 32
    54 00000AD0 FFFFFFFFFFFFFFFF    <1>     dq -1       ; Disk up to 2TB, 32K clusters
    55 00000AD8 40                  <1>     db 64
    56                              <1> 
    57                              <1> ;Static BPBs here, fields set to -1 must be edited.
    58                              <1> ;Fields with a preset value should NOT be touched.
    59                              <1> genericBPB12:
    60                              <1>     istruc bpb
    61 00000AD9 FFFF                <1>     at .bytsPerSec,  dw -1           ;512 bytes per sector, normally
    62 00000ADB FF                  <1>     at .secPerClus,  db -1           ;1 sector per cluster, normally
    63 00000ADC 0100                <1>     at .revdSecCnt,  dw 0001h        ;1 Reserved Sector
    64 00000ADE 02                  <1>     at .numFATs,     db 02h          ;2 FAT tables
    65 00000ADF E000                <1>     at .rootEntCnt,  dw 00E0h        ;224 root entries
    66 00000AE1 FFFF                <1>     at .totSec16,    dw -1           ;Total number of sectors on disk
    67 00000AE3 F0                  <1>     at .media,       db 0F0h         ;Media byte
    68 00000AE4 FFFF                <1>     at .FATsz16,     dw -1           ;9 FAT sectors, normally
    69 00000AE6 1200                <1>     at .secPerTrk,   dw 0012h        ;18 Sectors per track
    70 00000AE8 0200                <1>     at .numHeads,    dw 0002h        ;2 Heads
    71 00000AEA FFFFFFFF            <1>     at .hiddSec,     dd -1           ;No hidden sectors on removable
    72 00000AEE 00000000            <1>     at .totSec32,    dd 0            ;Not a FAT32 BPB
    73                              <1>     iend
    74                              <1>     istruc extBs 
    75 00000AF2 FF                  <1>     at .drvNum,         db -1   ;Set to 0 for Remdev, 80h for fixed disk
    76 00000AF3 00                  <1>     at .reserved1,      db 00h
    77 00000AF4 29                  <1>     at .bootSig,        db extBsSig ;Normal signature
    78 00000AF5 FFFFFFFF            <1>     at .volId,          dd -1       ;Set to date/time @ format
    79 00000AF9 4E4F204E414D452020- <1>     at .volLab,         db 'NO NAME    '    
    79 00000B02 2020                <1>
    80 00000B04 4641543132202020    <1>     at .filSysType,     db 'FAT12   '
    81                              <1>     iend
    82                              <1> 
    83                              <1> 
    84                              <1> genericBPB16:
    85                              <1>     istruc bpb
    86 00000B0C FFFF                <1>     at .bytsPerSec,  dw -1           ;512 bytes per sector, normally
    87 00000B0E FF                  <1>     at .secPerClus,  db -1           ;Sectors per cluster
    88 00000B0F 0100                <1>     at .revdSecCnt,  dw 0001h        ;1 Reserved Sector
    89 00000B11 02                  <1>     at .numFATs,     db 02h          ;2 FAT tables
    90 00000B12 0002                <1>     at .rootEntCnt,  dw 0200h        ;512 root entries
    91 00000B14 FFFF                <1>     at .totSec16,    dw -1           ;Total number of sectors on disk
    92 00000B16 F0                  <1>     at .media,       db 0F0h         ;Media byte
    93 00000B17 FFFF                <1>     at .FATsz16,     dw -1           ;Number of sectors per FAT
    94 00000B19 3F00                <1>     at .secPerTrk,   dw 003Fh        ;FAT16 and 32 have Hard disk geometry 
    95 00000B1B FF00                <1>     at .numHeads,    dw 00FFh        ;255 Heads
    96 00000B1D FFFFFFFF            <1>     at .hiddSec,     dd -1           ;No hidden sectors on removable
    97 00000B21 00000000            <1>     at .totSec32,    dd 0            ;Not a FAT32 BPB
    98                              <1>     iend
    99                              <1>     istruc extBs 
   100 00000B25 FF                  <1>     at .drvNum,         db -1   ;Set to 0 for Remdev, 80h for fixed disk
   101 00000B26 00                  <1>     at .reserved1,      db 00h
   102 00000B27 29                  <1>     at .bootSig,        db extBsSig ;Normal signature
   103 00000B28 FFFFFFFF            <1>     at .volId,          dd -1       ;Set to date/time @ format
   104 00000B2C 4E4F204E414D452020- <1>     at .volLab,         db 'NO NAME    '    
   104 00000B35 2020                <1>
   105 00000B37 4641543136202020    <1>     at .filSysType,     db 'FAT16   '
   106                              <1>     iend
   107                              <1> gbs_size equ ($ - genericBPB16) + 11
   108                              <1> 
   109                              <1> genericBPB32:
   110                              <1>     istruc bpb32
   111 00000B3F FFFF                <1>     at .bytsPerSec,  dw -1           ;512 bytes per sector, normally
   112 00000B41 FF                  <1>     at .secPerClus,  db -1           ;Sectors per cluster
   113 00000B42 1000                <1>     at .revdSecCnt,  dw 0010h        ;16 Reserved Sectors
   114 00000B44 02                  <1>     at .numFATs,     db 02h          ;2 FAT tables
   115 00000B45 0000                <1>     at .rootEntCnt,  dw 0000h        ;Invalid field for FAT32
   116 00000B47 0000                <1>     at .totSec16,    dw 0            ;Not a FAT 12/16 BPB
   117 00000B49 F0                  <1>     at .media,       db 0F0h         ;Media byte
   118 00000B4A 0000                <1>     at .FATsz16,     dw 0            ;Not a FAT 12/16 BPB
   119 00000B4C 3F00                <1>     at .secPerTrk,   dw 003Fh        ;FAT16 and 32 have Hard disk geometry 
   120 00000B4E FF00                <1>     at .numHeads,    dw 00FFh        ;255 Heads
   121 00000B50 FFFFFFFF            <1>     at .hiddSec,     dd -1           ;No hidden sectors on removable
   122 00000B54 FFFFFFFF            <1>     at .totSec32,    dd -1           ;Total number of sectors on disk
