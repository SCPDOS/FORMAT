    26 000007FB E8C7010000          <1>     call readChar   ;Get the non-delim char
    27 00000800 3A0583070000        <1>     cmp al, byte [bSwitch]  ;Is the char the switch char?
    28 00000806 7448                <1>     je .switchFnd
    29                              <1> ;This must be a drive letter and the next char must be a colon, else error.
    30 00000808 0FB6D0              <1>     movzx edx, al   ;Save the drive letter in dl
    31 0000080B 85C9                <1>     test ecx, ecx   ;A drive letter must be followed by a : 
    32 0000080D 0F8496060000        <1>     jz badParamExit
    33 00000813 E8AF010000          <1>     call readChar
