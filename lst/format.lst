   493                              <1> printDecimalValLB:
   494                              <1> ;Takes a value in rax and prints it's decimal representation with leading
   495                              <1> ; blanks and inserts commas where appropriate.
   496                              <1> ;Input: rax = Value to print
   497                              <1> ;       rcx = Buffer size to handle (usual values: 17 for max, 13 for dword)
   498 0000067B 4889E5              <1>     mov rbp, rsp
   499 0000067E 4829CC              <1>     sub rsp, rcx ;Allocate the buffer on the stack
   500 00000681 4889EF              <1>     mov rdi, rbp
   501 00000684 4829CF              <1>     sub rdi, rcx
   502 00000687 50                  <1>     push rax
   503 00000688 51                  <1>     push rcx
   504 00000689 57                  <1>     push rdi
   505 0000068A 31C0                <1>     xor eax, eax
   506 0000068C F3AA                <1>     rep stosb   ;Initialise the buffer with a null value
   507 0000068E 5F                  <1>     pop rdi     ;Now set the ptr to the head of the buffer
   508 0000068F 59                  <1>     pop rcx
   509 00000690 58                  <1>     pop rax
   510 00000691 51                  <1>     push rcx    ;Save this value to keep the buffer length
   511 00000692 E83E000000          <1>     call decimalise   ;If return with CF=CY, error!
   512 00000697 59                  <1>     pop rcx     ;Now print the buffer
   513 00000698 4889EF              <1>     mov rdi, rbp
   514 0000069B 48FFCF              <1>     dec rdi     ;Doesn't affect CF
   515 0000069E 722C                <1>     jc .errPrint    ;Print a mis-aligned ? to clearly mark an error!
   516                              <1> .skipLp:
   517 000006A0 8A1F                <1>     mov bl, byte [rdi]
   518 000006A2 84DB                <1>     test bl, bl ;Any leading null's get replaced with a space
   519 000006A4 7514                <1>     jne .printLp
   520 000006A6 B220                <1>     mov dl, " "
   521 000006A8 E8F5020000          <1>     call putch
   522 000006AD 48FFCF              <1>     dec rdi
   523 000006B0 FFC9                <1>     dec ecx
   524 000006B2 81F901000000        <1>     cmp ecx, 1
   525 000006B8 75E6                <1>     jne .skipLp   ;Always print 1 byte for size
   526                              <1> .printLp:
   527 000006BA 8A17                <1>     mov dl, byte [rdi]
   528 000006BC E8E1020000          <1>     call putch
   529 000006C1 48FFCF              <1>     dec rdi
   530 000006C4 FFC9                <1>     dec ecx
   531 000006C6 75F2                <1>     jnz .printLp
   532                              <1> .exit:
   533 000006C8 4889EC              <1>     mov rsp, rbp    ;Deallocate the buffer and exit!
   534                              <1>     return
