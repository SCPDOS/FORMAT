   241                              <1> ; command delimiters but a subset thereof. 
   242                              <1> ;These are the same across all codepages.
   243                              <1> ;Input: rsi must point to the start of the data string
   244                              <1> ;       ecx = Number of chars left to to process
   245                              <1> ;Output: rsi points to the first non-delimiter char
   246                              <1> ;       ecx = Chars left to process after skipping
   247                              <1> ;       ZF=ZE: No more chars left to process
   248                              <1> ;       ZF=NZ: Chars left to process
   249 000009D3 50                  <1>     push rax
   250                              <1> .l1:
   251 000009D4 E8DCFFFFFF          <1>     call readChar
   252 000009D9 740C                <1>     je .exit2
   253 000009DB E809000000          <1>     call isALdelimiter
