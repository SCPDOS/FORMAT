   471                              <1> ;Check if /F or {/N /T}
   472 00000E61 F6058D01000028      <1>     test byte [bFlag1], bitFloppy
   473 00000E68 7572                <1>     jnz .getFloppyTbl
   474                              <1> ;Here we have tracks and sectors per track. We take the number of heads 
   475                              <1> ; from the read BPB and find the appropriate BPB in the list of BPBs.
   476                              <1> ;Thus the values in /T and /N can ONLY be those whose BPBs we have 
   477                              <1> ; in the table. We get the number of heads from the reported media byte.
   478 00000E6A 0FB60DAE030000      <1>     movzx ecx, byte [ioParams + chsParamsBlock.deviceBPB + bpb.numHeads]
   479 00000E71 FFC9                <1>     dec ecx
   480 00000E73 81F901000000        <1>     cmp ecx, 1
   481 00000E79 0F8707010000        <1>     ja badIOCTLExit ;IOCTL messed up something here
   482 00000E7F 0FB61D89010000      <1>     movzx ebx, byte [bGivenSPT]
   483 00000E86 BF08000000          <1>     mov edi, 8  ;8 entries in the BPB table
   484 00000E8B 488D35F8010000      <1>     lea rsi, bpbTbl
   485                              <1> .ntLp:
   486 00000E92 66395E0D            <1>     cmp word [rsi + bpb.secPerTrk], bx
   487 00000E96 7534                <1>     jne .ntNextBpb
   488                              <1> ;Multiply number of tracks byte sector per track to see if the 
   489                              <1> ; sector count is good!
   490 00000E98 0FB7056E010000      <1>     movzx eax, word [wGivenTrks]    ;Tracks per side (numCylinders)
   491 00000E9F F7E3                <1>     mul ebx         ;Get number of sectors per side
   492 00000EA1 D3E0                <1>     shl eax, cl     ;Get the number of sectors across all sides. 
   493 00000EA3 66394608            <1>     cmp word [rsi + bpb.totSec16], ax
   494 00000EA7 7523                <1>     jne .ntNextBpb
   495                              <1> ;Set the new number of cylinders we will be working with.
   496 00000EA9 0FB7055D010000      <1>     movzx eax, word [wGivenTrks]
   497 00000EB0 66890556030000      <1>     mov word [ioParams + chsParamsBlock.wNumCyl], ax 
   498                              <1> ;Set the new number of sectors per track we will be working with.
   499 00000EB7 0FB60551010000      <1>     movzx eax, byte [bGivenSPT]
   500 00000EBE 66890580030000      <1>     mov word [ioParams + chsParamsBlock.TrackLayout + trackTable.wArraySz], ax
   501 00000EC5 B919000000          <1>     mov ecx, bpb_size
   502 00000ECA EB25                <1>     jmp short .writeNewBPB
   503                              <1> .ntNextBpb:
   504 00000ECC 4881C619000000      <1>     add rsi, bpb_size
   505 00000ED3 FFCF                <1>     dec edi
   506 00000ED5 75BB                <1>     jnz .ntLp
   507 00000ED7 E942000000          <1>     jmp badParamExit    ;If /N /T doesn't match any table, fail!
   508                              <1> .getFloppyTbl:
   509                              <1> ;Now we use the offset to copy the bpb to the right place
   510 00000EDC 0FB6052D010000      <1>     movzx eax, byte [bGivenSz]
   511 00000EE3 B919000000          <1>     mov ecx, bpb_size
   512 00000EE8 F7E1                <1>     mul ecx
   513 00000EEA 488DB0[8A100000]    <1>     lea rsi, qword [bpbTbl + rax]
   514                              <1> .writeNewBPB:
   515 00000EF1 488B3D2B010000      <1>     mov rdi, qword [bpbPtr] ;Overwrite the BPB stored here
   516 00000EF8 57                  <1>     push rdi
   517 00000EF9 F3A4                <1>     rep movsb
   518 00000EFB 5F                  <1>     pop rdi
   519                              <1>     return
